import {
  copyObj,
  hasKey,
  isArr,
  isNullish,
  isObj,
  isStr,
  isUndef,
  keysOf,
  objectAssign,
  toStr,
  undef
} from "./host.lil";

extern JsValue Object;
extern JsValue RegExp;
extern JsValue Math;
extern JsValue parseFloat;

export string SURVEY_LANGUAGE_PROPERTY = "$survey_language";

string[] appearanceFields = [
  "thankYouMessageHeader",
  "thankYouMessageDescription",
  "thankYouMessageCloseButtonText",
  "introScreenHeader",
  "introScreenDescription",
  "introScreenButtonText",
  "submitButtonText",
  "backButtonText"
];

JsValue? present(JsValue value) {
  return value;
}

export JsValue getValidationError(string value, JsValue rules, JsValue optional) {
  string trimmed = value.trim();
  if (!optional.truthy() && trimmed == "") {
    return "This field is required";
  }
  if (trimmed == "") {
    return false;
  }
  if (rules.truthy()) {
    JsValue[] list = JS.assume(rules);
    for (JsValue rule of list) {
      JsValue ruleValue = rule["value"];
      if (JS.strictEqual(rule["type"], "min_length")) {
        if (!isUndef(ruleValue) && trimmed.length < JS.number(ruleValue)) {
          return present(rule["errorMessage"]) ?? ("Please enter at least " + toStr(ruleValue) + " characters");
        }
      } else if (JS.strictEqual(rule["type"], "max_length")) {
        if (!isUndef(ruleValue) && trimmed.length > JS.number(ruleValue)) {
          return present(rule["errorMessage"]) ?? ("Please enter no more than " + toStr(ruleValue) + " characters");
        }
      }
    }
  }
  return false;
}

export JsValue getLengthFromRules(JsValue rules, JsValue type) {
  if (!rules.truthy()) {
    return undef();
  }
  JsValue rule = JS.invoke(rules, "find", (JsValue r) => JS.strictEqual(r["type"], type));
  if (isNullish(rule)) {
    return undef();
  }
  return rule["value"];
}

export JsValue getRequirementsHint(JsValue minLength, JsValue maxLength) {
  JsValue effectiveMin = if (JS.strictEqual(minLength, 1)) { undef() } else { minLength };
  if (effectiveMin.truthy() && maxLength.truthy()) {
    return "Enter " + toStr(effectiveMin) + "-" + toStr(maxLength) + " characters";
  }
  if (effectiveMin.truthy()) {
    return "Enter at least " + toStr(effectiveMin) + " " + (if (JS.strictEqual(effectiveMin, 1)) { "character" } else { "characters" });
  }
  if (maxLength.truthy()) {
    return "Maximum " + toStr(maxLength) + " " + (if (JS.strictEqual(maxLength, 1)) { "character" } else { "characters" });
  }
  return undef();
}

export string getSurveyResponseKey(JsValue questionId) {
  return "$survey_response_" + toStr(questionId);
}

export string getSurveyOldResponseKey(JsValue originalQuestionIndex) {
  if (JS.strictEqual(originalQuestionIndex, 0)) {
    return "$survey_response";
  }
  return "$survey_response_" + toStr(originalQuestionIndex);
}

export JsValue getSurveyResponseValue(JsValue responses, JsValue questionId = JS.undefined()) {
  if (!questionId.truthy()) {
    return null;
  }
  JsValue response = responses[getSurveyResponseKey(questionId)];
  if (isArr(response)) {
    JsValue[] items = JS.assume(response);
    return [...items];
  }
  return response;
}

JsValue snapshotQuestion(JsValue question, JsValue snapshots) {
  if (isNullish(snapshots)) return question["question"];
  JsValue id = question["id"];
  if (isNullish(id)) id = "";
  JsValue text = snapshots[id];
  if (isNullish(text)) return question["question"];
  return text;
}

export JsValue buildSurveyResponseProperties(JsValue responses = JS.undefined(), JsValue survey = JS.undefined(), JsValue questionSnapshots = JS.undefined()) {
  if (isUndef(responses)) {
    responses = JS.object();
  }
  JsValue oldFormatResponses = JS.object();
  JsValue[] questions = JS.assume(survey["questions"]);
  questions.forEach((JsValue question) => {
    JsValue originalQuestionIndex = question["originalQuestionIndex"];
    if (!isUndef(originalQuestionIndex)) {
      string oldResponseKey = getSurveyOldResponseKey(originalQuestionIndex);
      JsValue response = getSurveyResponseValue(responses, question["id"]);
      if (!isUndef(response)) {
        oldFormatResponses[oldResponseKey] = response;
      }
    }
  });
  JsValue out = JS.object();
  out["$survey_questions"] = questions.map((JsValue question) => object {
    id: question["id"],
    question: snapshotQuestion(question, questionSnapshots),
    response: getSurveyResponseValue(responses, question["id"])
  });
  objectAssign(out, responses);
  objectAssign(out, oldFormatResponses);
  return out;
}

export JsValue recordSurveyAnswer(JsValue state, string questionId, JsValue response, JsValue question = JS.undefined()) {
  JsValue snapshots = state["questionSnapshots"];
  if (isUndef(snapshots)) snapshots = JS.object();
  JsValue responses = copyObj(state["responses"]);
  responses[getSurveyResponseKey(questionId)] = response;
  if (!isNullish(question) && question["id"].truthy()) {
    snapshots = copyObj(snapshots);
    snapshots[question["id"]] = question["question"];
  }
  return object { responses: responses, questionSnapshots: snapshots };
}

export JsValue buildSurveyResponseEventProperties(JsValue options) {
  JsValue responses = options["responses"];
  if (isUndef(responses)) responses = JS.object();
  JsValue result = JS.object();
  if (!isUndef(options["submissionId"])) result["$survey_submission_id"] = options["submissionId"];
  if (JS.strictEqual(options["event"], "sent")) {
    if (!isUndef(options["completed"])) result["$survey_completed"] = options["completed"];
  } else {
    result["$survey_partially_completed"] = surveyHasResponses(responses);
  }
  if (options["surveyLanguage"].truthy()) result[SURVEY_LANGUAGE_PROPERTY] = options["surveyLanguage"];
  objectAssign(result, buildSurveyResponseProperties(responses, options["survey"], options["questionSnapshots"]));
  return result;
}

export func(JsValue)->bool isValidRegex = (JsValue pattern) => {
  try { JS.construct(RegExp, pattern); } catch { return false; }
  return true;
};

export func(JsValue, JsValue)->bool isMatchingRegex = (JsValue value, JsValue pattern) => {
  if (!isValidRegex(pattern)) return false;
  try { return JS.invoke(JS.construct(RegExp, pattern), "test", value).truthy(); } catch { return false; }
};

string lowerCase(string value) { return value.toLowerCase(); }

export JsValue propertyComparisons = object {
  exact: (string[] targets, string[] values) => values.some((string value) => targets.some((string target) => value === target)),
  is_not: (string[] targets, string[] values) => values.every((string value) => targets.every((string target) => value !== target)),
  regex: (string[] targets, string[] values) => values.some((string value) => targets.some((string target) => isMatchingRegex(value, target))),
  not_regex: (string[] targets, string[] values) => values.every((string value) => targets.every((string target) => !isMatchingRegex(value, target))),
  icontains: (string[] targets, string[] values) => values.map(lowerCase).some((string value) => targets.map(lowerCase).some((string target) => value.includes(target))),
  not_icontains: (string[] targets, string[] values) => values.map(lowerCase).every((string value) => targets.map(lowerCase).every((string target) => !value.includes(target))),
  gt: (string[] targets, string[] values) => values.some((string value) => {
    number parsed = JS.number(JS.call(parseFloat, undef(), value));
    return parsed == parsed && targets.some((string target) => parsed > JS.number(JS.call(parseFloat, undef(), target)));
  }),
  lt: (string[] targets, string[] values) => values.some((string value) => {
    number parsed = JS.number(JS.call(parseFloat, undef(), value));
    return parsed == parsed && targets.some((string target) => parsed < JS.number(JS.call(parseFloat, undef(), target)));
  })
};

export bool matchPropertyFilters(JsValue propertyFilters, JsValue eventProperties) {
  if (!propertyFilters.truthy()) return true;
  JsValue[] entries = JS.assume(JS.invoke(Object, "entries", propertyFilters));
  return entries.every((JsValue entry) => {
    JsValue value = if (isNullish(eventProperties)) { undef() } else { eventProperties[entry[0]] };
    if (isNullish(value)) return false;
    JsValue filter = entry[1];
    JsValue compare = propertyComparisons[filter["operator"]];
    if (!compare.truthy()) return false;
    JsValue[] targets = JS.assume(filter["values"]);
    return JS.call(compare, undef(), targets.map((JsValue item) => toStr(item)), [toStr(value)]).truthy();
  });
}

export func(JsValue[])->JsValue[] shuffle = (JsValue[] array) => {
  JsValue[] shuffled = [...array];
  for (int index = shuffled.length - 1; index > 0; index = index - 1) {
    int swapIndex = JS.number(JS.invoke(Math, "floor", JS.number(JS.invoke(Math, "random")) * (index + 1))).toInt();
    JsValue temporary = shuffled[index];
    shuffled[index] = shuffled[swapIndex];
    shuffled[swapIndex] = temporary;
  }
  return shuffled;
};

export func(JsValue)->JsValue getDisplayOrderChoices = (JsValue question) => {
  if (!question["shuffleOptions"].truthy()) return question["choices"];
  JsValue[] original = JS.assume(question["choices"]);
  JsValue[] choices = [...original];
  JsValue openChoice = null;
  if (question["hasOpenChoice"].truthy()) openChoice = present(JS.invoke(choices, "pop")) ?? null;
  JsValue[] shuffled = shuffle(choices);
  func(JsValue, int)->bool unchanged = (JsValue value, int index) => JS.strictEqual(value, shuffled[index]);
  if (shuffled.length > 1 && JS.invoke(choices, "every", unchanged).truthy()) {
    JS.invoke(shuffled, "reverse");
  }
  if (!JS.strictEqual(openChoice, null)) shuffled.push(openChoice);
  return shuffled;
};

export bool surveyHasResponses(JsValue responses = JS.undefined()) {
  if (isUndef(responses)) {
    responses = JS.object();
  }
  JsValue[] values = JS.assume(JS.invoke(Object, "values", responses));
  return values.some((JsValue response) => !isNullish(response));
}

export string getSurveyInteractionProperty(JsValue survey, string action) {
  string surveyProperty = "$survey_" + action + "/" + toStr(survey["id"]);
  JsValue iteration = survey["current_iteration"];
  if (iteration.truthy() && JS.number(iteration) > 0.0) {
    surveyProperty = surveyProperty + "/" + toStr(iteration);
  }
  return surveyProperty;
}

JsValue getTrimmedLanguage(JsValue value) {
  if (isStr(value)) {
    string trimmed = toStr(value).trim();
    if (trimmed != "") {
      return trimmed;
    }
  }
  return null;
}

export JsValue getLanguageFromStoredPersonProperties(JsValue storedPersonProperties) {
  if (!storedPersonProperties.truthy() || !isObj(storedPersonProperties) || !hasKey(storedPersonProperties, "language")) {
    return null;
  }
  return getTrimmedLanguage(storedPersonProperties["language"]);
}

void logMessage(JsValue logger, string level, string message) {
  if (!isNullish(logger)) {
    JS.invoke(logger, level, message);
  }
}

export JsValue detectSurveyLanguage(JsValue options, JsValue logger = JS.undefined()) {
  JsValue explicitLanguage = getTrimmedLanguage(options["overrideLanguage"]);
  if (explicitLanguage.truthy()) {
    logMessage(logger, "info", "Using override display language: " + toStr(explicitLanguage));
    return explicitLanguage;
  }
  JsValue personLanguage = getLanguageFromStoredPersonProperties(options["storedPersonProperties"]);
  if (personLanguage.truthy()) {
    logMessage(logger, "info", "Using person property language: " + toStr(personLanguage));
    return personLanguage;
  }
  JsValue detectedLocale = getTrimmedLanguage(options["locale"]);
  if (detectedLocale.truthy()) {
    logMessage(logger, "info", "Using detected locale: " + toStr(detectedLocale));
    return detectedLocale;
  }
  logMessage(logger, "info", "No user language detected");
  return null;
}

export string normalizeLanguageCode(string languageCode) {
  return languageCode.toLowerCase();
}

export string getBaseLanguage(string languageCode) {
  return languageCode.split("-")[0];
}

export JsValue findBestTranslationMatch(JsValue translations, string targetLanguage, JsValue logger = JS.undefined()) {
  if (!translations.truthy() || targetLanguage == "") {
    return null;
  }
  string normalizedTarget = normalizeLanguageCode(targetLanguage);
  string[] keys = keysOf(translations);
  for (string key of keys) {
    if (normalizeLanguageCode(key) == normalizedTarget) {
      logMessage(logger, "debug", "Found exact translation match: " + key);
      return key;
    }
  }
  if (normalizedTarget.includes("-")) {
    string baseLanguage = getBaseLanguage(normalizedTarget);
    for (string key of keys) {
      if (normalizeLanguageCode(key) == baseLanguage) {
        logMessage(logger, "debug", "Found base language translation match: " + key + " (from " + targetLanguage + ")");
        return key;
      }
    }
  }
  return null;
}

JsValue mergeQuestionTranslation(JsValue question, string targetLanguage, JsValue logger) {
  JsValue translationKey = findBestTranslationMatch(question["translations"], targetLanguage, logger);
  JsValue questionTranslation = if (translationKey.truthy()) { question["translations"][translationKey] } else { undef() };
  if (!questionTranslation.truthy()) {
    return object { question: question, matchedKey: null, hasChanges: false };
  }
  JsValue translated = copyObj(question);
  bool hasChanges = false;
  if (!isUndef(questionTranslation["question"])) {
    translated["question"] = questionTranslation["question"];
    hasChanges = true;
  }
  if (!isUndef(questionTranslation["description"])) {
    translated["description"] = questionTranslation["description"];
    hasChanges = true;
  }
  if (!isUndef(questionTranslation["buttonText"])) {
    translated["buttonText"] = questionTranslation["buttonText"];
    hasChanges = true;
  }
  if (hasKey(translated, "link") && !isUndef(questionTranslation["link"])) {
    translated["link"] = questionTranslation["link"];
    hasChanges = true;
  }
  if (hasKey(translated, "lowerBoundLabel") && !isUndef(questionTranslation["lowerBoundLabel"])) {
    translated["lowerBoundLabel"] = questionTranslation["lowerBoundLabel"];
    hasChanges = true;
  }
  if (hasKey(translated, "upperBoundLabel") && !isUndef(questionTranslation["upperBoundLabel"])) {
    translated["upperBoundLabel"] = questionTranslation["upperBoundLabel"];
    hasChanges = true;
  }
  if (hasKey(translated, "choices") && isArr(questionTranslation["choices"])) {
    translated["choices"] = questionTranslation["choices"];
    hasChanges = true;
  }
  return object {
    question: if (hasChanges) { translated } else { question },
    matchedKey: if (hasChanges) { translationKey } else { null },
    hasChanges: hasChanges
  };
}

export JsValue applySurveyTranslation(JsValue survey, string targetLanguage, JsValue logger = JS.undefined()) {
  JsValue translationKey = findBestTranslationMatch(survey["translations"], targetLanguage, logger);
  JsValue translated = copyObj(survey);
  bool hasTranslation = false;

  if (translationKey.truthy()) {
    JsValue translation = survey["translations"][translationKey];
    if (translation.truthy()) {
      logMessage(logger, "info", "Applying survey-level translation for language: " + toStr(translationKey));
      if (!isUndef(translation["name"])) {
        translated["name"] = translation["name"];
        hasTranslation = true;
      }
      if (translated["appearance"].truthy()) {
        JsValue appearance = copyObj(translated["appearance"]);
        appearanceFields.forEach((string field) => {
          if (!isUndef(translation[field])) {
            appearance[field] = translation[field];
            hasTranslation = true;
          }
        });
        translated["appearance"] = appearance;
      } else if (appearanceFields.some((string field) => !isUndef(translation[field]))) {
        hasTranslation = true;
      }
    }
  }

  JsValue[] questions = JS.assume(survey["questions"]);
  JsValue[] results = questions.map((JsValue question) => mergeQuestionTranslation(question, targetLanguage, logger));
  JsValue questionMatchedKey = null;
  if (!translationKey.truthy()) {
    for (JsValue result of results) {
      if (result["matchedKey"].truthy()) {
        questionMatchedKey = result["matchedKey"];
        break;
      }
    }
  }
  if (results.some((JsValue result) => result["hasChanges"].truthy())) {
    translated["questions"] = results.map((JsValue result) => result["question"]);
    hasTranslation = true;
    logMessage(logger, "info", "Applied question-level translations for language: " + targetLanguage);
  }
  return object {
    survey: translated,
    matchedKey: if (!hasTranslation) { null } else { if (translationKey.truthy()) { translationKey } else { questionMatchedKey } }
  };
}

export bool doesSurveyActivateByEvent(JsValue survey) {
  JsValue conditions = survey["conditions"];
  if (isNullish(conditions)) {
    return false;
  }
  JsValue events = conditions["events"];
  if (isNullish(events)) {
    return false;
  }
  JsValue values = events["values"];
  return !isNullish(values) && values["length"].truthy();
}

export bool canSurveyActivateRepeatedly(JsValue survey) {
  JsValue conditions = survey["conditions"];
  bool repeatEvent = false;
  if (!isNullish(conditions)) {
    JsValue events = conditions["events"];
    if (!isNullish(events)) {
      repeatEvent = doesSurveyActivateByEvent(survey) && events["repeatedActivation"].truthy();
    }
  }
  return repeatEvent || JS.strictEqual(survey["schedule"], "always");
}

export bool isSurveyIterationBased(JsValue survey) {
  if (JS.strictEqual(survey["schedule"], "recurring")) {
    return true;
  }
  JsValue iteration = survey["current_iteration"];
  if (isNullish(iteration)) {
    iteration = 0;
  }
  return JS.number(iteration) > 0.0;
}

export bool isSurveyKeyForSurvey(string key, string surveyId) {
  return key == surveyId || key.startsWith(surveyId + "_");
}

export string getSurveyIterationKey(JsValue survey) {
  JsValue iteration = survey["current_iteration"];
  if (iteration.truthy() && JS.number(iteration) > 0.0) {
    return toStr(survey["id"]) + "_" + toStr(iteration);
  }
  return toStr(survey["id"]);
}
