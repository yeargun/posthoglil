import { isStr, isUndef, toStr } from "./host.lil";

Regex usHost = new Regex("https://(app|us|us-assets)(\\.i)?\\.posthog\\.com", "i");
Regex euHost = new Regex("https://(eu|eu-assets)(\\.i)?\\.posthog\\.com", "i");
Regex ingestionHost = new Regex("\\.i\\.posthog\\.com", "");
string ingestion = "i.posthog.com";

string trimSlash(string host) {
  string trimmed = host.trim();
  return if (trimmed.endsWith("/")) { trimmed.slice(0, trimmed.length - 1) } else { trimmed };
}

export string apiHostFromConfig(string apiHost) {
  string host = trimSlash(apiHost);
  if (host == "https://app.posthog.com") {
    return "https://us." + ingestion;
  }
  return host;
}

export string flagsApiHostFromConfig(JsValue config) {
  JsValue custom = config["flags_api_host"];
  if (custom.truthy() && custom is string) {
    return trimSlash(custom);
  }
  return apiHostFromConfig(JS.assume(config["api_host"]));
}

export string uiHostFromConfig(JsValue config) {
  JsValue custom = config["ui_host"];
  string host = if (custom.truthy() && custom is string) {
    trimSlash(custom)
  } else {
    apiHostFromConfig(JS.assume(config["api_host"])).replace(ingestionHost, ".posthog.com")
  };
  if (host == "https://app.posthog.com") {
    return "https://us.posthog.com";
  }
  return host;
}

export string regionForHost(string apiHost) {
  string host = apiHostFromConfig(apiHost);
  if (usHost.test(host)) {
    return "us";
  }
  if (euHost.test(host)) {
    return "eu";
  }
  return "custom";
}

export string endpointFor(JsValue config, string target, string path = "") {
  if (path != "" && !path.startsWith("/")) {
    path = "/" + path;
  }
  if (target == "ui") {
    return uiHostFromConfig(config) + path;
  }
  if (target == "flags") {
    return flagsApiHostFromConfig(config) + path;
  }
  if (target == "assets" && path.startsWith("/static/")) {
    JsValue override = config["asset_host"];
    if (override is string) {
      string host = trimSlash(override);
      if (host != "") {
        return host + path;
      }
    }
  }
  string region = regionForHost(JS.assume(config["api_host"]));
  if (region == "custom") {
    return apiHostFromConfig(JS.assume(config["api_host"])) + path;
  }
  string suffix = ingestion + path;
  if (target == "assets") {
    return "https://" + region + "-assets." + suffix;
  }
  return "https://" + region + "." + suffix;
}
