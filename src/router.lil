import { isStr, isUndef, toStr } from "./host.lil";

Regex usHost = new Regex("https://(app|us|us-assets)(\\.i)?\\.posthog\\.com", "i");
Regex euHost = new Regex("https://(eu|eu-assets)(\\.i)?\\.posthog\\.com", "i");
string ingestion = "i.posthog.com";

string trimSlash(string host) {
  string trimmed = host.trim();
  if (trimmed.endsWith("/")) {
    return trimmed.slice(0, trimmed.length - 1);
  }
  return trimmed;
}

string replaceIngestion(string host) {
  string suffix = "." + ingestion;
  int idx = host.indexOf(suffix);
  if (idx < 0) {
    return host;
  }
  return host.slice(0, idx) + ".posthog.com" + host.slice(idx + suffix.length);
}

export string apiHostFromConfig(string apiHost) {
  string host = trimSlash(apiHost);
  if (host == "https://app.posthog.com") {
    return "https://us." + ingestion;
  }
  return host;
}

export string flagsApiHostFromConfig(JsValue config) {
  JsValue custom = config["flags_api_host"];
  if (isStr(custom) && custom.truthy()) {
    return trimSlash(toStr(custom));
  }
  return apiHostFromConfig(toStr(config["api_host"]));
}

export string uiHostFromConfig(JsValue config) {
  JsValue custom = config["ui_host"];
  string host = "";
  if (isStr(custom) && custom.truthy()) {
    host = trimSlash(toStr(custom));
  } else {
    host = replaceIngestion(apiHostFromConfig(toStr(config["api_host"])));
  }
  if (host == "https://app.posthog.com") {
    return "https://us.posthog.com";
  }
  return host;
}

export string regionForHost(string apiHost) {
  string host = apiHostFromConfig(apiHost);
  if (usHost.test(host)) {
    return "us";
  }
  if (euHost.test(host)) {
    return "eu";
  }
  return "custom";
}

string withSlash(string path) {
  if (path == "") {
    return "";
  }
  if (path.charAt(0) == "/") {
    return path;
  }
  return "/" + path;
}

export string endpointFor(JsValue config, string target, string path) {
  string resolved = withSlash(path);
  if (target == "ui") {
    return uiHostFromConfig(config) + resolved;
  }
  if (target == "flags") {
    return flagsApiHostFromConfig(config) + resolved;
  }
  if (target == "assets" && resolved.startsWith("/static/")) {
    JsValue override = config["asset_host"];
    if (isStr(override) && override.truthy()) {
      string host = trimSlash(toStr(override));
      if (host != "") {
        return host + resolved;
      }
    }
  }
  string region = regionForHost(toStr(config["api_host"]));
  if (region == "custom") {
    return apiHostFromConfig(toStr(config["api_host"])) + resolved;
  }
  string suffix = ingestion + resolved;
  if (target == "assets") {
    return "https://" + region + "-assets." + suffix;
  }
  return "https://" + region + "." + suffix;
}
