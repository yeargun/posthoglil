import {
  copyObj,
  hasKey,
  isNullish,
  isStr,
  isUndef,
  len,
  toStr,
  typeError,
  undef
} from "./host.lil";
import {
  explicitString,
  getPrototypeOf,
  isBuiltinValue,
  isEmptyStringValue,
  isErrorEventValue,
  isErrorValue,
  isEventValue,
  isPrimitiveValue,
  isStringValue,
  owns
} from "./error-host.lil";
import { extractExceptionKeysForMessage } from "./error-coercers.lil";

Regex errorTypesPatternApi = new Regex("^(?:[Uu]ncaught (?:exception: )?)?(?:((?:Eval|Internal|Range|Reference|Syntax|Type|URI|)Error): )?(.*)$", "i");
string[] coercerSeverityLevels = ["fatal", "error", "warning", "log", "info", "debug"];

JsValue emptyConstructor(JsValue self, JsValue args) {
  return undef();
}

void requireConstructorReceiver(JsValue self, JsValue constructorValue, string name) {
  if (
    isNullish(self) ||
    !JS.invoke(constructorValue["prototype"], "isPrototypeOf", self).truthy()
  ) {
    throw typeError("Class constructor " + name + " cannot be invoked without 'new'");
  }
}

void setFunctionName(JsValue functionValue, string name) {
  JsValue descriptor = JS.object();
  descriptor["value"] = name;
  descriptor["configurable"] = true;
  JS.invoke(Object, "defineProperty", functionValue, "name", descriptor);
}

void defineMethod(JsValue constructorValue, string name, JsValue method) {
  setFunctionName(method, name);
  JsValue descriptor = JS.object();
  descriptor["value"] = method;
  descriptor["writable"] = true;
  descriptor["configurable"] = true;
  JS.invoke(Object, "defineProperty", constructorValue["prototype"], name, descriptor);
}

JsValue makeConstructor(string name) {
  JsValue constructorValue = undef();
  func(JsValue, JsValue)->JsValue constructorCallback = (JsValue self, JsValue args) => {
    requireConstructorReceiver(self, constructorValue, name);
    return emptyConstructor(self, args);
  };
  constructorValue = JS.methodRest(constructorCallback);
  setFunctionName(constructorValue, name);
  JsValue prototypeDescriptor = JS.object();
  prototypeDescriptor["writable"] = false;
  JS.invoke(Object, "defineProperty", constructorValue, "prototype", prototypeDescriptor);
  return constructorValue;
}

JsValue finishConstructor(JsValue constructorValue, string name) {
  setFunctionName(constructorValue, name);
  JsValue prototypeDescriptor = JS.object();
  prototypeDescriptor["writable"] = false;
  JS.invoke(Object, "defineProperty", constructorValue, "prototype", prototypeDescriptor);
  return constructorValue;
}

JsValue optionalSyntheticStack(JsValue context) {
  JsValue syntheticException = context["syntheticException"];
  if (!isNullish(syntheticException)) {
    return syntheticException["stack"];
  }
  return undef();
}

JsValue domIsException(JsValue self, JsValue error) {
  return isBuiltinValue(error, "DOMException");
}

JsValue domIsError(JsValue self, JsValue error) {
  return isBuiltinValue(error, "DOMError");
}

JsValue domMatch(JsValue self, JsValue error) {
  return JS.invoke(self, "isDOMException", error).truthy() || JS.invoke(self, "isDOMError", error).truthy();
}

JsValue domGetType(JsValue self, JsValue error) {
  if (JS.invoke(self, "isDOMError", error).truthy()) {
    return "DOMError";
  }
  return "DOMException";
}

JsValue domGetValue(JsValue self, JsValue error) {
  JsValue name = error["name"];
  if (name.truthy()) {
    if (error["message"].truthy()) {
      return toStr(name) + ": " + toStr(error["message"]);
    }
    return name;
  }
  JsValue fallbackName = "DOMException";
  if (JS.invoke(self, "isDOMError", error).truthy()) {
    fallbackName = "DOMError";
  }
  if (error["message"].truthy()) {
    return toStr(fallbackName) + ": " + toStr(error["message"]);
  }
  return fallbackName;
}

JsValue domCoerce(JsValue self, JsValue error, JsValue context) {
  JsValue out = JS.object();
  out["type"] = JS.invoke(self, "getType", error);
  out["value"] = JS.invoke(self, "getValue", error);
  if (isStringValue(error["stack"])) {
    out["stack"] = error["stack"];
  } else {
    out["stack"] = undef();
  }
  if (error["cause"].truthy()) {
    out["cause"] = JS.invoke(context, "next", error["cause"]);
  } else {
    out["cause"] = undef();
  }
  out["synthetic"] = false;
  return out;
}

JsValue createDOMExceptionCoercer() {
  JsValue constructorValue = undef();
  constructorValue = JS.methodRest((JsValue self, JsValue args) => {
    requireConstructorReceiver(self, constructorValue, "DOMExceptionCoercer");
    return self;
  });
  constructorValue["prototype"]["match"] = JS.method1(domMatch);
  constructorValue["prototype"]["coerce"] = JS.method2(domCoerce);
  constructorValue["prototype"]["getType"] = JS.method1(domGetType);
  constructorValue["prototype"]["getValue"] = JS.method1(domGetValue);
  constructorValue["prototype"]["isDOMException"] = JS.method1(domIsException);
  constructorValue["prototype"]["isDOMError"] = JS.method1(domIsError);
  return finishConstructor(constructorValue, "DOMExceptionCoercer");
}

export JsValue DOMExceptionCoercer = createDOMExceptionCoercer();

JsValue errorMatch(JsValue self, JsValue error) {
  return isErrorValue(error);
}

JsValue errorGetType(JsValue self, JsValue error) {
  if (error["name"].truthy()) {
    return error["name"];
  }
  return error["constructor"]["name"];
}

JsValue errorGetMessage(JsValue self, JsValue error, JsValue context) {
  JsValue message = error["message"];
  if (message["error"].truthy() && JS.typeOf(message["error"]["message"]) == "string") {
    return explicitString(message["error"]["message"]);
  }
  return explicitString(message);
}

JsValue errorGetStack(JsValue self, JsValue error) {
  if (error["stacktrace"].truthy()) {
    return error["stacktrace"];
  }
  if (error["stack"].truthy()) {
    return error["stack"];
  }
  return undef();
}

JsValue errorCoerce(JsValue self, JsValue error, JsValue context) {
  JsValue stack = JS.invoke(self, "getStack", error);
  bool synthetic = isUndef(stack);
  JsValue out = JS.object();
  out["type"] = JS.invoke(self, "getType", error);
  out["value"] = JS.invoke(self, "getMessage", error, context);
  if (isUndef(stack)) {
    out["stack"] = optionalSyntheticStack(context);
  } else {
    out["stack"] = stack;
  }
  if (error["cause"].truthy()) {
    out["cause"] = JS.invoke(context, "next", error["cause"]);
  } else {
    out["cause"] = undef();
  }
  out["synthetic"] = synthetic;
  return out;
}

JsValue createErrorCoercer() {
  JsValue constructorValue = undef();
  constructorValue = JS.methodRest((JsValue self, JsValue args) => {
    requireConstructorReceiver(self, constructorValue, "ErrorCoercer");
    return self;
  });
  constructorValue["prototype"]["match"] = JS.method1(errorMatch);
  constructorValue["prototype"]["coerce"] = JS.method2(errorCoerce);
  constructorValue["prototype"]["getType"] = JS.method1(errorGetType);
  constructorValue["prototype"]["getMessage"] = JS.method2(errorGetMessage);
  constructorValue["prototype"]["getStack"] = JS.method1(errorGetStack);
  return finishConstructor(constructorValue, "ErrorCoercer");
}

export JsValue ErrorCoercer = createErrorCoercer();

JsValue errorEventHasUsableMessage(JsValue self, JsValue error) {
  return isStringValue(error["message"]) && len(error["message"]) > 0;
}

JsValue errorEventMatch(JsValue self, JsValue error) {
  if (!isErrorEventValue(error)) {
    return false;
  }
  return !isNullish(error["error"]) || JS.invoke(self, "_hasUsableMessage", error).truthy();
}

JsValue errorEventBuildLocationStack(JsValue self, JsValue error) {
  JsValue lineNumber = error["lineno"];
  JsValue columnNumber = error["colno"];
  if (isNullish(lineNumber)) {
    lineNumber = 0;
  }
  if (isNullish(columnNumber)) {
    columnNumber = 0;
  }
  if (!isStringValue(error["filename"]) || len(error["filename"]) == 0 || JS.strictEqual(lineNumber, 0)) {
    return undef();
  }
  return "Error\n    at " + toStr(error["filename"]) + ":" + toStr(lineNumber) + ":" + toStr(columnNumber);
}

JsValue errorEventCoerce(JsValue self, JsValue error, JsValue context) {
  if (!isNullish(error["error"])) {
    return JS.invoke(context, "apply", error["error"]);
  }
  JsValue exceptionLike = JS.invoke(context, "apply", error["message"]);
  JsValue out = copyObj(exceptionLike);
  JsValue locationStack = JS.invoke(self, "_buildLocationStack", error);
  if (isNullish(locationStack)) {
    out["stack"] = exceptionLike["stack"];
  } else {
    out["stack"] = locationStack;
  }
  out["synthetic"] = true;
  return out;
}

JsValue createErrorEventCoercer() {
  JsValue constructorValue = undef();
  constructorValue = JS.methodRest((JsValue self, JsValue args) => {
    requireConstructorReceiver(self, constructorValue, "ErrorEventCoercer");
    return self;
  });
  constructorValue["prototype"]["match"] = JS.method1(errorEventMatch);
  constructorValue["prototype"]["coerce"] = JS.method2(errorEventCoerce);
  constructorValue["prototype"]["_hasUsableMessage"] = JS.method1(errorEventHasUsableMessage);
  constructorValue["prototype"]["_buildLocationStack"] = JS.method1(errorEventBuildLocationStack);
  return finishConstructor(constructorValue, "ErrorEventCoercer");
}

export JsValue ErrorEventCoercer = createErrorEventCoercer();

JsValue eventMatch(JsValue self, JsValue error) {
  return isEventValue(error);
}

JsValue eventCoerce(JsValue self, JsValue event, JsValue context) {
  JsValue constructorName = event["constructor"]["name"];
  JsValue out = JS.object();
  out["type"] = constructorName;
  out["value"] = toStr(constructorName) + " captured as exception with keys: " + extractExceptionKeysForMessage(event);
  out["stack"] = optionalSyntheticStack(context);
  out["synthetic"] = true;
  return out;
}

JsValue createEventCoercer() {
  JsValue constructorValue = undef();
  constructorValue = JS.methodRest((JsValue self, JsValue args) => {
    requireConstructorReceiver(self, constructorValue, "EventCoercer");
    return self;
  });
  constructorValue["prototype"]["match"] = JS.method1(eventMatch);
  constructorValue["prototype"]["coerce"] = JS.method2(eventCoerce);
  return finishConstructor(constructorValue, "EventCoercer");
}

export JsValue EventCoercer = createEventCoercer();

JsValue objectMatch(JsValue self, JsValue candidate) {
  return JS.typeOf(candidate) == "object" && !JS.strictEqual(candidate, null);
}

JsValue objectIsSeverityLevel(JsValue self, JsValue value) {
  if (!isStringValue(value) || isEmptyStringValue(value)) {
    return false;
  }
  return JS.number(JS.invoke(coercerSeverityLevels, "indexOf", value)) >= 0.0;
}

JsValue objectGetStack(JsValue self, JsValue candidate) {
  try {
    if (isStringValue(candidate["stacktrace"]) && len(candidate["stacktrace"]) > 0) {
      return candidate["stacktrace"];
    }
    if (isStringValue(candidate["stack"]) && len(candidate["stack"]) > 0) {
      return candidate["stack"];
    }
  } catch {
  }
  return undef();
}

JsValue objectGetErrorProperty(JsValue self, JsValue object) {
  for (string property in object) {
    if (owns(object, property)) {
      JsValue value = object[property];
      if (isErrorValue(value)) {
        return value;
      }
    }
  }
  return undef();
}

JsValue objectGetClassName(JsValue self, JsValue object) {
  try {
    JsValue prototype = getPrototypeOf(object);
    if (prototype.truthy()) {
      return prototype["constructor"]["name"];
    }
  } catch {
  }
  return undef();
}

JsValue objectGetType(JsValue self, JsValue error) {
  if (isEventValue(error)) {
    return error["constructor"]["name"];
  }
  JsValue name = undef();
  if (hasKey(error, "name")) {
    name = error["name"];
  }
  if (isStringValue(name) && !isEmptyStringValue(name)) {
    return name;
  }
  return "Error";
}

JsValue objectGetValue(JsValue self, JsValue error) {
  if (hasKey(error, "name") && JS.typeOf(error["name"]) == "string") {
    string message = "'" + toStr(error["name"]) + "' captured as exception";
    if (hasKey(error, "message") && JS.typeOf(error["message"]) == "string") {
      message = message + " with message: '" + toStr(error["message"]) + "'";
    }
    return message;
  }
  if (hasKey(error, "message") && JS.typeOf(error["message"]) == "string") {
    return error["message"];
  }
  JsValue className = JS.invoke(self, "getObjectClassName", error);
  string kind = "Object";
  if (className.truthy() && !JS.strictEqual(className, "Object")) {
    kind = "'" + toStr(className) + "'";
  }
  return kind + " captured as exception with keys: " + extractExceptionKeysForMessage(error);
}

JsValue objectCoerce(JsValue self, JsValue candidate, JsValue context) {
  JsValue errorProperty = JS.invoke(self, "getErrorPropertyFromObject", candidate);
  if (errorProperty.truthy()) {
    return JS.invoke(context, "apply", errorProperty);
  }
  JsValue out = JS.object();
  out["type"] = JS.invoke(self, "getType", candidate);
  out["value"] = JS.invoke(self, "getValue", candidate);
  JsValue stack = JS.invoke(self, "getStack", candidate);
  if (isNullish(stack)) {
    stack = optionalSyntheticStack(context);
  }
  out["stack"] = stack;
  if (JS.invoke(self, "isSeverityLevel", candidate["level"]).truthy()) {
    out["level"] = candidate["level"];
  } else {
    out["level"] = "error";
  }
  out["synthetic"] = true;
  return out;
}

JsValue createObjectCoercer() {
  JsValue constructorValue = undef();
  constructorValue = JS.methodRest((JsValue self, JsValue args) => {
    requireConstructorReceiver(self, constructorValue, "ObjectCoercer");
    return self;
  });
  constructorValue["prototype"]["match"] = JS.method1(objectMatch);
  constructorValue["prototype"]["coerce"] = JS.method2(objectCoerce);
  constructorValue["prototype"]["getType"] = JS.method1(objectGetType);
  constructorValue["prototype"]["getValue"] = JS.method1(objectGetValue);
  constructorValue["prototype"]["isSeverityLevel"] = JS.method1(objectIsSeverityLevel);
  constructorValue["prototype"]["getStack"] = JS.method1(objectGetStack);
  constructorValue["prototype"]["getErrorPropertyFromObject"] = JS.method1(objectGetErrorProperty);
  constructorValue["prototype"]["getObjectClassName"] = JS.method1(objectGetClassName);
  return finishConstructor(constructorValue, "ObjectCoercer");
}

export JsValue ObjectCoercer = createObjectCoercer();

JsValue primitiveMatch(JsValue self, JsValue value) {
  return isPrimitiveValue(value);
}

JsValue primitiveCoerce(JsValue self, JsValue value, JsValue context) {
  JsValue out = JS.object();
  out["type"] = "Error";
  out["value"] = "Primitive value captured as exception: " + explicitString(value);
  out["stack"] = optionalSyntheticStack(context);
  out["synthetic"] = true;
  return out;
}

JsValue createPrimitiveCoercer() {
  JsValue constructorValue = undef();
  constructorValue = JS.methodRest((JsValue self, JsValue args) => {
    requireConstructorReceiver(self, constructorValue, "PrimitiveCoercer");
    return self;
  });
  constructorValue["prototype"]["match"] = JS.method1(primitiveMatch);
  constructorValue["prototype"]["coerce"] = JS.method2(primitiveCoerce);
  return finishConstructor(constructorValue, "PrimitiveCoercer");
}

export JsValue PrimitiveCoercer = createPrimitiveCoercer();

JsValue promiseIsCustomEvent(JsValue self, JsValue error) {
  if (!isEventValue(error)) {
    return false;
  }
  try {
    JsValue detail = error["detail"];
    return !isNullish(detail) && JS.typeOf(detail) == "object" && hasKey(detail, "reason");
  } catch {
    return false;
  }
}

JsValue promiseMatch(JsValue self, JsValue error) {
  return isBuiltinValue(error, "PromiseRejectionEvent") || JS.invoke(self, "isCustomEventWrappingRejection", error).truthy();
}

JsValue promiseGetReason(JsValue self, JsValue error) {
  try {
    if (hasKey(error, "reason")) {
      return error["reason"];
    }
    if (
      hasKey(error, "detail") &&
      !isNullish(error["detail"]) &&
      JS.typeOf(error["detail"]) == "object" &&
      hasKey(error["detail"], "reason")
    ) {
      return error["detail"]["reason"];
    }
  } catch {
  }
  return error;
}

JsValue promiseCoerce(JsValue self, JsValue error, JsValue context) {
  JsValue reason = JS.invoke(self, "getUnhandledRejectionReason", error);
  if (isPrimitiveValue(reason)) {
    JsValue out = JS.object();
    out["type"] = "UnhandledRejection";
    out["value"] = "Non-Error promise rejection captured with value: " + explicitString(reason);
    out["stack"] = optionalSyntheticStack(context);
    out["synthetic"] = true;
    return out;
  }
  return JS.invoke(context, "apply", reason);
}

JsValue createPromiseRejectionEventCoercer() {
  JsValue constructorValue = undef();
  constructorValue = JS.methodRest((JsValue self, JsValue args) => {
    requireConstructorReceiver(self, constructorValue, "PromiseRejectionEventCoercer");
    return self;
  });
  constructorValue["prototype"]["match"] = JS.method1(promiseMatch);
  constructorValue["prototype"]["isCustomEventWrappingRejection"] = JS.method1(promiseIsCustomEvent);
  constructorValue["prototype"]["coerce"] = JS.method2(promiseCoerce);
  constructorValue["prototype"]["getUnhandledRejectionReason"] = JS.method1(promiseGetReason);
  return finishConstructor(constructorValue, "PromiseRejectionEventCoercer");
}

export JsValue PromiseRejectionEventCoercer = createPromiseRejectionEventCoercer();

JsValue stringMatch(JsValue self, JsValue input) {
  return JS.typeOf(input) == "string";
}

JsValue stringGetInfos(JsValue self, JsValue candidate) {
  JsValue type = "Error";
  JsValue value = candidate;
  JsValue groups = JS.invoke(candidate, "match", errorTypesPatternApi);
  if (groups.truthy()) {
    type = groups[1];
    value = groups[2];
  }
  JsValue out = JS.array();
  JS.invoke(out, "push", type);
  JS.invoke(out, "push", value);
  return out;
}

JsValue stringCoerce(JsValue self, JsValue input, JsValue context) {
  JsValue infos = JS.invoke(self, "getInfos", input);
  JsValue out = JS.object();
  if (isNullish(infos[0])) {
    out["type"] = "Error";
  } else {
    out["type"] = infos[0];
  }
  if (isNullish(infos[1])) {
    out["value"] = input;
  } else {
    out["value"] = infos[1];
  }
  out["stack"] = optionalSyntheticStack(context);
  out["synthetic"] = true;
  return out;
}

JsValue createStringCoercer() {
  JsValue constructorValue = undef();
  constructorValue = JS.methodRest((JsValue self, JsValue args) => {
    requireConstructorReceiver(self, constructorValue, "StringCoercer");
    return self;
  });
  constructorValue["prototype"]["match"] = JS.method1(stringMatch);
  constructorValue["prototype"]["coerce"] = JS.method2(stringCoerce);
  constructorValue["prototype"]["getInfos"] = JS.method1(stringGetInfos);
  return finishConstructor(constructorValue, "StringCoercer");
}

export JsValue StringCoercer = createStringCoercer();
