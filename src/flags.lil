extern JsValue Object;
import {
  copyObj,
  hasKey,
  isStr,
  isUndef,
  jsonParse,
  jsonStringify,
  keysOf,
  undef
} from "./host.lil";

export string[] MINIMAL_FLAG_CALLED_EVENT_CAMPAIGN_PROPERTIES = [
  "utm_source",
  "utm_medium",
  "utm_campaign",
  "utm_content",
  "utm_term",
  "gad_source",
  "mc_cid",
  "gclid",
  "gclsrc",
  "dclid",
  "gbraid",
  "wbraid",
  "fbclid",
  "msclkid",
  "twclid",
  "li_fat_id",
  "igshid",
  "ttclid",
  "rdt_cid",
  "epik",
  "qclid",
  "sccid",
  "irclid",
  "_kx"
];

export string[] MINIMAL_FLAG_CALLED_EVENT_PROPERTIES = [
  "$feature_flag",
  "$feature_flag_response",
  "$feature_flag_has_experiment",
  "$feature_flag_id",
  "$feature_flag_version",
  "$feature_flag_reason",
  "$feature_flag_request_id",
  "$feature_flag_evaluated_at",
  "$feature_flag_error",
  "locally_evaluated",
  "$groups",
  "$process_person_profile",
  "$geoip_disable",
  "$current_url",
  "$pathname",
  "$referring_domain",
  ...MINIMAL_FLAG_CALLED_EVENT_CAMPAIGN_PROPERTIES,
  "$session_id",
  "$window_id",
  "$lib",
  "$lib_version",
  "$device_id",
  "$is_server"
];


JsValue empty() {
  return JS.object();
}

JsValue orEmpty(JsValue value) {
  if (isUndef(value) || JS.isNullish(value)) {
    return empty();
  }
  return value;
}

bool enabledFromValue(JsValue value) {
  if (isStr(value)) {
    return true;
  }
  return value.truthy();
}

JsValue variantFromValue(JsValue value) {
  if (isStr(value)) {
    return value;
  }
  return undef();
}

export func(JsValue)->JsValue parsePayload = (JsValue response) => {
  if (!isStr(response)) {
    return response;
  }
  try {
    return jsonParse(response);
  } catch {
    return response;
  }
};

export func(JsValue)->JsValue getFeatureFlagValue = (JsValue detail) => {
  if (isUndef(detail)) {
    return undef();
  }
  JsValue variant = detail["variant"];
  if (!isUndef(variant) && !JS.isNullish(variant)) {
    return variant;
  }
  return detail["enabled"];
};

export func(JsValue)->JsValue getFlagValuesFromFlags = (JsValue flags) => {
  JsValue source = orEmpty(flags);
  JsValue out = empty();
  for (string key of keysOf(source)) {
    JsValue value = getFeatureFlagValue(source[key]);
    if (!isUndef(value)) {
      out[key] = value;
    }
  }
  return out;
};

export func(JsValue)->JsValue getPayloadsFromFlags = (JsValue flags) => {
  JsValue source = orEmpty(flags);
  JsValue out = empty();
  for (string key of keysOf(source)) {
    JsValue details = source[key];
    if (!JS.isNullish(details) && details["enabled"].truthy()) {
      JsValue metadata = details["metadata"];
      if (!JS.isNullish(metadata) && !isUndef(metadata["payload"])) {
        JsValue payload = metadata["payload"];
        out[key] = if (payload.truthy()) { parsePayload(payload) } else { undef() };
      }
    }
  }
  return out;
};

export func(JsValue)->JsValue normalizeFlagsResponse = (JsValue flagsResponse) => {
  JsValue out = copyObj(flagsResponse);
  if (hasKey(flagsResponse, "flags")) {
    out["featureFlags"] = getFlagValuesFromFlags(flagsResponse["flags"]);
    out["featureFlagPayloads"] = getPayloadsFromFlags(flagsResponse["flags"]);
    return out;
  }
  JsValue featureFlags = orEmpty(flagsResponse["featureFlags"]);
  JsValue rawPayloads = orEmpty(flagsResponse["featureFlagPayloads"]);
  JsValue featureFlagPayloads = empty();
  for (string key of keysOf(rawPayloads)) {
    featureFlagPayloads[key] = parsePayload(rawPayloads[key]);
  }
  JsValue details = empty();
  for (string key of keysOf(featureFlags)) {
    JsValue value = featureFlags[key];
    JsValue payload = featureFlagPayloads[key];
    details[key] = object {
      key: key,
      enabled: enabledFromValue(value),
      variant: variantFromValue(value),
      reason: undef(),
      metadata: object {
        id: undef(),
        version: undef(),
        payload: if (payload.truthy()) { jsonStringify(payload) } else { undef() },
        description: undef()
      }
    };
  }
  out["featureFlags"] = featureFlags;
  out["featureFlagPayloads"] = featureFlagPayloads;
  out["flags"] = details;
  return out;
};

export func(JsValue, JsValue)->JsValue createFlagsResponseFromFlagsAndPayloads = (JsValue featureFlags, JsValue featureFlagPayloads) => {
  JsValue flags = orEmpty(featureFlags);
  JsValue payloads = orEmpty(featureFlagPayloads);
  JsValue enabled = empty();
  for (string key of keysOf(flags).concat(keysOf(payloads))) {
    if (flags[key].truthy() || payloads[key].truthy()) {
      JsValue value = flags[key];
      enabled[key] = if (JS.isNullish(value)) { true } else { value };
    }
  }
  return normalizeFlagsResponse(object { featureFlags: enabled, featureFlagPayloads: payloads });
};

export func(JsValue, JsValue)->JsValue updateFlagValue = (JsValue flag, JsValue value) => {
  JsValue next = copyObj(flag);
  next["enabled"] = enabledFromValue(value);
  next["variant"] = variantFromValue(value);
  return next;
};

export func(JsValue)->JsValue flagDetailsToResults = (JsValue flagDetails) => {
  JsValue[] details = JS.assume(JS.invoke(Object, "values", orEmpty(flagDetails)));
  return details.map((JsValue detail) => {
    JsValue value = getFeatureFlagValue(detail);
    JsValue metadata = detail["metadata"];
    JsValue rawPayload = if (JS.isNullish(metadata)) { undef() } else { metadata["payload"] };
    return object {
      key: detail["key"],
      enabled: enabledFromValue(value),
      variant: variantFromValue(value),
      payload: if (isUndef(rawPayload)) { null } else { parsePayload(rawPayload) }
    };
  });
};

export func(JsValue, JsValue)->JsValue minimizeFlagCalledEventProperties = (JsValue properties, JsValue transportKeys) => {
  JsValue out = empty();
  func(string)->void copyKey = (string key) => {
    JsValue value = properties[key];
    if (!isUndef(value)) {
      out[key] = value;
    }
  };
  MINIMAL_FLAG_CALLED_EVENT_PROPERTIES.forEach(copyKey);
  if (!JS.isNullish(transportKeys)) {
    string[] extra = JS.assume(transportKeys);
    extra.forEach(copyKey);
  }
  return out;
};
