    if (browserWindow.truthy() && (Config.DEBUG.truthy() || browserWindow.POSTHOG_DEBUG.truthy() || debugEnabled.truthy()) && !JS.isUndefined(browserWindow.console) && browserWindow.console.truthy()) {
      JsValue log = if (JS.in("__rrweb_original__", browserWindow.console[level])) {
        browserWindow.console[level]["__rrweb_original__"]
