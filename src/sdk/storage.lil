  number secondNumber = second;
  number unsignedFirst = if (first < 0) { firstNumber + 4294967296.0 } else { firstNumber };
  number unsignedSecond = if (second < 0) { secondNumber + 4294967296.0 } else { secondNumber };
  JsValue length = value.length;
  JsValue one = unsignedFirst;
  JsValue two = unsignedSecond;
  return JS.assume(length.toString(36.0) + "." + one.toString(36.0) + "." + two.toString(36.0));
}

