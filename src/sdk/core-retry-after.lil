// packages/core/src/utils/retry-after.ts, PostHog 1.435.8.
extern JsValue Date;
extern JsValue Math;
extern JsValue Number;
extern JsValue RegExp;
export number MAX_RETRY_AFTER_MS = 300000.0;
number CLOCK_STEP_TOLERANCE_MS = 5000.0;

export JsValue parseRetryAfterMs(JsValue value, JsValue now = Date["now"]()) {
    if (!(value is string) || !value.truthy()) return JS.undefined();
    // The guard establishes a primitive string, unlike PostHog's boxed-string
    // predicate. Keep the original regular expressions and parsing order.
    string raw = (JS.assume(value) as string).trim();
    string trimmed = if (JS.construct(RegExp, "^\\d+\\s*,", "").test(raw).truthy()) {
        raw.slice(0, raw.indexOf(",")).trim()
    } else { raw };
    if (JS.construct(RegExp, "^\\d+$", "").test(trimmed).truthy()) {
        JsValue ms = Math["min"](Number(trimmed), MAX_RETRY_AFTER_MS / 1000.0) * 1000.0;
        return if (ms > 0.0) { ms } else { JS.undefined() };
    }
    if (!JS.construct(RegExp, "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)[a-z]*[ ,]", "").test(trimmed).truthy()) return JS.undefined();
    string date = if (JS.construct(RegExp, "^\\w{3} \\w{3} ", "").test(trimmed).truthy()) { trimmed + " GMT" } else { trimmed };
    JsValue ms = Date["parse"](date) - now;
    if (!Number["isFinite"](ms).truthy() || ms <= 0.0) return JS.undefined();
    return Math["min"](ms, MAX_RETRY_AFTER_MS);
}

export class RetryAfterWindow {
    number _until;
    number _installedAt;
    init() {
        this._until = 0.0;
        this._installedAt = 0.0;
    }
    void record(JsValue outcome) {
        if (outcome.kind === "too-large") return;
        if (outcome.kind !== "retry-later") { this.reset(); return; }
        if (!outcome.retryAfterMs.truthy()) return;
        bool open = this.isOpen();
        number now = JS.assume(Date["now"]());
        number asked = JS.assume(Math["min"](outcome.retryAfterMs, MAX_RETRY_AFTER_MS));
        if (!open) {
            this._installedAt = now;
            this._until = now + asked;
            return;
        }
        this._until = JS.assume(Math["max"](this._until, Math["min"](now + asked, this._installedAt + MAX_RETRY_AFTER_MS)));
    }
    number remainingMs() {
        number now = JS.assume(Date["now"]());
        if (now < this._installedAt - CLOCK_STEP_TOLERANCE_MS) { this.reset(); return 0.0; }
        number remaining = JS.assume(Math["min"](MAX_RETRY_AFTER_MS, Math["max"](0.0, this._until - now)));
        if (remaining == 0.0) this.reset();
        return remaining;
    }
    bool isOpen() { return this.remainingMs() > 0.0; }
    void reset() { this._until = 0.0; this._installedAt = 0.0; }
}
export constructor RetryAfterWindow;
