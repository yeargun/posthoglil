JsValue logger = createLogger("[SessionId]");
export number DEFAULT_SESSION_IDLE_TIMEOUT_SECONDS = 1800.0;
export number MAX_SESSION_IDLE_TIMEOUT_SECONDS = 36000.0;
export number MIN_SESSION_IDLE_TIMEOUT_SECONDS = 60.0;
export number ACTIVITY_TIMESTAMP_PERSIST_GRANULARITY_MS = 5000.0;
export number SESSION_COOKIE_SYNC_INTERVAL_MS = 1000.0;

JsValue parseBootstrapSessionId(JsValue sessionId, JsValue timestamp = JS.construct(Date).getTime()) {
  try {
    JsValue start = uuid7ToTimestampMs(sessionId);
    if (start > timestamp + 60000.0) { logger.error("Bootstrap sessionID cannot be in the future"); return JS.undefined(); }
    return start;
  } catch (JsValue error) {
    logger.error("Invalid sessionID in bootstrap", error);
    return JS.undefined();
  }
}

export class SessionIdManager {
