import { isArr, jsonStringify, objectKeys, undef } from "./host.lil";

export bool includes(JsValue haystack, JsValue needle) {
  return !JS.strictEqual(JS.invoke(haystack, "indexOf", needle), -1);
}

export string trim(string str) {
  return str.trim();
}

Regex leadingDollar = new Regex("^\\$", "");

export string stripLeadingDollar(string s) {
  return s.replace(leadingDollar, "");
}

export bool isDistinctIdStringLike(string value) {
  string lower = value.toLowerCase();
  return lower == "distinct_id" || lower == "distinctid";
}

JsValue deepSortKeys(JsValue value) {
  if (JS.isNullish(value) || JS.typeOf(value) != "object") {
    return value;
  }
  if (isArr(value)) {
    JsValue[] items = JS.assume(value);
    return items.map(deepSortKeys);
  }
  JsValue acc = JS.object();
  string[] keys = JS.assume(JS.invoke(objectKeys(value), "sort"));
  keys.forEach((string key) => {
    acc[key] = deepSortKeys(value[key]);
  });
  return acc;
}

export string getPersonPropertiesHash(
  string distinct_id,
  JsValue userPropertiesToSet = JS.undefined(),
  JsValue userPropertiesToSetOnce = JS.undefined()
) {
  return JS.assume(jsonStringify(object {
    distinct_id: distinct_id,
    userPropertiesToSet: if (userPropertiesToSet.truthy()) { deepSortKeys(userPropertiesToSet) } else { undef() },
    userPropertiesToSetOnce: if (userPropertiesToSetOnce.truthy()) { deepSortKeys(userPropertiesToSetOnce) } else { undef() }
  }));
}
