// packages/core/src/utils/number-utils.ts
import { isNumber } from "./type-utils.lil";
extern JsValue Number;

export float clampToRange(JsValue value, float min, float max, JsValue logger, JsValue fallbackValue = undefined) {
  if (min > max) {
    logger.warn("min cannot be greater than max.");
    min = max;
  }
  if (!isNumber(value)) {
    logger.warn(" must be a number. using max or fallback. max: " + max + ", fallback: " + fallbackValue);
    return clampToRange(fallbackValue ?? max, min, max, logger);
  }
  float n = value as float;
  if (n > max) {
    logger.warn(" cannot be  greater than max: " + max + ". Using max value instead.");
    return max;
  } else if (n < min) {
    logger.warn(" cannot be less than min: " + min + ". Using min value instead.");
    return min;
  }
  return n;
}

export bool getRemoteConfigBool(JsValue field, string key, bool defaultValue = true) {
  if (field == null) {
    return defaultValue;
  }
  if (field is bool) {
    return field;
  }
  if (JS.typeOf(field) == "object") {
    JsValue value = field[key];
    return if (value is bool) { value } else { defaultValue };
  }
  return defaultValue;
}

export float | undefined getRemoteConfigNumber(JsValue field, string key) {
  if (field == null || JS.typeOf(field) != "object") {
    return undefined;
  }
  JsValue value = field[key];
  if (value is float) {
    if (Number.isFinite(value).truthy()) {
      return value;
    }
    return undefined;
  }
  if (value is string) {
    string trimmed = value.trim();
    if (trimmed == "") {
      return undefined;
    }
    float parsed = Number(trimmed) as float;
    return if (Number.isFinite(parsed).truthy()) { parsed } else { undefined };
  }
  return undefined;
}

export bool isValidSampleRate(JsValue value) {
  return value is float && Number.isFinite(value).truthy() && value >= 0.0 && value <= 1.0;
}
