// packages/core/src/utils/flush-timer.ts — the pending flush timer of an export queue, and when it
// is due. Its own calls to `arm`/`clear`/`_onFire` go through the instance, as upstream's `this.x()` do.
import { safeSetTimeout } from "../../lil/core-utils.lil";
extern JsValue Date;
extern JsValue Object;
extern JsValue clearTimeout;

export class FlushTimer {
  JsValue _onFire = undefined;
  float _firesAt = 0.0;
  JsValue _timer = undefined;

  // `onFire` runs when the timer elapses, after the handle is released.
  init(JsValue onFire) {
    this._onFire = onFire;
  }

  // Schedules a flush in `delayMs`, replacing any timer already pending.
  void arm(float delayMs) {
    (this as JsValue).clear();
    this._firesAt = (Date.now() as float) + delayMs;
    FlushTimer self = this;
    this._timer = safeSetTimeout(() => {
      self._timer = undefined;
      (self as JsValue)._onFire();
    }, delayMs);
  }

  // Arms only if it moves the flush later.
  void armNoEarlierThan(float delayMs) {
    if (this._timer.truthy() && (Date.now() as float) + delayMs <= this._firesAt) {
      return;
    }
    (this as JsValue).arm(delayMs);
  }

  void clear() {
    if (this._timer.truthy()) {
      clearTimeout(this._timer);
      this._timer = undefined;
    }
  }
}
export constructor FlushTimer;

// Whether a flush is already scheduled (a prototype getter, as upstream's class declares it).
Object.defineProperty((FlushTimer as JsValue).prototype, "pending", object {
  get: (this JsValue receiver) => (receiver as FlushTimer)._timer.truthy(),
  configurable: true
});
