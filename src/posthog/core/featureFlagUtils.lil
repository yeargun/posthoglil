// packages/core/src/featureFlagUtils.ts — flag responses are server JSON, so they stay JsValue.
// Object spread (`{...a, k: v}`) is `Object.assign({}, a, {k: v})`: same keys, order and values.
extern JsValue Object;
extern JsValue JSON;

export JsValue normalizeFlagsResponse(JsValue flagsResponse) {
  if (JS.in("flags", flagsResponse)) {
    // Convert v2 format to v1 format
    JsValue featureFlags = getFlagValuesFromFlags(flagsResponse.flags);
    JsValue featureFlagPayloads = getPayloadsFromFlags(flagsResponse.flags);
    return Object.assign(object {}, flagsResponse, object { featureFlags: featureFlags, featureFlagPayloads: featureFlagPayloads });
  }
  // Convert v1 format to v2 format
  JsValue featureFlags = flagsResponse.featureFlags ?? object {};
  JsValue featureFlagPayloads = Object.fromEntries(
    Object.entries(flagsResponse.featureFlagPayloads || object {}).map((JsValue entry) => [entry[0], parsePayload(entry[1])])
  );
  JsValue flags = Object.fromEntries(
    Object.entries(featureFlags).map((JsValue entry) => [
      entry[0],
      getFlagDetailFromFlagAndPayload(entry[0], entry[1], featureFlagPayloads[entry[0]])
    ])
  );
  return Object.assign(object {}, flagsResponse, object { featureFlags: featureFlags, featureFlagPayloads: featureFlagPayloads, flags: flags });
}

JsValue getFlagDetailFromFlagAndPayload(JsValue key, JsValue value, JsValue payload) {
  return object {
    key: key,
    enabled: if (value is string) { true } else { value },
    variant: if (value is string) { value } else { undefined },
    reason: undefined,
    metadata: object {
      id: undefined,
      version: undefined,
      payload: if (payload.truthy()) { JSON.stringify(payload) } else { undefined },
      description: undefined
    }
  };
}

export JsValue getFlagValuesFromFlags(JsValue flags) {
  return Object.fromEntries(
    Object.entries(flags ?? object {})
      .map((JsValue entry) => [entry[0], getFeatureFlagValue(entry[1])])
      .filter((JsValue entry) => entry[1] !== undefined)
  );
}

export JsValue getPayloadsFromFlags(JsValue flags) {
  JsValue safeFlags = flags ?? object {};
  return Object.fromEntries(
    Object.keys(safeFlags)
      .filter((JsValue flag) => {
        JsValue details = safeFlags[flag];
        return details.enabled && details.metadata && details.metadata.payload !== undefined;
      })
      .map((JsValue flag) => {
        JsValue metadata = safeFlags[flag].metadata;
        JsValue payload = if (metadata == null) { undefined } else { metadata.payload };
        return [flag, if (payload.truthy()) { parsePayload(payload) } else { undefined }];
      })
  );
}

export JsValue getFeatureFlagValue(JsValue detail) {
  return if (detail === undefined) { undefined } else { detail.variant ?? detail.enabled };
}

export JsValue parsePayload(JsValue response) {
  if (!(response is string)) {
    return response;
  }
  try {
    return JSON.parse(response);
  } catch (JsValue error) {
    return response;
  }
}

export JsValue createFlagsResponseFromFlagsAndPayloads(JsValue featureFlags, JsValue featureFlagPayloads) {
  // If a feature flag payload key is not in the feature flags, we treat it as true feature flag.
  // `[...new Set([...a, ...b])]`: the keys in first-seen order.
  JsValue allKeys = [];
  Set<string> seen = new Set<string>();
  JsValue lists = [Object.keys(featureFlags ?? object {}), Object.keys(featureFlagPayloads ?? object {})];
  for (int l = 0; l < 2; l += 1) {
    JsValue keys = lists[l];
    for (int i = 0; i < keys.length; i += 1) {
      string key = keys[i] as string;
      if (!seen.has(key)) {
        seen.add(key);
        allKeys.push(key);
      }
    }
  }
  JsValue flagValues = allKeys
    .filter((JsValue flag) => {
      JsValue value = if (featureFlags == null) { undefined } else { featureFlags[flag] };
      JsValue payload = if (featureFlagPayloads == null) { undefined } else { featureFlagPayloads[flag] };
      return value !== undefined || payload.truthy();
    })
    .reduce((JsValue res, JsValue key) => {
      JsValue value = if (featureFlags == null) { undefined } else { featureFlags[key] };
      res[key] = value ?? true;
      return res;
    }, object {});
  JsValue flagDetails = object {
    featureFlags: flagValues,
    featureFlagPayloads: featureFlagPayloads ?? object {}
  };
  return normalizeFlagsResponse(flagDetails);
}

export JsValue updateFlagValue(JsValue flag, JsValue value) {
  return Object.assign(object {}, flag, object { enabled: getEnabledFromValue(value), variant: getVariantFromValue(value) });
}

export JsValue getEnabledFromValue(JsValue value) {
  return if (value is string) { true } else { value };
}

export JsValue getVariantFromValue(JsValue value) {
  return if (value is string) { value } else { undefined };
}

export JsValue flagDetailsToResults(JsValue flagDetails) {
  return Object.values(flagDetails).map((JsValue detail) => {
    JsValue value = detail.variant ?? detail.enabled;
    JsValue metadata = detail.metadata;
    JsValue rawPayload = if (metadata == null) { undefined } else { metadata.payload };
    return object {
      key: detail.key,
      enabled: getEnabledFromValue(value),
      variant: getVariantFromValue(value),
      payload: if (rawPayload !== undefined) { parsePayload(rawPayload) } else { null }
    };
  });
}

export string[] MINIMAL_FLAG_CALLED_EVENT_CAMPAIGN_PROPERTIES = [
  "utm_source",
  "utm_medium",
  "utm_campaign",
  "utm_content",
  "utm_term",
  "gad_source",
  "mc_cid",
  "gclid",
  "gclsrc",
  "dclid",
  "gbraid",
  "wbraid",
  "fbclid",
  "msclkid",
  "twclid",
  "li_fat_id",
  "igshid",
  "ttclid",
  "rdt_cid",
  "epik",
  "qclid",
  "sccid",
  "oppref",
  "irclid",
  "_kx"
];

export string[] MINIMAL_FLAG_CALLED_EVENT_PROPERTIES = [
  "$feature_flag",
  "$feature_flag_response",
  "$feature_flag_has_experiment",
  "$feature_flag_id",
  "$feature_flag_version",
  "$feature_flag_reason",
  "$feature_flag_request_id",
  "$feature_flag_evaluated_at",
  "$feature_flag_error",
  "locally_evaluated",
  "$groups",
  "$process_person_profile",
  "$geoip_disable",
  "$current_url",
  "$pathname",
  "$referring_domain",
  ...MINIMAL_FLAG_CALLED_EVENT_CAMPAIGN_PROPERTIES,
  "$session_id",
  "$window_id",
  "$lib",
  "$lib_version",
  "$device_id",
  "$is_server"
];

export JsValue minimizeFlagCalledEventProperties(JsValue properties, JsValue transportKeys = []) {
  JsValue minimal = object {};
  func(JsValue)->void copyKey = (JsValue key) => {
    if (properties[key] !== undefined) {
      minimal[key] = properties[key];
    }
  };
  for (string key of MINIMAL_FLAG_CALLED_EVENT_PROPERTIES) {
    copyKey(key);
  }
  transportKeys.forEach(copyKey);
  return minimal;
}
