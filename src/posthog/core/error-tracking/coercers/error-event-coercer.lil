// packages/core/src/error-tracking/coercers/error-event-coercer.ts — the `_`-private helpers are
// module functions; `{...exceptionLike, …}` is a copy of the SDK's own exception record.
import { isErrorEvent, isString } from "../../utils/type-utils.lil";
extern JsValue Object;

export class ErrorEventCoercer {
  bool match(JsValue err) {
    if (!isErrorEvent(err)) {
      return false;
    }
    return err.error != undefined || hasUsableMessage(err);
  }

  JsValue coerce(JsValue err, JsValue ctx) {
    if (err.error != undefined) {
      return ctx.apply(err.error);
    }
    JsValue exceptionLike = ctx.apply(err["message"]);
    JsValue result = Object.assign(object {}, exceptionLike);
    result.stack = buildLocationStack(err) ?? exceptionLike.stack;
    result.synthetic = true;
    return result;
  }
}
export constructor ErrorEventCoercer;

bool hasUsableMessage(JsValue err) {
  return isString(err["message"]) && err["message"]["length"] > 0;
}

JsValue buildLocationStack(JsValue location) {
  JsValue lineno = location.lineno ?? 0;
  JsValue colno = location.colno ?? 0;
  if (!isString(location.filename) || location.filename["length"] === 0) {
    return undefined;
  }
  // A zero line means the report carries no code position (the filename is then the document URL).
  if (lineno === 0) {
    return undefined;
  }
  // The message stays in `value`, which prevents multiline messages from being parsed as frames.
  return `Error\n    at ${location.filename}:${lineno}:${colno}`;
}
