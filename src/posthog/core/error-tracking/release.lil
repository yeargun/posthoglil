// packages/core/src/error-tracking/release.ts
extern JsValue globalThis;

// The release id posthog-cli injects as `globalThis._posthogReleaseId`; `undefined` when nothing
// was injected or the value is malformed.
export string | undefined getInjectedReleaseId() {
  JsValue injected = globalThis._posthogReleaseId;
  if (injected is string && injected.length > 0) {
    return injected;
  }
  return undefined;
}
