  TopCenter: "top_center",
  MiddleLeft: "middle_left",
  MiddleRight: "middle_right",
  MiddleCenter: "middle_center",
  Left: "left",
  Center: "center",
  Right: "right",
  NextToTrigger: "next_to_trigger"
};

export JsValue SurveyTabPosition = object { Top: "top", Left: "left", Right: "right", Bottom: "bottom" };

export JsValue SurveyType = object { Popover: "popover", API: "api", Widget: "widget", ExternalSurvey: "external_survey" };

export JsValue SurveyQuestionType = object {
  Open: "open",
  MultipleChoice: "multiple_choice",
  SingleChoice: "single_choice",
  Rating: "rating",
  Link: "link"
};

