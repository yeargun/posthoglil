// packages/browser-common/src/utils/autocapture-utils.ts — DOM elements, events and autocapture configs
// come from the page, so they stay dynamic. Element lists the module builds are typed arrays, the
// private records (element texts, extracted chain elements) are shapes, and strings it produces are
// typed. Private helpers are module functions.
import { each, entries } from "./general-utils.lil";
import { isArray, isBoolean, isNullish, isString, isUndefined } from "../../core/utils/type-utils.lil";
import { trim } from "../../core/utils/string-utils.lil";
import { logger } from "./logger.lil";
import { window } from "./globals.lil";
extern JsValue Object;
import { getTargetingUrl } from "./url-targeting-utils.lil";
import { isElementNode, isShadowRoot, isTag, isTextNode } from "./element-utils.lil";

// Real DOM trees are at most a few hundred nodes deep; a patched parentNode
// chain could otherwise trap ancestor walks in an unbounded loop.
export int MAX_DOM_ANCESTOR_DEPTH = 1000;

export string[] splitClassString(JsValue s) {
  if (!s.truthy()) {
    return [];
  }
  JsValue trimmed = trim(s as string);
  return trimmed.split(new Regex("\\s+")) as string[];
}

bool checkForURLMatches(JsValue urlsList, JsValue instance) {
  JsValue url = getTargetingUrl(instance);
  return url.truthy() && urlsList.truthy() && urlsList.some((JsValue regex) => url.match(regex)).truthy();
}

/*
 * Get the className of an element, accounting for edge cases where element.className is an object
 *
 * Because this is a string it can contain unexpected characters
 * So, this method safely splits the className and returns that array.
 */
export string[] getClassNames(JsValue el) {
  JsValue className = "";
  string kind = JS.typeOf(el.className);
  if (kind == "string") {
    className = el.className;
  } else if (kind == "object") {
    // handle cases where className might be SVGAnimatedString or some other type
    className = (if (el.className.truthy() && "baseVal" in el.className) { el.className.baseVal } else { null }) || el.getAttribute("class") || "";
  }
  return splitClassString(className);
}

export JsValue makeSafeText(JsValue s) {
  if (isNullish(s)) {
    return null;
  }
  JsValue trimmed = trim(s as string);
  string[] words = trimmed.split(new Regex("(\\s+)")) as string[];
  return words
    // scrub potentially sensitive values
    .filter((string word) => shouldCaptureValue(word, true))
    .join("")
    // normalize whitespace
    .replace(new Regex("[\\r\\n]", "g"), " ")
    .replace(new Regex("[ ]+", "g"), " ")
    // truncate
    .slice(0, 255);
}

/*
 * Get the direct text content of an element, protecting against sensitive data collection.
 * Concats textContent of each of the element's text node children; this avoids potential
 * collection of sensitive data that could happen if we used element.textContent and the
 * element had sensitive child elements, since element.textContent includes child content.
 * Scrubs values that look like they could be sensitive (i.e. cc or ssn number).
 */
export string getSafeText(JsValue el) {
  string elText = "";
  if (shouldCaptureElement(el) && !isSensitiveElement(el) && el.childNodes.truthy() && el.childNodes["length"].truthy()) {
    each(el.childNodes, (JsValue child) => {
      if (isTextNode(child) && child.textContent.truthy()) {
        JsValue safe = makeSafeText(child.textContent);
        elText += if (safe == null) { "" } else { safe as string };
      }
    });
  }
  return trim(elText);
}

export JsValue getEventTarget(JsValue e) {
  // https://developer.mozilla.org/en-US/docs/Web/API/Event/target#Compatibility_notes
  if (isUndefined(e.target)) {
    return e.srcElement || null;
  }
  JsValue target = e.target;
  if (target != null && target.shadowRoot.truthy()) {
    return e.composedPath()[0] || null;
  }
  return e.target || null;
}

export string[] autocaptureCompatibleElements = ["a", "button", "form", "input", "select", "textarea", "label"];

/*
 if there is no config, then all elements are allowed
 if there is a config, and there is an allow list, then only elements in the allow list are allowed
 assumes that some other code is checking this element's parents
 */
bool checkIfElementTreePassesElementAllowList(JsValue[] elements, JsValue autocaptureConfig) {
  JsValue allowlist = if (autocaptureConfig == null) { undefined } else { autocaptureConfig.element_allowlist };
  if (isUndefined(allowlist)) {
    // everything is allowed, when there is no allow list
    return true;
  }
  // check each element in the tree
  // if any of the elements are in the allow list, then the tree is allowed
  for (JsValue el of elements) {
    if (allowlist.some((JsValue elementType) => el.tagName.toLowerCase() === elementType).truthy()) {
      return true;
    }
  }
  // otherwise there is an allow list and this element tree didn't match it
  return false;
}

export JsValue elementMatchesCSSSelector(JsValue el, JsValue selector) {
  JsValue matches = el.matches || el.matchesSelector || el.msMatchesSelector || el.mozMatchesSelector || el.webkitMatchesSelector || el.oMatchesSelector;
  try {
    return if (matches.truthy()) { matches.call(el, selector) } else { false };
  } catch {
    return false;
  }
}

/*
 if there is no selector list (i.e. it is undefined), then any elements matches
 if there is an empty list, then no elements match
 if there is a selector list, then check it against each element provided
 */
bool checkIfElementsMatchCSSSelector(JsValue[] elements, JsValue selectorList) {
  if (isUndefined(selectorList)) {
    // everything is allowed, when there is no selector list
    return true;
  }
  for (JsValue el of elements) {
    if (selectorList.some((JsValue selector) => elementMatchesCSSSelector(el, selector)).truthy()) {
      return true;
    }
  }
  return false;
}

export JsValue getParentElement(JsValue curEl) {
  JsValue parentNode = curEl.parentNode;
  if (!parentNode.truthy() || !isElementNode(parentNode)) {
    return false;
  }
  return parentNode;
}

export string[] DEFAULT_AUTOCAPTURE_IGNORE_LIST = [".ph-no-autocapture", "[data-ph-no-autocapture]"];
string[] DEFAULT_CONTENT_IGNORELIST = ["next", "previous", "prev", ">", "<"];
// +/- steppers are built to be clicked repeatedly; enabled from the 2026-05-30 config defaults
export string[] DEFAULT_CONTENT_IGNORELIST_WITH_STEPPERS = [...DEFAULT_CONTENT_IGNORELIST, "+", "-", "−", "–"];
int MAX_CONTENT_IGNORELIST_ENTRIES = 10;

shape ElementWithText {
  data string safeText;
  data string ariaLabel;
}

// symbol keywords (e.g. +, -, >) match exactly so we don't suppress "sign-up", "5 > 3", "C++", etc.
bool matchesContentKeyword(string text, string keyword) {
  return if (new Regex("[a-z0-9]", "i").test(keyword)) { text.includes(keyword) } else { text == keyword };
}

bool shouldIgnoreByContent(JsValue contentIgnorelist, ElementWithText[] elementsWithText) {
  if (contentIgnorelist === false || isUndefined(contentIgnorelist)) {
    return false;
  }
  string[] keywords = [];
  if (contentIgnorelist === true) {
    keywords = DEFAULT_CONTENT_IGNORELIST;
  } else if (isArray(contentIgnorelist)) {
    if (contentIgnorelist.length > MAX_CONTENT_IGNORELIST_ENTRIES) {
      logger.error(`[PostHog] content_ignorelist array cannot exceed ${MAX_CONTENT_IGNORELIST_ENTRIES} items. Use css_selector_ignorelist for more complex matching.`);
      return false;
    }
    keywords = contentIgnorelist.map((JsValue k) => k.toLowerCase()) as string[];
  } else {
    return false;
  }
  return elementsWithText.some((ElementWithText element) =>
    keywords.some((string keyword) => matchesContentKeyword(element.safeText, keyword) || matchesContentKeyword(element.ariaLabel, keyword))
  );
}

// dead click capture does not run through autocapture's ph-no-capture check,
// so we include it here so that ph-no-capture also suppresses dead click capture
string[] DEFAULT_DEAD_CLICK_IGNORE_LIST = [".ph-no-deadclick", ".ph-no-capture"];

export bool shouldCaptureDeadClick(JsValue el, JsValue _config) {
  if (!window.truthy() || cannotCheckForAutocapture(el)) {
    return false;
  }
  JsValue selectorIgnoreList = DEFAULT_DEAD_CLICK_IGNORE_LIST;
  if (!isBoolean(_config)) {
    JsValue configured = if (_config == null) { undefined } else { _config.css_selector_ignorelist };
    if (configured != null) {
      selectorIgnoreList = configured;
    }
  }
  JsValue[] targetElementList = getElementAndParentsForElement(el, false).targetElementList;
  // we don't capture if we match the ignore list
  return !checkIfElementsMatchCSSSelector(targetElementList, selectorIgnoreList);
}

// autocapture check will already filter for ph-no-capture,
// but we include it here to protect against future changes accidentally removing that check
string[] DEFAULT_RAGE_CLICK_IGNORE_LIST = [".ph-no-rageclick", ".ph-no-capture"];

string[] TEXT_SELECTION_INPUT_TYPES = ["", "text", "search", "email", "password", "url", "tel", "number"];

bool isContentEditableTarget(JsValue el) {
  if (el.isContentEditable.truthy()) {
    return true;
  }
  // `el.getAttribute?.('contenteditable')`: read once, called on the element.
  JsValue getAttribute = el.getAttribute;
  JsValue contentEditable = if (getAttribute == null) { undefined } else { getAttribute.call(el, "contenteditable") };
  return contentEditable === "true" || contentEditable === "";
}

// repeated fast clicks on a text-editing surface are double/triple-click text selection, not rage
export bool isTextSelectionTarget(JsValue el) {
  if (!el.truthy() || !isElementNode(el)) {
    return false;
  }
  if (isTag(el, "textarea")) {
    return true;
  }
  if (isTag(el, "input")) {
    return TEXT_SELECTION_INPUT_TYPES.includes((el.getAttribute("type") || "").toLowerCase() as string);
  }
  return isContentEditableTarget(el);
}

export bool shouldCaptureRageclick(JsValue el, JsValue _config) {
  if (!window.truthy() || cannotCheckForAutocapture(el)) {
    return false;
  }
  JsValue selectorIgnoreList = DEFAULT_RAGE_CLICK_IGNORE_LIST;
  JsValue contentIgnorelist = undefined;
  JsValue ignoreTextSelection = false;
  if (isBoolean(_config)) {
    if (!_config.truthy()) {
      selectorIgnoreList = false;
    }
    // For backward compatibility, don't enable content or text-selection filtering for rageclick: true
  } else {
    JsValue configured = if (_config == null) { undefined } else { _config.css_selector_ignorelist };
    if (configured != null) {
      selectorIgnoreList = configured;
    }
    contentIgnorelist = if (_config == null) { undefined } else { _config.content_ignorelist };
    JsValue ignoreSelection = if (_config == null) { undefined } else { _config.ignore_text_selection };
    if (ignoreSelection != null) {
      ignoreTextSelection = ignoreSelection;
    }
  }
  if (selectorIgnoreList === false) {
    return false;
  }
  if (ignoreTextSelection.truthy() && isTextSelectionTarget(el)) {
    return false;
  }
  // Traverse DOM once and cache element data to avoid redundant calls to getSafeText
  JsValue[] targetElementList = getElementAndParentsForElement(el, false).targetElementList;
  ElementWithText[] elementsWithText = targetElementList.map((JsValue element) => {
    string safeText = getSafeText(element).toLowerCase();
    JsValue label = element.getAttribute("aria-label");
    JsValue ariaLabel = (if (label == null) { undefined } else { label.toLowerCase().trim() }) || "";
    return ElementWithText{safeText: safeText, ariaLabel: ariaLabel as string};
  });
  if (shouldIgnoreByContent(contentIgnorelist, elementsWithText)) {
    return false;
  }
  // we don't capture if we match the ignore list
  return !checkIfElementsMatchCSSSelector(targetElementList, selectorIgnoreList);
}

bool cannotCheckForAutocapture(JsValue el) {
  return !el.truthy() || isTag(el, "html") || !isElementNode(el);
}

shape ElementAndParents {
  data bool parentIsUsefulElement;
  data JsValue[] targetElementList;
}

ElementAndParents getElementAndParentsForElement(JsValue el, JsValue captureOnAnyElement) {
  if (!window.truthy() || cannotCheckForAutocapture(el)) {
    return ElementAndParents{parentIsUsefulElement: false, targetElementList: []};
  }
  bool parentIsUsefulElement = false;
  JsValue[] targetElementList = [el];
  JsValue curEl = el;
  while (curEl.parentNode.truthy() && !isTag(curEl, "body")) {
    if (isShadowRoot(curEl.parentNode)) {
      targetElementList.push(curEl.parentNode.host);
      curEl = curEl.parentNode.host;
      continue;
    }
    JsValue parentNode = getParentElement(curEl);
    if (!parentNode.truthy()) {
      break;
    }
    if (captureOnAnyElement.truthy() || autocaptureCompatibleElements.indexOf(parentNode.tagName.toLowerCase() as string) > -1) {
      parentIsUsefulElement = true;
    } else {
      try {
        JsValue compStyles = window.getComputedStyle(parentNode);
        if (compStyles.truthy() && compStyles.getPropertyValue("cursor") === "pointer") {
          parentIsUsefulElement = true;
        }
      } catch {
      }
    }
    targetElementList.push(parentNode);
    curEl = parentNode;
  }
  return ElementAndParents{parentIsUsefulElement: parentIsUsefulElement, targetElementList: targetElementList};
}

// dead-click skips a click only when the click target is — or is inside — an <a>.
// Anchors navigate / download / open a new window via the browser, and we have no
// observable signal for those actions (no DOM mutation, no scroll). For every other
// element (button, input, select, textarea, label, custom JS-handled divs, etc.) we
// rely on the existing mutation / scroll / selection / visibility observers — if the
// app's JS handler ran, those catch the effect; if it didn't, dead-click correctly
// surfaces the bug. A click on a broken <button> with no handler should still flag.
export bool shouldSkipDeadClick(JsValue el) {
  if (!window.truthy() || cannotCheckForAutocapture(el)) {
    return false;
  }
  JsValue[] targetElementList = getElementAndParentsForElement(el, false).targetElementList;
  return targetElementList.some((JsValue node) => isTag(node, "a"));
}

/*
 * Check whether a DOM event should be "captured" or if it may contain sensitive data
 * using a variety of heuristics.
 */
export bool shouldCaptureDomEvent(
  JsValue el,
  JsValue event,
  JsValue autocaptureConfig = undefined,
  JsValue captureOnAnyElement = undefined,
  JsValue allowedEventTypes = undefined,
  JsValue instance = undefined
) {
  if (!window.truthy() || cannotCheckForAutocapture(el)) {
    return false;
  }
  if (autocaptureConfig != null && autocaptureConfig.url_allowlist.truthy()) {
    // if the current URL is not in the allow list, don't capture
    if (!checkForURLMatches(autocaptureConfig.url_allowlist, instance)) {
      return false;
    }
  }
  if (autocaptureConfig != null && autocaptureConfig.url_ignorelist.truthy()) {
    // if the current URL is in the ignore list, don't capture
    if (checkForURLMatches(autocaptureConfig.url_ignorelist, instance)) {
      return false;
    }
  }
  if (autocaptureConfig != null && autocaptureConfig.dom_event_allowlist.truthy()) {
    JsValue allowlist = autocaptureConfig.dom_event_allowlist;
    if (allowlist.truthy() && !allowlist.some((JsValue eventType) => event.type === eventType).truthy()) {
      return false;
    }
  }
  ElementAndParents found = getElementAndParentsForElement(el, captureOnAnyElement);
  bool parentIsUsefulElement = found.parentIsUsefulElement;
  JsValue[] targetElementList = found.targetElementList;
  if (!checkIfElementTreePassesElementAllowList(targetElementList, autocaptureConfig)) {
    return false;
  }
  if (!checkIfElementsMatchCSSSelector(targetElementList, if (autocaptureConfig == null) { undefined } else { autocaptureConfig.css_selector_allowlist })) {
    return false;
  }
  JsValue selectorIgnoreList = if (autocaptureConfig == null) { undefined } else { autocaptureConfig.css_selector_ignorelist };
  if (selectorIgnoreList == null) {
    selectorIgnoreList = DEFAULT_AUTOCAPTURE_IGNORE_LIST;
  }
  if (checkIfElementsMatchCSSSelector(targetElementList, selectorIgnoreList)) {
    return false;
  }
  try {
    JsValue compStyles = window.getComputedStyle(el);
    if (compStyles.truthy() && compStyles.getPropertyValue("cursor") === "pointer" && event.type === "click") {
      return true;
    }
  } catch {
  }
  JsValue tag = el.tagName.toLowerCase();
  if (tag === "html") {
    return false;
  }
  if (tag === "form") {
    return (allowedEventTypes || ["submit"]).indexOf(event.type) >= 0;
  }
  if (tag === "input" || tag === "select" || tag === "textarea") {
    return (allowedEventTypes || ["change", "click"]).indexOf(event.type) >= 0;
  }
  if (parentIsUsefulElement) {
    return (allowedEventTypes || ["click"]).indexOf(event.type) >= 0;
  }
  return (allowedEventTypes || ["click"]).indexOf(event.type) >= 0 &&
    (autocaptureCompatibleElements.indexOf(tag as string) > -1 || el.getAttribute("contenteditable") === "true");
}

/*
 * Check whether a DOM element should be "captured" or if it may contain sensitive data
 * using a variety of heuristics.
 */
export bool shouldCaptureElement(JsValue el) {
  Set<JsValue> seen = new Set<JsValue>();
  int depth = 0;
  for (JsValue curEl = el; curEl.parentNode.truthy() && !isTag(curEl, "body"); curEl = curEl.parentNode) {
    // Abnormal (too deep or cyclic) chain: we can't finish the sensitivity
    // checks, so fail closed and don't capture.
    int current = depth;
    depth++;
    if (current >= MAX_DOM_ANCESTOR_DEPTH || seen.has(curEl)) {
      return false;
    }
    seen.add(curEl);
    string[] classes = getClassNames(curEl);
    if (classes.includes("ph-sensitive") || classes.includes("ph-no-capture")) {
      return false;
    }
  }
  if (getClassNames(el).includes("ph-include")) {
    return true;
  }
  // don't include hidden or password fields
  JsValue type = el.type || "";
  if (isString(type)) {
    // it's possible for el.type to be a DOM element if el is a form with a child input[name="type"]
    JsValue lowered = type.toLowerCase();
    if (lowered === "hidden" || lowered === "password") {
      return false;
    }
  }
  // filter out data from fields that look like sensitive fields
  JsValue name = el.name || el.id || "";
  // See https://github.com/posthog/posthog-js/issues/165
  // Under specific circumstances a bug caused .replace to be called on a DOM element
  // instead of a string, removing the element from the page. Ensure this issue is mitigated.
  if (isString(name)) {
    // it's possible for el.name or el.id to be a DOM element if el is a form with a child input[name="name"]
    if (new Regex("^cc|cardnum|ccnum|creditcard|csc|cvc|cvv|exp|pass|pwd|routing|seccode|securitycode|securitynum|socialsec|socsec|ssn", "i").test(name.replace(new Regex("[^a-zA-Z0-9]", "g"), "") as string)) {
      return false;
    }
  }
  return true;
}

/*
 * Check whether a DOM element is 'sensitive' and we should only capture limited data
 */
export bool isSensitiveElement(JsValue el) {
  // don't send data from inputs or similar elements since there will always be
  // a risk of clientside javascript placing sensitive data in attributes
  string[] allowedInputTypes = ["button", "checkbox", "submit", "reset"];
  return (isTag(el, "input") && !allowedInputTypes.includes(el.type as string)) ||
    isTag(el, "select") ||
    isTag(el, "textarea") ||
    el.getAttribute("contenteditable") === "true";
}

// Credit card numbers: the anchored form of the core pattern.
Regex anchoredCCRegex = new Regex("^(?:(4[0-9]{12}(?:[0-9]{3})?)|(5[1-5][0-9]{14})|(6(?:011|5[0-9]{2})[0-9]{12})|(3[47][0-9]{13})|(3(?:0[0-5]|[68][0-9])[0-9]{11})|((?:2131|1800|35[0-9]{3})[0-9]{11}))$");
// Network bodies are free-form strings, so only inspect complete, delimited number-like runs.
Regex networkCCCandidateRegex = new Regex("(^|[^0-9A-Za-z_])([0-9][0-9 -]*[0-9])(?=$|[^0-9A-Za-z_])", "g");
int[] networkCCLengths = [16, 15, 14, 13];

// SSNs with optional dashes: the anchored form of the core pattern.
Regex anchoredSSNRegex = new Regex("^(\\d{3}-?\\d{2}-?\\d{4})$");
// Network bodies exclude invalid SSN/ITIN groups and candidates within longer digit runs.
Regex networkSSNCandidateRegex = new Regex("(^|[^0-9])((?!000|666)[0-9]{3}-?(?!00)[0-9]{2}-?(?!0000)[0-9]{4})(?=$|([^0-9]))", "g");
Regex identifierCharacterRegex = new Regex("[0-9A-Za-z_]");

bool passesLuhnCheck(string value) {
  int sum = 0;
  bool shouldDouble = false;
  for (int i = value.length - 1; i >= 0; i--) {
    int digit = value.codeUnitAt(i) - 48;
    if (shouldDouble) {
      digit *= 2;
      if (digit > 9) {
        digit -= 9;
      }
    }
    sum += digit;
    shouldDouble = !shouldDouble;
  }
  return sum % 10 == 0;
}

bool containsCreditCardNumber(string value) {
  networkCCCandidateRegex.lastIndex = 0;
  auto found = networkCCCandidateRegex.exec(value);
  while (found != null) {
    JsValue matchedCandidate = found[2];
    if (matchedCandidate.truthy()) {
      string candidate = (matchedCandidate as string).replace(new Regex("[- ]", "g"), "");
      for (int start = 0; start < candidate.length; start++) {
        for (int length of networkCCLengths) {
          int end = start + length;
          if (end <= candidate.length) {
            string possibleCardNumber = candidate.slice(start, end);
            if (anchoredCCRegex.test(possibleCardNumber) && passesLuhnCheck(possibleCardNumber)) {
              return true;
            }
          }
        }
      }
    }
    found = networkCCCandidateRegex.exec(value);
  }
  return false;
}

bool containsSSN(string value) {
  networkSSNCandidateRegex.lastIndex = 0;
  auto found = networkSSNCandidateRegex.exec(value);
  while (found != null) {
    JsValue characterBefore = found[1];
    JsValue characterAfter = found[3];
    // UUID fragments and similar identifiers have identifier characters on both sides.
    if (!(characterBefore.truthy() && characterAfter.truthy() && identifierCharacterRegex.test(characterBefore as string) && identifierCharacterRegex.test(characterAfter as string))) {
      return true;
    }
    found = networkSSNCandidateRegex.exec(value);
  }
  return false;
}

/*
 * Check whether a string value should be "captured" or if it may contain sensitive data
 * using a variety of heuristics.
 */
export bool shouldCaptureValue(JsValue value, bool anchorRegexes = true) {
  if (isNullish(value)) {
    return false;
  }
  if (isString(value)) {
    string trimmed = trim(value as string);
    // check to see if input value looks like a credit card number
    // see: https://www.safaribooksonline.com/library/view/regular-expressions-cookbook/9781449327453/ch04s20.html
    bool containsCreditCard = if (anchorRegexes) { anchoredCCRegex.test(trimmed.replace(new Regex("[- ]", "g"), "")) } else { containsCreditCardNumber(trimmed) };
    if (containsCreditCard) {
      return false;
    }
    // check to see if input value looks like a social security number
    bool containsSocialSecurityNumber = if (anchorRegexes) { anchoredSSNRegex.test(trimmed) } else { containsSSN(trimmed) };
    if (containsSocialSecurityNumber) {
      return false;
    }
  }
  return true;
}

/*
 * Check whether an attribute name is an Angular style attr (either _ngcontent or _nghost)
 * These update on each build and lead to noise in the element chain
 * More details on the attributes here: https://angular.io/guide/view-encapsulation
 */
export bool isAngularStyleAttr(JsValue attributeName) {
  if (isString(attributeName)) {
    return attributeName.substring(0, 10) === "_ngcontent" || attributeName.substring(0, 7) === "_nghost";
  }
  return false;
}

/*
 * The text content of a target element's child span tags, separated by spaces,
 * along with the direct text content of the target element
 */
export string getDirectAndNestedSpanText(JsValue target) {
  string text = getSafeText(target);
  text = `${text} ${getNestedSpanText(target)}`.trim();
  return if (shouldCaptureValue(text, true)) { text } else { "" };
}

/*
 * The text content of a target element's child span tags, separated by spaces
 */
export string getNestedSpanText(JsValue target) {
  string text = "";
  if (target.truthy() && target.childNodes.truthy() && target.childNodes["length"].truthy()) {
    each(target.childNodes, (JsValue child) => {
      JsValue tagName = if (child.truthy()) { child.tagName } else { undefined };
      if (child.truthy() && (if (tagName == null) { undefined } else { tagName.toLowerCase() }) === "span") {
        try {
          string spanText = getSafeText(child);
          text = `${text} ${spanText}`.trim();
          if (child.childNodes.truthy() && child.childNodes["length"].truthy()) {
            text = `${text} ${getNestedSpanText(child)}`.trim();
          }
        } catch (JsValue e) {
          logger.error("[AutoCapture]", e);
        }
      }
    });
  }
  return text;
}

/*
Back in the day storing events in Postgres we use Elements for autocapture events.
Now we're using elements_chain. We used to do this parsing/processing during ingestion.
This code is just copied over from ingestion, but we should optimize it
to create elements_chain string directly.
*/
export string getElementsChainString(JsValue elements) {
  // This utility is directly importable from @posthog/browser-common, so guard runtime
  // JavaScript callers that bypass its TypeScript array contract.
  if (!isArray(elements)) {
    return "";
  }
  return elementsToString(extractElements(elements));
}

string escapeQuotes(string input) {
  return input.replace(new Regex("\"|\\\\\"", "g"), "\\\"");
}

// Plain lexical (code-unit) comparator. We avoid String.prototype.localeCompare here:
// on browsers with incomplete or faulty ICU data it can throw a RangeError ("Icu error"),
// and attribute keys do not need locale-aware ordering.
float lexicalCompare(string a, string b) {
  return if (a < b) { -1.0 } else { if (a > b) { 1.0 } else { 0.0 } };
}

// The chain elements (plugin-scaffold's 'Element') are plain objects copied from page-supplied
// properties; both passes use the arrays' own map, so sparse input keeps upstream's shape.
string elementsToString(JsValue elements) {
  JsValue ret = elements.map((JsValue element) => {
    string el_string = "";
    if (element.tag_name.truthy()) {
      el_string += element.tag_name;
    }
    if (element.attr_class.truthy()) {
      element.attr_class.sort();
      for (JsValue single_class of element.attr_class) {
        el_string += `.${single_class.replace(new Regex("\"", "g"), "")}`;
      }
    }
    // { ...(text ? { text } : {}), 'nth-child', 'nth-of-type', ...(href ? { href } : {}), ...(attr_id ? { attr_id } : {}), ...attributes }
    JsValue nthChild = element.nth_child;
    JsValue nthOfType = element.nth_of_type;
    JsValue attributes = Object.assign(
      object {},
      if (element.text.truthy()) { object { text: element.text } } else { object {} },
      object {
        "nth-child": if (nthChild == null) { 0 as JsValue } else { nthChild },
        "nth-of-type": if (nthOfType == null) { 0 as JsValue } else { nthOfType }
      },
      if (element.href.truthy()) { object { href: element.href } } else { object {} },
      if (element.attr_id.truthy()) { object { attr_id: element.attr_id } } else { object {} },
      element.attributes
    );
    JsValue sortedAttributes = object {};
    entries(attributes)
      .sort((JsValue a, JsValue b) => lexicalCompare(a[0] as string, b[0] as string))
      .forEach((JsValue pair) => {
        string key = escapeQuotes(pair[0].toString() as string);
        sortedAttributes[key] = escapeQuotes(pair[1].toString() as string);
      });
    el_string += ":";
    el_string += entries(sortedAttributes).map((JsValue pair) => `${pair[0]}="${pair[1]}"`).join("");
    return el_string;
  });
  return ret.join(";") as string;
}

JsValue extractElements(JsValue elements) {
  return elements.map((JsValue el) => {
    JsValue attributes = object {};
    JsValue text = el["$el_text"];
    JsValue textValue = if (text == null) { undefined } else { text.slice(0, 400) };
    JsValue tagName = el["tag_name"];
    JsValue href = el["attr__href"];
    JsValue hrefValue = if (href == null) { undefined } else { href.slice(0, 2048) };
    JsValue response = object {
      text: textValue,
      tag_name: tagName,
      href: hrefValue,
      attr_class: extractAttrClass(el),
      attr_id: el["attr__id"],
      nth_child: el["nth_child"],
      nth_of_type: el["nth_of_type"],
      attributes: attributes
    };
    entries(el)
      .filter((JsValue pair) => pair[0].indexOf("attr__") === 0)
      .forEach((JsValue pair) => {
        response.attributes[pair[0]] = pair[1];
      });
    return response;
  });
}

JsValue extractAttrClass(JsValue el) {
  JsValue attr_class = el["attr__class"];
  if (!attr_class.truthy()) {
    return undefined;
  }
  if (isArray(attr_class)) {
    return attr_class;
  }
  return splitClassString(attr_class);
}
