// packages/browser-common/src/utils/blocked-uas.ts — bot detection lives in @posthog/core; this module
// re-exports it and adds the navigator checks. The navigator and its experimental userAgentData are
// host objects, read defensively as upstream reads them.
import { DEFAULT_BLOCKED_UA_STRS, isBlockedUA } from "../../core/utils/bot-detection.lil";

export { DEFAULT_BLOCKED_UA_STRS, isBlockedUA };

export bool isLikelyBot(JsValue nav, JsValue customBlockedUserAgents) {
  if (!nav.truthy()) {
    return false;
  }
  JsValue ua = nav.userAgent;
  if (ua.truthy()) {
    if (isBlockedUA(ua as string?, customBlockedUserAgents)) {
      return true;
    }
  }
  try {
    JsValue uaData = nav.userAgentData;
    if (uaData != null && uaData.brands.truthy() && uaData.brands.some((JsValue brandObj) => isBlockedUA((if (brandObj == null) { undefined } else { brandObj.brand }) as string?, customBlockedUserAgents)).truthy()) {
      return true;
    }
  } catch {
  }
  return nav.webdriver.truthy();
}
