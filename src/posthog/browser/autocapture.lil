        captureEvent(self, e, "$rageclick", targetOverride);
      }
    }
  }

  bool isClipboardAutocapture = eventName == COPY_AUTOCAPTURE_EVENT;
  JsValue eventConfig = if (isClipboardAutocapture) { Object.assign(object {}, config, object { dom_event_allowlist: undefined }) } else { config };
  if (
    target.truthy() &&
    shouldCaptureDomEvent(
      target,
      e,
      eventConfig,
      // for clipboard events the target element's type does not matter
      isClipboardAutocapture,
      // and clipboard checks are not restricted to clicks
      if (isClipboardAutocapture) { ["copy", "cut", "paste"] as JsValue } else { undefined },
      object { config: object { get_current_url: config.getCurrentUrl } }
    ).truthy()
  ) {
    JsValue result = autocapturePropertiesForElement(target, object {
      e: e,
      maskAllElementAttributes: config.maskAllElementAttributes,
      maskAllText: config.maskAllText,
      elementAttributeIgnoreList: config.element_attribute_ignorelist,
      elementsChainAsString: self._elementsChainAsString,
      disableCaptureUrlHashes: config.disableCaptureUrlHashes
    });
    JsValue props = result.props;
    if (result.explicitNoCapture.truthy()) {
      return;
    }

    JsValue elementSelectors = (self as JsValue).getElementSelectors(target, result.target);
    if (elementSelectors.truthy() && elementSelectors["length"] > 0) {
      props.$element_selectors = elementSelectors;
    }

    if (eventName == COPY_AUTOCAPTURE_EVENT) {
      JsValue clipType = e.type || "clipboard";
      // paste content is not captured: the page usually emits an input change with the value
      if (clipType !== "paste") {
        JsValue selection = if (window == null) { undefined } else { window.getSelection() };
        JsValue selectedText = if (selection == null) { undefined } else { selection.toString() };
        JsValue selectedContent = makeSafeText(selectedText);
        if (!selectedContent.truthy()) {
          return;
        }
        props.$selected_content = selectedContent;
        JsValue length = if (selectedText == null) { undefined } else { selectedText["length"] };
        props.$clipboard_text_length = length ?? 0;
      }
      props.$copy_type = clipType;
    }

    JsValue client = self._client;
    if (client != null) {
      client.capture(eventName, props);
    }
  }
}
