    addEventListener(document, "paste", copiedTextHandler, object { capture: true });
  }
}

void removeDomEventHandlers(Autocapture self) {
  clearPointer(self);
  if (self._domEventHandler.truthy()) {
    if (window != null) {
      window.removeEventListener("blur", self._domEventHandler);
    }
    if (document != null) {
      document.removeEventListener("pointerdown", self._domEventHandler, true);
      document.removeEventListener("pointermove", self._domEventHandler, true);
      document.removeEventListener("pointerup", self._domEventHandler, true);
      document.removeEventListener("pointercancel", self._domEventHandler, true);
      document.removeEventListener("submit", self._domEventHandler, true);
      document.removeEventListener("change", self._domEventHandler, true);
      document.removeEventListener("click", self._domEventHandler, true);
    }
    self._domEventHandler = undefined;
  }
  if (self._copiedTextHandler.truthy()) {
    if (document != null) {
      document.removeEventListener("copy", self._copiedTextHandler, true);
      document.removeEventListener("cut", self._copiedTextHandler, true);
      document.removeEventListener("paste", self._copiedTextHandler, true);
    }
    self._copiedTextHandler = undefined;
  }
  self._initialized = false;
}

void captureEvent(Autocapture self, JsValue e, string eventName, JsValue targetOverride) {
