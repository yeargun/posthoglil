// packages/browser/src/remote-config.ts
// Loads the remote config: preloaded with the token's array.js, through the external script
// loader, or as JSON from the assets endpoint, then hands it to the instance.
// `posthog` keeps the loader reachable, so it keeps `_instance` (reserved in upstream's npm build),
// the `remoteConfig` getter and `load`; the private methods are module functions.
import extern { createLogger } from "@upstream/browser-common/utils/logger";
import extern { assignableWindow } from "@upstream/browser/utils/globals";
extern JsValue createLogger(string prefix);
extern JsValue assignableWindow;
extern JsValue Object;

JsValue logger = createLogger("[RemoteConfig]");

export class RemoteConfigLoader {
  JsValue _instance;

  init(JsValue _instance) {
    this._instance = _instance;
  }

  void load() {
    JsValue me = this as JsValue;
    try {
      // Attempt 1 - use the pre-loaded config if it came as part of the token-specific array.js
      if (me.remoteConfig.truthy()) {
        logger.info("Using preloaded remote config", me.remoteConfig);
        onRemoteConfig(this, me.remoteConfig, undefined);
        return;
      }

      if (this._instance._shouldDisableFlags().truthy()) {
        // This setting is essentially saying "dont call external APIs" hence we respect it here
        logger.warn("Remote config is disabled. Falling back to local config.");
        return;
      }

      // Attempt 2 - with the external deps loader, load the script version of the config that
      // includes site apps
      RemoteConfigLoader self = this;
      loadRemoteConfigJs(this, (JsValue config) => {
        if (!config.truthy()) {
          logger.info("No config found after loading remote JS config. Falling back to JSON.");
          // Attempt 3 - load the config JSON instead (no site apps, but the config)
          loadRemoteConfigJSON(self, (JsValue response) => {
            onRemoteConfig(self, response.json, response);
          });
          return;
        }
        onRemoteConfig(self, config, undefined);
      });
    } catch (JsValue error) {
      logger.error("Error loading remote config", error);
      onRemoteConfig(this, undefined, undefined);
    }
  }
}
export constructor RemoteConfigLoader;

JsValue remoteConfigOf(RemoteConfigLoader self) {
  JsValue configs = assignableWindow._POSTHOG_REMOTE_CONFIG;
  if (configs == null) {
    return undefined;
  }
  JsValue entry = configs[self._instance.config.token];
  return if (entry == null) { undefined } else { entry.config };
}

// Prototype getter, as upstream's class declares it.
Object.defineProperty((RemoteConfigLoader as JsValue).prototype, "remoteConfig", object {
  get: (this JsValue receiver) => remoteConfigOf(receiver as RemoteConfigLoader),
  configurable: true
});

void loadRemoteConfigJs(RemoteConfigLoader self, JsValue cb) {
  JsValue extensions = assignableWindow.__PosthogExtensions__;
  if ((if (extensions == null) { undefined } else { extensions.loadExternalDependency }).truthy()) {
    JsValue current = assignableWindow.__PosthogExtensions__;
    if (current != null && current.loadExternalDependency != null) {
      current.loadExternalDependency(self._instance, "remote-config", () => cb((self as JsValue).remoteConfig));
    }
  } else {
    cb();
  }
}

void loadRemoteConfigJSON(RemoteConfigLoader self, JsValue cb) {
  self._instance._send_request(object {
    method: "GET",
    url: self._instance.requestRouter.endpointFor("assets", `/array/${self._instance.config.token}/config`),
    callback: cb
  });
}

void onRemoteConfig(RemoteConfigLoader self, JsValue config, JsValue response) {
  if (!config.truthy() && response.truthy()) {
    if (response.statusCode === 0) {
      if (!response.error.truthy()) {
        logger.warn("Failed to fetch remote config from PostHog.");
      }
    } else {
      logger.error("Failed to fetch remote config from PostHog.");
    }
  }

  // Config and flags load separately; features referencing flags in their config check them
  // lazily, by when flags have loaded. Even when config fails, extensions are notified (as an
  // explicit failure) so settings that must not fail open keep their last known value.
  try {
    self._instance._onRemoteConfig(if (config.truthy()) { object { ok: true, config: config } } else { object { ok: false } });
  } catch (JsValue error) {
    logger.error("Error applying remote config", error);
  }

  JsValue hasFeatureFlags = if (config == null) { undefined } else { config.hasFeatureFlags };
  if (hasFeatureFlags !== false && !self._instance.config.advanced_disable_feature_flags_on_first_load.truthy()) {
    try {
      JsValue featureFlags = self._instance.featureFlags;
      if (featureFlags != null) {
        featureFlags.ensureFlagsLoaded();
      }
    } catch (JsValue error) {
      logger.error("Error loading feature flags", error);
    }
  }
}
