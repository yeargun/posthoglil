// LilScript-only helpers for plain JavaScript objects (no upstream twin).
extern JsValue Object;
extern JsValue Reflect;

// ECMAScript CopyDataProperties(target, source, « »): what an object literal's `...source` does, and what
// npm's build lowers it to. A null or undefined source is skipped; otherwise the source's own enumerable
// keys, in [[OwnPropertyKeys]] order (indices, strings, then symbols), are read and created on `target`
// as own data properties, so an own `__proto__` key stays a data property and no setter runs.
export JsValue copyDataProperties(JsValue target, JsValue source) {
  if (source === undefined || source === null) {
    return target;
  }
  JsValue from = Object(source);
  JsValue keys = Reflect.ownKeys(from);
  for (int i = 0; i < keys.length; i++) {
    JsValue key = keys[i];
    JsValue desc = Object.getOwnPropertyDescriptor(from, key);
    if (desc !== undefined && desc.enumerable.truthy()) {
      Object.defineProperty(target, key, object { value: from[key], writable: true, enumerable: true, configurable: true });
    }
  }
  return target;
}
