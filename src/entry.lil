  uiHostFromConfig,
  regionForHost,
  endpointFor,
  rateLimitContext,
  clampFlushInterval,
  formatQueue,
  applyOffsets,
  sortUnloadRequests
};

JsValue kernel() {
  JsValue api = JS.object();
  api["uuidv7"] = uuidv7;
  api["uuidv4"] = uuidv4;
  api["parseUuid"] = parseUuid;
  api["uuidFromFieldsV7"] = uuidFromFieldsV7;
  api["uuidToHex"] = uuidToHex;
  api["MINIMAL_FLAG_CALLED_EVENT_PROPERTIES"] = MINIMAL_FLAG_CALLED_EVENT_PROPERTIES;
  api["MINIMAL_FLAG_CALLED_EVENT_CAMPAIGN_PROPERTIES"] = MINIMAL_FLAG_CALLED_EVENT_CAMPAIGN_PROPERTIES;
  api["normalizeFlagsResponse"] = normalizeFlagsResponse;
  api["getFeatureFlagValue"] = getFeatureFlagValue;
  api["getFlagValuesFromFlags"] = getFlagValuesFromFlags;
  api["getPayloadsFromFlags"] = getPayloadsFromFlags;
  api["createFlagsResponseFromFlagsAndPayloads"] = createFlagsResponseFromFlagsAndPayloads;
  api["minimizeFlagCalledEventProperties"] = minimizeFlagCalledEventProperties;
  api["parsePayload"] = parsePayload;
  api["updateFlagValue"] = updateFlagValue;
  api["flagDetailsToResults"] = flagDetailsToResults;
  api["getPostHogCookieName"] = getPostHogCookieName;
  api["serializePostHogCookie"] = serializePostHogCookie;
  api["parsePostHogCookie"] = parsePostHogCookie;
  api["cookieStoreFromHeader"] = cookieStoreFromHeader;
  api["readPostHogCookie"] = readPostHogCookie;
  api["cookieStateToProperties"] = cookieStateToProperties;
  api["getConsentCookieName"] = getConsentCookieName;
  api["isOptedOut"] = isOptedOut;
  api["apiHostFromConfig"] = apiHostFromConfig;
  api["flagsApiHostFromConfig"] = flagsApiHostFromConfig;
  api["uiHostFromConfig"] = uiHostFromConfig;
  api["regionForHost"] = regionForHost;
  api["endpointFor"] = endpointFor;
  api["rateLimitContext"] = rateLimitContext;
  api["clampFlushInterval"] = clampFlushInterval;
  api["formatQueue"] = formatQueue;
  api["applyOffsets"] = applyOffsets;
  api["sortUnloadRequests"] = sortUnloadRequests;
  return api;
}

export JsValue default = kernel();
