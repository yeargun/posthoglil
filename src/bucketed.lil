import { floorNum, isNum, isUndef, minNum, toNum, toStr } from "./host.lil";

export number DEFAULT_EXCEPTION_RATE_LIMITER_REFILL_RATE = 1.0;
export number DEFAULT_EXCEPTION_RATE_LIMITER_BUCKET_SIZE = 10.0;

number readConfigNum(JsValue config, string key, string fallbackKey, number fallback) {
  if (isUndef(config) || JS.isNullish(config)) {
    return fallback;
  }
  JsValue primary = config[key];
  if (isNum(primary)) {
    return toNum(primary);
  }
  JsValue legacy = config[fallbackKey];
  if (isNum(legacy)) {
    return toNum(legacy);
  }
  return fallback;
}

export JsValue resolveExceptionRateLimiterConfig(JsValue config = JS.undefined()) {
  JsValue out = JS.object();
  out["refillRate"] = readConfigNum(
    config,
    "exceptionRateLimiterRefillRate",
    "__exceptionRateLimiterRefillRate",
    DEFAULT_EXCEPTION_RATE_LIMITER_REFILL_RATE
  );
  out["bucketSize"] = readConfigNum(
    config,
    "exceptionRateLimiterBucketSize",
    "__exceptionRateLimiterBucketSize",
    DEFAULT_EXCEPTION_RATE_LIMITER_BUCKET_SIZE
  );
  return out;
}

void applyRefill(JsValue bucket, number now, number refillRate, number bucketSize, number refillInterval) {
  number elapsedMs = now - toNum(bucket["lastAccess"]);
  number refillIntervals = floorNum(elapsedMs / refillInterval);
  if (refillIntervals > 0.0) {
    bucket["tokens"] = minNum(toNum(bucket["tokens"]) + refillIntervals * refillRate, bucketSize);
    bucket["lastAccess"] = toNum(bucket["lastAccess"]) + refillIntervals * refillInterval;
  }
}

export bool consumeBucketedRateLimit(
  JsValue buckets,
  JsValue key,
  number now,
  number refillRate,
  number bucketSize,
  number refillInterval
) {
  string keyStr = toStr(key);
  JsValue bucket = buckets[keyStr];
  if (isUndef(bucket) || JS.isNullish(bucket)) {
    bucket = JS.object();
    bucket["tokens"] = bucketSize;
    bucket["lastAccess"] = now;
    buckets[keyStr] = bucket;
  } else {
    applyRefill(bucket, now, refillRate, bucketSize, refillInterval);
  }
  number tokens = toNum(bucket["tokens"]);
  if (tokens == 0.0) {
    return true;
  }
  tokens = tokens - 1.0;
  bucket["tokens"] = tokens;
  return tokens == 0.0;
}
