import { floorNum, isUndef, minNum, toStr } from "./host.lil";

export number DEFAULT_EXCEPTION_RATE_LIMITER_REFILL_RATE = 1.0;
export number DEFAULT_EXCEPTION_RATE_LIMITER_BUCKET_SIZE = 10.0;

JsValue? present(JsValue value) {
  return value;
}

export JsValue resolveExceptionRateLimiterConfig(JsValue options = JS.undefined()) {
  JsValue config = if (JS.isUndefined(options)) { JS.object() } else { options };
  return object {
    refillRate: present(config["exceptionRateLimiterRefillRate"]) ?? present(config["__exceptionRateLimiterRefillRate"]) ?? DEFAULT_EXCEPTION_RATE_LIMITER_REFILL_RATE,
    bucketSize: present(config["exceptionRateLimiterBucketSize"]) ?? present(config["__exceptionRateLimiterBucketSize"]) ?? DEFAULT_EXCEPTION_RATE_LIMITER_BUCKET_SIZE
  };
}

export bool consumeBucketedRateLimit(
  JsValue buckets,
  JsValue key,
  number now,
  number refillRate,
  number bucketSize,
  number refillInterval
) {
  string keyStr = toStr(key);
  JsValue bucket = buckets[keyStr];
  if (!bucket.truthy()) {
    bucket = JS.object("tokens", bucketSize, "lastAccess", now);
    buckets[keyStr] = bucket;
  } else {
    number lastAccess = JS.assume(bucket["lastAccess"]);
    number refillIntervals = floorNum((now - lastAccess) / refillInterval);
    if (refillIntervals > 0.0) {
      number tokens = JS.assume(bucket["tokens"]);
      bucket["tokens"] = minNum(tokens + refillIntervals * refillRate, bucketSize);
      bucket["lastAccess"] = lastAccess + refillIntervals * refillInterval;
    }
  }
  number tokens = JS.assume(bucket["tokens"]);
  if (tokens == 0.0) {
    return true;
  }
  tokens = tokens - 1.0;
  bucket["tokens"] = tokens;
  return tokens == 0.0;
}
