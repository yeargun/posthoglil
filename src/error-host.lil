import {
  asObject,
  hasOwnValue,
  isArr,
  isStr,
  isUndef,
  len,
  objectTag,
  toStr,
  undef
} from "./host.lil";

export bool isStringValue(JsValue value) {
  return objectTag(value) == "[object String]";
}

export bool isNumberValue(JsValue value) {
  return objectTag(value) == "[object Number]" && JS.strictEqual(value, value);
}

export bool isBooleanValue(JsValue value) {
  return objectTag(value) == "[object Boolean]";
}

export bool isObjectValue(JsValue value) {
  return JS.strictEqual(value, asObject(value)) && !isArr(value);
}

export bool isEmptyStringValue(JsValue value) {
  return isStringValue(value) && toStr(value).trim().length == 0;
}

export bool isPrimitiveValue(JsValue value) {
  return JS.strictEqual(value, null) || JS.typeOf(value) != "object";
}

export bool isBuiltinValue(JsValue candidate, string className) {
  return objectTag(candidate) == "[object " + className + "]";
}

bool instanceOfCtor(JsValue candidate, JsValue ctor) {
  try {
    JsValue hasInstance = JS.invoke(Reflect, "get", ctor, Symbol["hasInstance"]);
    return JS.call(hasInstance, ctor, candidate).truthy();
  } catch {
    return false;
  }
}

export bool instanceOfValue(JsValue candidate, JsValue ctor) {
  return instanceOfCtor(candidate, ctor);
}

export bool isErrorValue(JsValue candidate) {
  string tag = objectTag(candidate);
  if (
    tag == "[object Error]" ||
    tag == "[object Exception]" ||
    tag == "[object DOMException]" ||
    tag == "[object DOMError]" ||
    tag == "[object WebAssembly.Exception]"
  ) {
    return true;
  }
  return instanceOfCtor(candidate, Error);
}

export bool isErrorEventValue(JsValue value) {
  return isBuiltinValue(value, "ErrorEvent");
}

export bool isEventValue(JsValue value) {
  JsValue eventCtor = globalThis["Event"];
  return !isUndef(eventCtor) && instanceOfCtor(value, eventCtor);
}

export string explicitString(JsValue value) {
  return toStr(JS.call(String, undef(), value));
}

export JsValue getPrototypeOf(JsValue value) {
  return JS.invoke(Object, "getPrototypeOf", value);
}

export string safeJsonStringify(JsValue value) {
  JsValue ancestors = JS.array();
  func(JsValue, JsValue, JsValue)->JsValue replacer = (
    JsValue self,
    JsValue key,
    JsValue replacementValue
  ) => {
    string kind = JS.typeOf(replacementValue);
    if (kind == "bigint") {
      return JS.invoke(replacementValue, "toString");
    }
    if (kind == "function" || kind == "symbol") {
      return undef();
    }
    if (instanceOfCtor(replacementValue, Error)) {
      JsValue serializedError = JS.object();
      serializedError["name"] = replacementValue["name"];
      serializedError["message"] = replacementValue["message"];
      serializedError["stack"] = replacementValue["stack"];
      return serializedError;
    }
    if (replacementValue.truthy() && kind == "object") {
      while (
        len(ancestors) > 0 &&
        !JS.strictEqual(ancestors[len(ancestors) - 1], self)
      ) {
        JS.invoke(ancestors, "pop");
      }
      if (JS.invoke(ancestors, "includes", replacementValue).truthy()) {
        return "[Circular]";
      }
      JS.invoke(ancestors, "push", replacementValue);
    }
    return replacementValue;
  };
  JsValue result = JS.invoke(JSON, "stringify", value, JS.method2(replacer));
  if (isUndef(result)) {
    return "null";
  }
  return toStr(result);
}

export bool owns(JsValue target, JsValue key) {
  return hasOwnValue(target, key);
}
