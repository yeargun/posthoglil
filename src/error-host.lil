import {
  asObject,
  hasOwnValue,
  isArr,
  isStr,
  isUndef,
  arrayLikeLength as len,
  objectTag,
  toStr,
  undef
} from "./host.lil";

extern JsValue Reflect;
extern JsValue Symbol;
extern JsValue Error;
extern JsValue globalThis;
extern JsValue String;
extern JsValue Object;
extern JsValue JSON;

import {
  isString as isStringValue,
  isNumber as isNumberValue,
  isBoolean as isBooleanValue,
  isObject as isObjectValue,
  isEmptyString as isEmptyStringValue,
  isPrimitive as isPrimitiveValue,
  isBuiltin as isBuiltinValue,
  isInstanceOf as instanceOfValue,
  isError as isErrorValue,
  isErrorEvent as isErrorEventValue,
  isEvent as isEventValue
} from "./types.lil";
export { isStringValue, isNumberValue, isBooleanValue, isObjectValue, isEmptyStringValue, isPrimitiveValue, isBuiltinValue, instanceOfValue, isErrorValue, isErrorEventValue, isEventValue };

export string explicitString(JsValue value) {
  return JS.assume(String(value));
}

export JsValue getPrototypeOf(JsValue value) {
  return JS.invoke(Object, "getPrototypeOf", value);
}

export string safeJsonStringify(JsValue value) {
  JsValue[] ancestors = [];
  func(JsValue, JsValue, JsValue)->JsValue replacer = (
    JsValue self,
    JsValue key,
    JsValue replacementValue
  ) => {
    string kind = JS.typeOf(replacementValue);
    if (kind == "bigint") {
      return JS.invoke(replacementValue, "toString");
    }
    if (kind == "function" || kind == "symbol") {
      return undef();
    }
    if (replacementValue instanceof Error) {
      JsValue serializedError = object { "name": replacementValue["name"], "message": replacementValue["message"], "stack": replacementValue["stack"] };
      return serializedError;
    }
    if (replacementValue.truthy() && kind == "object") {
      while (
        ancestors.length > 0 &&
        !JS.strictEqual(ancestors[ancestors.length - 1], self)
      ) {
        ancestors.pop();
      }
      if (ancestors.includes(replacementValue)) {
        return "[Circular]";
      }
      ancestors.push(replacementValue);
    }
    return replacementValue;
  };
  JsValue result = JS.invoke(JSON, "stringify", value, JS.method2(replacer));
  if (isUndef(result)) {
    return "null";
  }
  return toStr(result);
}

export bool owns(JsValue target, JsValue key) {
  return hasOwnValue(target, key);
}
