import {isArrayValue as isArr} from "./types.lil";
import {
  asObject,
  hasKey,
  isBool,
  isFiniteNum,
  isNullish,
  isNum,
  isStr,
  isUndef,
  jsonStringify,
  keysOf,
  len,
  nowMs,
  objectKeys,
  toNum,
  toStr,
  undef
} from "./host.lil";
import { sanitizeString } from "./json.lil";
import { isNumber } from "./types.lil";
import {
  explicitString,
  instanceOfValue,
  isBooleanValue
} from "./error-host.lil";

extern JsValue WeakSet;
extern JsValue Number;
extern JsValue globalThis;
extern JsValue Date;
extern JsValue String;
extern JsValue Object;
extern JsValue Reflect;

string circularValue = "[Circular]";
string truncatedValue = "[Truncated]";
string unserializableValue = "[Unserializable]";
string functionValue = "[Function]";
int maxDepth = 20;
int maxItems = 1000;
int maxNodes = 10000;
number int64RangeLimit = 9223372036854775808.0;

JsValue severityMap = object {
  trace: object { text: "TRACE", number: 1 },
  debug: object { text: "DEBUG", number: 5 },
  info: object { text: "INFO", number: 9 },
  warn: object { text: "WARN", number: 13 },
  error: object { text: "ERROR", number: 17 },
  fatal: object { text: "FATAL", number: 21 }
};

JsValue severityFor(JsValue level) {
  return JS.or(severityMap[level], severityMap["info"]);
}

export JsValue getOtlpSeverityText(JsValue level) {
  return severityFor(level)["text"];
}

export JsValue getOtlpSeverityNumber(JsValue level) {
  return severityFor(level)["number"];
}

// The encoder creates and owns this state; callers only see encoded values.
shape EncodingState {
  data JsValue ancestors;
  data number remainingNodes;
}

EncodingState newState() {
  return EncodingState { ancestors: JS.construct(WeakSet), remainingNodes: maxNodes };
}

void logDebug(JsValue logger, string message) {
  if (!isNullish(logger)) {
    JS.invoke(logger, "debug", message);
  }
}

JsValue stringAny(JsValue value) {
  JsValue out = object { "stringValue": value };
  return out;
}

JsValue encodeAnyValue(JsValue value, JsValue logger, EncodingState state, int depth) {
  if (state.remainingNodes <= 0.0) {
    return stringAny(truncatedValue);
  }
  state.remainingNodes = state.remainingNodes - 1.0;

  if (isBooleanValue(value)) {
    JsValue out = object { "boolValue": value };
    return out;
  }
  if (JS.typeOf(value) == "bigint") {
    string decimal = toStr(JS.invoke(value, "toString"));
    // Both bounds are exact powers of two. JavaScript's mixed BigInt/Number
    // relational comparison retains the integer value without coercing it.
    if (JS.greaterThanOrEqual(value, int64RangeLimit) || JS.lessThan(value, -int64RangeLimit)) {
      logDebug(logger, "Attribute " + decimal + " is outside the int64 range; encoding it as a string");
      return stringAny(decimal);
    }
    return JS.object("intValue", decimal);
  }
  if (JS.typeOf(value) == "number") {
    number numeric = toNum(value);
    if (!isFiniteNum(numeric)) {
      return stringAny(explicitString(value));
    }
    if (JS.invoke(Number, "isInteger", value).truthy()) {
      if (JS.invoke(Number, "isSafeInteger", value).truthy()) {
        return JS.object("intValue", explicitString(value));
      }
      JsValue bigIntConstructor = globalThis["BigInt"];
      if (isUndef(bigIntConstructor)) {
        return stringAny(explicitString(value));
      }
      string decimal = toStr(JS.invoke(bigIntConstructor(value), "toString"));
      if (numeric >= int64RangeLimit || numeric < -int64RangeLimit) {
        logDebug(logger, "Attribute " + decimal + " is outside the int64 range; encoding it as a string");
        return stringAny(decimal);
      }
      return JS.object("intValue", decimal);
    }
    JsValue out = object { "doubleValue": value };
    return out;
  }
  if (JS.typeOf(value) == "string") {
    return stringAny(sanitizeString(toStr(value)));
  }
  if (JS.typeOf(value) == "function") {
    return stringAny(functionValue);
  }
  if (JS.typeOf(value) == "symbol") {
    return stringAny(explicitString(value));
  }
  if (JS.typeOf(value) == "object" && !JS.strictEqual(value, null)) {
    if (JS.invoke(state.ancestors, "has", value).truthy()) {
      return stringAny(circularValue);
    }
    if (depth >= maxDepth) {
      return stringAny(truncatedValue);
    }
    if (value instanceof Date) {
      JsValue time = JS.invoke(value, "getTime");
      JsValue iso = undef();
      if (JS.invoke(Number, "isFinite", time).truthy()) {
        iso = JS.invoke(value, "toISOString");
      } else {
        iso = String(value);
      }
      if (JS.typeOf(iso) == "string") {
        return stringAny(sanitizeString(toStr(iso)));
      }
      return stringAny(explicitString(iso));
    }
    JS.invoke(state.ancestors, "add", value);
    try {
      try {
        JsValue toJSON = value["toJSON"];
        if (JS.typeOf(toJSON) == "function") {
          return encodeAnyValue(JS.call(toJSON, value), logger, state, depth + 1);
        }
      } catch {
      }
      if (isArr(value)) {
        JsValue arrayValue = object { "values": encodeArrayValues(value, logger, state, depth + 1) };
        JsValue out = object { "arrayValue": arrayValue };
        return out;
      }
      JsValue listValue = object { "values": encodeKeyValueList(value, logger, state, depth + 1) };
      JsValue out = object { "kvlistValue": listValue };
      return out;
    } finally {
      JS.invoke(state.ancestors, "delete", value);
    }
  }
  return stringAny(sanitizeString(explicitString(value)));
}

JsValue[] encodeArrayValues(JsValue values, JsValue logger, EncodingState state, int depth) {
  JsValue[] result = [];
  number total = JS.number(values["length"]);
  int itemCount = if (total > 1000.0) { maxItems } else { total.toInt() };
  int index = 0;
  for (; index < itemCount && state.remainingNodes > 0.0; index++) {
    try {
      if (JS.in(index, values)) {
        JsValue element = values[index];
        if (!isNullish(element)) {
          result.push(encodeAnyValue(element, logger, state, depth));
        }
      }
    } catch {
      result.push(stringAny(unserializableValue));
    }
  }
  // Re-read, as upstream does: an element's toJSON or getter may have grown the array.
  if (JS.number(values["length"]) > index) {
    result.push(stringAny(truncatedValue));
  }
  return result;
}

bool propertyEnumerable(JsValue target, string key) {
  return JS.invoke(Object["prototype"]["propertyIsEnumerable"], "call", target, key).truthy();
}

JsValue[] encodeKeyValueList(JsValue attrs, JsValue logger, EncodingState state, int depth) {
  JsValue[] result = [];
  for (string key in attrs) {
    if (propertyEnumerable(attrs, key)) {
      if (key == "") {
        logDebug(logger, "Dropping an attribute with an empty key");
        continue;
      }
      if (result.length >= maxItems || state.remainingNodes <= 0.0) {
        logDebug(logger, "Attributes truncated: the value exceeds the OTLP encoder budget");
        break;
      }
      try {
        JsValue value = attrs[key];
        if (!isNullish(value)) {
          result.push(object { key: sanitizeString(key), value: encodeAnyValue(value, logger, state, depth) });
        }
      } catch {
        result.push(object { key: sanitizeString(key), value: stringAny(unserializableValue) });
      }
    }
  }
  return result;
}

export JsValue toOtlpAnyValue(JsValue value, JsValue logger = JS.undefined()) {
  try {
    return encodeAnyValue(value, logger, newState(), 0);
  } catch {
    return stringAny(unserializableValue);
  }
}

export JsValue[] toOtlpKeyValueList(JsValue attrs, JsValue logger = JS.undefined()) {
  try {
    return encodeKeyValueList(attrs, logger, newState(), 0);
  } catch {
    return [];
  }
}

JsValue spreadOwn(JsValue target, JsValue source) {
  if (isNullish(source)) {
    return target;
  }
  JsValue boxed = asObject(source);
  JsValue keys = JS.invoke(Reflect, "ownKeys", boxed);
  int i = 0;
  while (i < len(keys)) {
    JsValue key = keys[i];
    if (JS.invoke(Object["prototype"]["propertyIsEnumerable"], "call", boxed, key).truthy()) {
      JsValue descriptor = object { "value": JS.invoke(Reflect, "get", boxed, key), "enumerable": true, "writable": true, "configurable": true };
      JS.invoke(Object, "defineProperty", target, key, descriptor);
    }
    i = i + 1;
  }
  return target;
}

void defineData(JsValue target, JsValue key, JsValue value) {
  JsValue descriptor = object { "value": value, "enumerable": true, "writable": true, "configurable": true };
  JS.invoke(Object, "defineProperty", target, key, descriptor);
}

string encodeBody(JsValue body) {
  try {
    return sanitizeString(explicitString(body));
  } catch {
    return unserializableValue;
  }
}

export JsValue buildOtlpLogRecord(JsValue options, JsValue sdkContext, JsValue logger = JS.undefined(), JsValue occurredAtMs = JS.undefined()) {
  JsValue level = options["level"];
  if (!level.truthy()) {
    level = "info";
  }
  JsValue severity = severityFor(level);
  JsValue timestamp = occurredAtMs;
  if (!isNumber(timestamp)) timestamp = nowMs();
  string now = explicitString(timestamp) + "000000";
  JsValue autoAttributes = JS.object();
  if (sdkContext["distinctId"].truthy()) autoAttributes["posthogDistinctId"] = sdkContext["distinctId"];
  if (sdkContext["sessionId"].truthy()) autoAttributes["sessionId"] = sdkContext["sessionId"];
  if (sdkContext["windowId"].truthy()) autoAttributes["window.id"] = sdkContext["windowId"];
  if (!isNullish(sdkContext["sessionStartTimestamp"])) autoAttributes["sessionStartTimestamp"] = explicitString(sdkContext["sessionStartTimestamp"]);
  if (!isNullish(sdkContext["lastActivityTimestamp"])) autoAttributes["lastActivityTimestamp"] = explicitString(sdkContext["lastActivityTimestamp"]);
  if (sdkContext["currentUrl"].truthy()) autoAttributes["url.full"] = sdkContext["currentUrl"];
  if (sdkContext["screenName"].truthy()) autoAttributes["screen.name"] = sdkContext["screenName"];
  if (sdkContext["appState"].truthy()) autoAttributes["app.state"] = sdkContext["appState"];
  if (sdkContext["activeFeatureFlags"].truthy() && len(sdkContext["activeFeatureFlags"]) > 0) {
    autoAttributes["feature_flags"] = sdkContext["activeFeatureFlags"];
  }
  JsValue mergedAttributes = spreadOwn(JS.object(), autoAttributes);
  JsValue userAttributes = options["attributes"];
  if (userAttributes.truthy()) {
    string[] keys = [];
    try {
      keys = keysOf(userAttributes);
    } catch {
      keys = [];
    }
    keys.forEach((string key) => {
      JsValue value = undef();
      try {
        value = userAttributes[key];
      } catch {
        value = unserializableValue;
      }
      defineData(mergedAttributes, key, value);
    });
  }
  JsValue logRecord = object {
    timeUnixNano: now,
    observedTimeUnixNano: now,
    severityNumber: severity["number"],
    severityText: severity["text"],
    body: object { stringValue: encodeBody(options["body"]) },
    attributes: toOtlpKeyValueList(mergedAttributes, logger)
  };
  if (options["trace_id"].truthy()) logRecord["traceId"] = options["trace_id"];
  if (options["span_id"].truthy()) logRecord["spanId"] = options["span_id"];
  if (!isUndef(options["trace_flags"])) logRecord["flags"] = options["trace_flags"];
  return logRecord;
}

JsValue assignUserAttributes(JsValue target, JsValue source) {
  if (!source.truthy()) return target;
  string[] keys = [];
  try { keys = keysOf(source); } catch { keys = []; }
  for (string key of keys) {
    JsValue value = undef();
    try { value = source[key]; } catch { value = unserializableValue; }
    defineData(target, key, value);
  }
  return target;
}

string[] sdkResourceKeys = ["service.name", "deployment.environment", "service.version", "telemetry.sdk.name", "telemetry.sdk.version"];

export JsValue[] toOtlpResourceKeyValueList(JsValue attributes, JsValue logger = JS.undefined()) {
  JsValue user = assignUserAttributes(JS.object(), attributes);
  JsValue sdk = JS.object();
  for (string key of sdkResourceKeys) {
    if (JS.invoke(Object["prototype"]["hasOwnProperty"], "call", user, key).truthy()) {
      sdk[key] = user[key];
      JS.delete(user, key);
    }
  }
  return [...toOtlpKeyValueList(user, logger), ...toOtlpKeyValueList(sdk, logger)];
}

export JsValue buildOtlpResourceAttributes(JsValue config, string sdkName, string sdkVersion) {
  JsValue out = assignUserAttributes(JS.object(), config["resourceAttributes"]);
  out["service.name"] = JS.or(config["serviceName"], "unknown_service");
  if (config["environment"].truthy()) out["deployment.environment"] = config["environment"];
  if (config["serviceVersion"].truthy()) out["service.version"] = config["serviceVersion"];
  out["telemetry.sdk.name"] = sdkName;
  out["telemetry.sdk.version"] = sdkVersion;
  return out;
}

export JsValue buildResourceAttributes(JsValue config, string sdkName, string sdkVersion) {
  return buildOtlpResourceAttributes(config, sdkName, sdkVersion);
}

export JsValue buildOtlpLogsPayload(JsValue logRecords, JsValue resourceAttributes, string scopeName, string scopeVersion) {
  JsValue[] scopeLogs = [object { scope: object { name: scopeName, version: scopeVersion }, logRecords: logRecords }];
  JsValue[] resourceLogs = [object { resource: object { attributes: toOtlpResourceKeyValueList(resourceAttributes) }, scopeLogs: scopeLogs }];
  return object { resourceLogs: resourceLogs };
}

int[] histogramBounds = [0, 5, 10, 25, 50, 75, 100, 250, 500, 750, 1000, 2500, 5000, 7500, 10000];
export JsValue DEFAULT_HISTOGRAM_BOUNDS = histogramBounds;

export string msToUnixNano(JsValue milliseconds) {
  return explicitString(milliseconds) + "000000";
}

export string seriesKey(string type, string name, JsValue unit, JsValue attributes) {
  string attrsKey = "";
  if (attributes.truthy()) {
    string[] keys = JS.assume(JS.invoke(JS.invoke(Object, "keys", attributes), "sort"));
    attrsKey = keys.map((string key) => {
      string k = JS.assume(jsonStringify(key));
      string v = JS.assume(jsonStringify(attributes[key]));
      return k + ":" + v;
    }).join(",");
  }
  string unitText = if (isNullish(unit)) { "" } else { toStr(unit) };
  return type + "\u0000" + name + "\u0000" + unitText + "\u0000" + attrsKey;
}

export int bucketIndexFor(number value, JsValue bounds) {
  number[] list = JS.assume(bounds);
  for (int i = 0; i < list.length; i++) {
    if (value <= list[i]) {
      return i;
    }
  }
  return list.length;
}

export JsValue buildMetricsResourceAttributes(JsValue config, string scopeName, string scopeVersion) {
  return buildOtlpResourceAttributes(config, scopeName, scopeVersion);
}

export JsValue buildOtlpMetricsPayload(JsValue metrics, JsValue resourceAttributes, string scopeName, string scopeVersion) {
  JsValue[] scopeMetrics = [object { scope: object { name: scopeName, version: scopeVersion }, metrics: metrics }];
  JsValue[] resourceMetrics = [object { resource: object { attributes: toOtlpResourceKeyValueList(resourceAttributes) }, scopeMetrics: scopeMetrics }];
  return object { resourceMetrics: resourceMetrics };
}

export JsValue resolveMetricsConfig(JsValue config) {
  JsValue resourceAttributes = undef();
  if (!isNullish(config)) {
    resourceAttributes = config["resourceAttributes"];
  }
  JsValue out = JS.object();
  string[] resourceKeys = ["service.name", "service.version", "deployment.environment"];
  string[] outputKeys = ["serviceName", "serviceVersion", "environment"];
  int i = 0;
  while (i < resourceKeys.length) {
    JsValue value = undef();
    if (!isNullish(resourceAttributes)) {
      value = resourceAttributes[resourceKeys[i]];
    }
    if (isNullish(value) && !isNullish(config)) {
      value = config[outputKeys[i]];
    }
    out[outputKeys[i]] = value;
    i = i + 1;
  }
  out["resourceAttributes"] = resourceAttributes;
  if (!isNullish(config)) out["beforeSend"] = config["beforeSend"];
  else out["beforeSend"] = undef();
  JsValue flush = undef();
  JsValue maxSeries = undef();
  if (!isNullish(config)) {
    flush = config["flushIntervalMs"];
    maxSeries = config["maxSeriesPerFlush"];
  }
  if (isNullish(flush)) flush = 10000;
  if (isNullish(maxSeries)) maxSeries = 1000;
  out["flushIntervalMs"] = flush;
  out["maxSeriesPerFlush"] = maxSeries;
  return out;
}
