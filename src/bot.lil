export JsValue DEFAULT_BLOCKED_UA_STRS = blockedUserAgents;

bool listBlocksUa(string uaLower, JsValue list) {
  int n = len(list);
  int i = 0;
  while (i < n) {
    if (uaLower.indexOf(toStr(list[i]).toLowerCase()) != -1) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

export bool isBlockedUA(JsValue ua, JsValue customBlockedUserAgents = JS.undefined()) {
  if (!ua.truthy()) {
    return false;
  }
  string uaLower = toStr(ua).toLowerCase();
  if (listBlocksUa(uaLower, blockedUserAgents)) {
    return true;
  }
  if (isUndef(customBlockedUserAgents) || !isArr(customBlockedUserAgents)) {
    return false;
  }
  return listBlocksUa(uaLower, customBlockedUserAgents);
}
