export bool isBlockedUA(JsValue ua, JsValue customBlockedUserAgents = JS.array()) {
  if (!ua.truthy()) {
    return false;
  }
  JsValue uaLower = JS.invoke(ua, "toLowerCase");
  // Concat performs observable spread/getter work before the first match.
  // Keep that contract, including custom arrays with Symbol.isConcatSpreadable.
  JsValue blocked = JS.invoke(DEFAULT_BLOCKED_UA_STRS, "concat", customBlockedUserAgents);
  func(JsValue)->bool blocks = (JsValue value) => !JS.strictEqual(JS.invoke(uaLower, "indexOf", JS.invoke(value, "toLowerCase")), -1);
  return JS.invoke(blocked, "some", blocks).truthy();
}
