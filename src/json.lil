export string sanitizeString(string value) {
  string output = "";
  int n = value.length;
  for (int index = 0; index < n; index++) {
    int codeUnit = value.charCodeAt(index);
    if (codeUnit >= 55296 && codeUnit <= 56319) {
      int nextCodeUnit = value.charCodeAt(index + 1);
      if (nextCodeUnit >= 56320 && nextCodeUnit <= 57343) {
        output = output + value.charAt(index) + value.charAt(index + 1);
        index++;
      } else {
        output = output + "�";
      }
    } else {
      output = output + (if (codeUnit >= 56320 && codeUnit <= 57343) { "�" } else { value.charAt(index) });
    }
  }
  return output;
}
