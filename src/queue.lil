import {
  absNum,
  copyObj,
  isFiniteNum,
  isNum,
  isUndef,
  toNum,
  toStr,
  undef
} from "./host.lil";

number defaultFlush = 3000.0;

export number clampFlushInterval(JsValue value) {
  if (value is float && isFiniteNum(value)) {
    if (value > 5000.0) {
      return 5000.0;
    }
    if (value < 250.0) {
      return 250.0;
    }
    return value;
  }
  return defaultFlush;
}

export JsValue formatQueue(JsValue[] items) {
  JsValue requests = JS.object();
  // for...of, as upstream: a hole is read as undefined and throws, where forEach would skip it.
  for (JsValue req of items) {
    JsValue key = JS.or(req["batchKey"], req["url"]);
    if (isUndef(requests[key])) {
      requests[key] = object { url: req["url"], batchKey: req["batchKey"], data: JS.array() };
    }
    JS.invoke(requests[key]["data"], "push", req["data"]);
  }
  return requests;
}

export JsValue[] applyOffsets(JsValue[] data, number now) {
  return data.map((JsValue item) => {
    JsValue next = copyObj(item);
    JsValue timestamp = next["timestamp"];
    if (timestamp is float) {
      next["offset"] = absNum(timestamp - now);
      JS.delete(next, "timestamp");
    }
    return next;
  });
}

export JsValue[] sortUnloadRequests(JsValue[] requests) {
  return [
    ...requests.filter((JsValue req) => JS.strictEqual(JS.invoke(req["url"], "indexOf", "/e"), 0)),
    ...requests.filter((JsValue req) => !JS.strictEqual(JS.invoke(req["url"], "indexOf", "/e"), 0))
  ];
}
