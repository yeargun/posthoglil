import {isArrayValue as isArr} from "./types.lil";
import {
  copyObj,
  hasKey,
  isFiniteNum,
  isNullish,
  isUndef,
  jsonParse,
  len,
  objectAssign,
  objectKeys,
  toNum,
  toStr,
  typeError,
  undef
} from "./host.lil";
import {
  isErrorValue,
  isNumberValue,
  isObjectValue,
  isStringValue,
  safeJsonStringify
} from "./error-host.lil";

extern JsValue Math;
extern JsValue globalThis;
extern JsValue encodeURIComponent;
extern JsValue Object;
extern JsValue Map;
extern JsValue Set;
extern JsValue Number;
extern number Infinity;

export JsValue EXCEPTION_STEP_INTERNAL_FIELDS = object { MESSAGE: "$message", TIMESTAMP: "$timestamp" };
export JsValue DEFAULT_EXCEPTION_STEPS_CONFIG = object { enabled: true, max_bytes: 32768 };

JsValue normalizePositiveInteger(JsValue input, JsValue fallback) {
  if (!isNumberValue(input) || JS.strictEqual(input, Infinity) || JS.strictEqual(input, -Infinity)) {
    return fallback;
  }
  JsValue normalized = JS.invoke(Math, "floor", input);
  if (JS.lessThan(normalized, 0)) {
    return fallback;
  }
  return normalized;
}

export JsValue resolveExceptionStepsConfig(JsValue config = JS.undefined()) {
  if (!config.truthy()) {
    return copyObj(DEFAULT_EXCEPTION_STEPS_CONFIG);
  }
  JsValue out = JS.object();
  JsValue enabled = config["enabled"];
  if (isNullish(enabled)) {
    out["enabled"] = DEFAULT_EXCEPTION_STEPS_CONFIG["enabled"];
  } else {
    out["enabled"] = enabled;
  }
  out["max_bytes"] = normalizePositiveInteger(
    config["max_bytes"],
    DEFAULT_EXCEPTION_STEPS_CONFIG["max_bytes"]
  );
  return out;
}

export JsValue stripReservedExceptionStepFields(JsValue properties = JS.undefined()) {
  JsValue sanitizedProperties = JS.object();
  JsValue droppedKeys = JS.array();
  if (properties.truthy()) {
    JsValue keys = objectKeys(properties);
    int i = 0;
    while (i < len(keys)) {
      JsValue key = keys[i];
      if (JS.strictEqual(key, "$message") || JS.strictEqual(key, "$timestamp")) {
        JS.invoke(droppedKeys, "push", key);
      } else {
        sanitizedProperties[key] = properties[key];
      }
      i = i + 1;
    }
  }
  JsValue out = object { "sanitizedProperties": sanitizedProperties, "droppedKeys": droppedKeys };
  return out;
}

shape SerializedStep {
  data JsValue step;
  data string json;
}

SerializedStep? normalizeAndSerializeStep(JsValue step) {
  string json = "";
  try {
    json = safeJsonStringify(step);
  } catch {
    return null;
  }
  try {
    JsValue parsed = jsonParse(json);
    if (!isObjectValue(parsed)) {
      return null;
    }
    JsValue message = parsed["$message"];
    JsValue timestamp = parsed["$timestamp"];
    if (!isStringValue(message) || toStr(message).trim().length == 0) {
      return null;
    }
    if (!isStringValue(timestamp) && !isNumberValue(timestamp)) {
      return null;
    }
    return SerializedStep { step: parsed, json: json };
  } catch {
    return null;
  }
}

export number getUtf8ByteLength(string value) {
  JsValue textEncoder = globalThis["TextEncoder"];
  if (!isUndef(textEncoder)) {
    JsValue encoder = JS.construct(textEncoder);
    // TextEncoder lengths are ordinary JavaScript numbers, never signed i32.
    // Read once without coercion, matching upstream even for a replaced encoder.
    return JS.assume(JS.invoke(encoder, "encode", value)["length"]);
  }
  string encoded = toStr(encodeURIComponent(value));
  number byteLength = 0;
  int i = 0;
  while (i < encoded.length) {
    if (encoded[i] == "%") {
      byteLength = byteLength + 1;
      i = i + 2;
    } else {
      byteLength = byteLength + 1;
    }
    i = i + 1;
  }
  return byteLength;
}

JsValue stepsConstructor(JsValue self, JsValue config) {
  self["_entries"] = JS.array();
  self["_totalBytes"] = 0;
  self["_config"] = resolveExceptionStepsConfig(config);
  return undef();
}

JsValue stepsTrim(JsValue self) {
  while (
    JS.number(self["_totalBytes"]) > JS.number(self["_config"]["max_bytes"]) &&
    len(self["_entries"]) > 0
  ) {
    JsValue evicted = JS.invoke(self["_entries"], "shift");
    if (evicted.truthy()) {
      self["_totalBytes"] = JS.number(self["_totalBytes"]) - JS.number(evicted["bytes"]);
    }
  }
  return undef();
}

JsValue stepsSetConfig(JsValue self, JsValue config) {
  self["_config"] = resolveExceptionStepsConfig(config);
  JS.invoke(self, "_trimToMaxBytes");
  return undef();
}

JsValue stepsAdd(JsValue self, JsValue step) {
  SerializedStep? serialized = normalizeAndSerializeStep(step);
  if (serialized == null) {
    return undef();
  }
  number bytes = getUtf8ByteLength(serialized.json);
  if (bytes > JS.number(self["_config"]["max_bytes"])) {
    return undef();
  }
  JsValue entry = object { "step": serialized.step, "bytes": bytes };
  JS.invoke(self["_entries"], "push", entry);
  self["_totalBytes"] = JS.number(self["_totalBytes"]) + bytes;
  JS.invoke(self, "_trimToMaxBytes");
  return undef();
}

JsValue stepsGetAttachable(JsValue self) {
  JsValue out = JS.array();
  int i = 0;
  while (i < len(self["_entries"])) {
    JS.invoke(out, "push", self["_entries"][i]["step"]);
    i = i + 1;
  }
  return out;
}

JsValue stepsClear(JsValue self) {
  self["_entries"] = JS.array();
  self["_totalBytes"] = 0;
  return undef();
}

JsValue stepsSize(JsValue self) {
  return len(self["_entries"]);
}

export class ExceptionStepsBuffer {
  init(JsValue config) { stepsConstructor(this, config); }
  JsValue setConfig(JsValue a0) { return stepsSetConfig(this, a0); }
  JsValue add(JsValue a0) { return stepsAdd(this, a0); }
  JsValue getAttachable() { return stepsGetAttachable(this); }
  JsValue clear() { return stepsClear(this); }
  JsValue size() { return stepsSize(this); }
  JsValue _trimToMaxBytes() { return stepsTrim(this); }
}
export constructor ExceptionStepsBuffer;

// The complete SDK owns this buffer and never exports its constructor. Keep
// mutable state in the closure; the standalone public class above still has
// its original prototype, subclassing and receiver behavior.
shape SdkStep {
  data JsValue step;
  data number bytes;
}

export JsValue createSdkExceptionStepsBuffer(JsValue input = JS.undefined()) {
  JsValue config = resolveExceptionStepsConfig(input);
  SdkStep[] entries = [];
  number totalBytes = 0;
  func()->void trim = () => {
    while (totalBytes > JS.number(config["max_bytes"]) && entries.length > 0) {
      SdkStep? evicted = JS.assume(JS.invoke(entries, "shift"));
      if (evicted != null) totalBytes = totalBytes - evicted.bytes;
    }
  };
  return object {
    setConfig: (JsValue next) => {
      config = resolveExceptionStepsConfig(next);
      trim();
    },
    add: (JsValue step) => {
      SerializedStep? serialized = normalizeAndSerializeStep(step);
      if (serialized != null) {
        number bytes = getUtf8ByteLength(serialized.json);
        if (!(bytes > JS.number(config["max_bytes"]))) {
          entries.push(SdkStep { step: serialized.step, bytes: bytes });
          totalBytes = totalBytes + bytes;
          trim();
        }
      }
    },
    getAttachable: () => {
      return entries.map((SdkStep entry) => entry.step);
    },
    clear: () => {
      entries = [];
      totalBytes = 0;
    }
  };
}

JsValue cacheConstructor(JsValue self, JsValue maxSize) {
  self["_maxSize"] = maxSize;
  self["_cache"] = JS.construct(Map);
  return undef();
}

JsValue cacheGet(JsValue self, JsValue key) {
  JsValue value = JS.invoke(self["_cache"], "get", key);
  if (isUndef(value)) {
    return undef();
  }
  JS.invoke(self["_cache"], "delete", key);
  JS.invoke(self["_cache"], "set", key, value);
  return value;
}

JsValue cacheSet(JsValue self, JsValue key, JsValue value) {
  JS.invoke(self["_cache"], "set", key, value);
  return undef();
}

JsValue cacheReduce(JsValue self) {
  while (JS.number(self["_cache"]["size"]) >= JS.number(self["_maxSize"])) {
    JsValue iterator = JS.invoke(self["_cache"], "keys");
    JsValue value = JS.invoke(iterator, "next")["value"];
    if (value.truthy()) {
      JS.invoke(self["_cache"], "delete", value);
    }
  }
  return undef();
}

export class ReduceableCache {
  init(JsValue maxSize) { cacheConstructor(this, maxSize); }
  JsValue get(JsValue a0) { return cacheGet(this, a0); }
  JsValue set(JsValue a0, JsValue a1) { return cacheSet(this, a0, a1); }
  JsValue reduce() { return cacheReduce(this); }
}
export constructor ReduceableCache;

JsValue parsedStackResults = JS.undefined();
JsValue lastKeysCount = JS.undefined();
JsValue cachedFilenameChunkIds = JS.undefined();

JsValue getFilenameToChunkIdMap(JsValue stackParser) {
  JsValue chunkIdMap = globalThis["_posthogChunkIds"];
  if (!chunkIdMap.truthy()) {
    return undef();
  }
  JsValue chunkIdKeys = objectKeys(chunkIdMap);
  if (cachedFilenameChunkIds.truthy() && JS.strictEqual(len(chunkIdKeys), lastKeysCount)) {
    return cachedFilenameChunkIds;
  }
  lastKeysCount = len(chunkIdKeys);
  cachedFilenameChunkIds = JS.object();
  int keyIndex = 0;
  while (keyIndex < len(chunkIdKeys)) {
    JsValue stackKey = chunkIdKeys[keyIndex];
    if (!parsedStackResults.truthy()) {
      parsedStackResults = JS.object();
    }
    JsValue result = parsedStackResults[stackKey];
    if (result.truthy()) {
      cachedFilenameChunkIds[result[0]] = result[1];
    } else {
      JsValue parsedStack = stackParser(stackKey);
      int frameIndex = len(parsedStack) - 1;
      while (frameIndex >= 0) {
        JsValue stackFrame = parsedStack[frameIndex];
        JsValue filename = undef();
        if (!isNullish(stackFrame)) {
          filename = stackFrame["filename"];
        }
        JsValue chunkId = chunkIdMap[stackKey];
        if (filename.truthy() && chunkId.truthy()) {
          cachedFilenameChunkIds[filename] = chunkId;
          JsValue pair = JS.array();
          JS.invoke(pair, "push", filename);
          JS.invoke(pair, "push", chunkId);
          parsedStackResults[stackKey] = pair;
          break;
        }
        frameIndex = frameIndex - 1;
      }
    }
    keyIndex = keyIndex + 1;
  }
  return cachedFilenameChunkIds;
}

JsValue fallbackException(JsValue self, JsValue context) {
JsValue syntheticException = context["syntheticException"];
  return object { type: "Error", value: "Unknown error", stack: if (isNullish(syntheticException)) { undef() } else { syntheticException["stack"] }, synthetic: true };
}

JsValue builderApplyCoercers(JsValue self, JsValue input, JsValue context) {
  JsValue coercers = self["coercers"];
  int i = 0;
  while (i < len(coercers)) {
    JsValue adapter = coercers[i];
    if (JS.invoke(adapter, "match", input).truthy()) {
      return JS.invoke(adapter, "coerce", input, context);
    }
    i = i + 1;
  }
  return JS.invoke(self, "coerceFallback", context);
}

JsValue builderGetAggregateErrors(JsValue self, JsValue input) {
  try {
    if (isErrorValue(input)) {
      JsValue prototype = JS.invoke(Object, "getPrototypeOf", input);
      for (int depth = 0; prototype.truthy() && depth < 100; depth = depth + 1) {
        JsValue descriptor = JS.invoke(Object, "getOwnPropertyDescriptor", prototype, "constructor");
        JsValue constructorValue = if (isNullish(descriptor)) { undef() } else { descriptor["value"] };
        if (JS.typeOf(constructorValue) == "function" && JS.strictEqual(constructorValue["name"], "AggregateError")) {
          JsValue errors = input["errors"];
          return if (isArr(errors)) { errors } else { undef() };
        }
        prototype = JS.invoke(Object, "getPrototypeOf", prototype);
      }
    }
  } catch {}
  return undef();
}

// Shared only by the traversal and its closures, never a public error/payload.
shape CoercingState {
  data number count;
  data number memberInspections;
  data bool hasAggregate;
  data JsValue seen;
  data JsValue wrappers;
  data JsValue skipped;
}

JsValue createCoercingContext(JsValue builder, JsValue mechanism, JsValue hint, CoercingState state, int depth, int wrapperDepth) {
  JsValue context = copyObj(hint);
  context["syntheticException"] = if (depth == 0) { hint["syntheticException"] } else { undef() };
  context["mechanism"] = if (depth == 0) { mechanism } else { JS.object() };
  func(JsValue, JsValue)->JsValue apply = (JsValue ignored, JsValue input) => {
    JsValue exception = coerceGraph(builder, input, mechanism, hint, state, depth, wrapperDepth + 1);
    if (!exception.truthy()) throw state.skipped;
    return exception;
  };
  func(JsValue, JsValue)->JsValue next = (JsValue ignored, JsValue input) => coerceGraph(builder, input, mechanism, hint, state, depth + 1, 0);
  context["apply"] = JS.method1(apply);
  context["next"] = JS.method1(next);
  return context;
}

JsValue coerceGraph(JsValue builder, JsValue input, JsValue mechanism, JsValue hint, CoercingState state, int depth, int wrapperDepth) {
  JsValue context = createCoercingContext(builder, mechanism, hint, state, depth, wrapperDepth);
  JsValue forward = context["apply"];
  func(JsValue, JsValue)->JsValue apply = (JsValue ignored, JsValue nextInput) => {
    JS.invoke(state.wrappers, "push", input);
    try { return forward(nextInput); }
    finally { JS.invoke(state.wrappers, "pop"); }
  };
  context["apply"] = JS.method1(apply);
  if (wrapperDepth > 4 || (wrapperDepth > 0 && !JS.strictEqual(JS.invoke(state.wrappers, "indexOf", input), -1))) {
    return JS.invoke(builder, "coerceFallback", context);
  }
  bool reference = (JS.typeOf(input) == "object" && !JS.strictEqual(input, null)) || JS.typeOf(input) == "function";
  if ((wrapperDepth == 0 && state.count >= 50) || (reference && JS.invoke(state.seen, "has", input).truthy())) return undef();
  if (reference) JS.invoke(state.seen, "add", input);
  if (wrapperDepth == 0) state.count = state.count + 1;
  JsValue errors = JS.invoke(builder, "getAggregateErrors", input);
  if (errors.truthy()) state.hasAggregate = true;
  JsValue exception = undef();
  try {
    exception = JS.invoke(builder, "applyCoercers", input, context);
    if (!exception.truthy()) throw state.skipped;
  } catch (JsValue error) {
    if (JS.strictEqual(error, state.skipped)) {
      if (wrapperDepth == 0) state.count = state.count - 1;
      return undef();
    }
    if (!state.hasAggregate) throw error;
    exception = JS.invoke(builder, "coerceFallback", context);
  }
  if (!errors.truthy() || state.count >= 50) return exception;
  JsValue length = undef();
  try { length = errors["length"]; } catch { return exception; }
  if (!JS.invoke(Number, "isInteger", length).truthy() || JS.lessThan(length, 0) || JS.greaterThan(length, 4294967295.0)) return exception;
  JsValue children = JS.array();
  for (int index = 0; state.count < 50 && state.memberInspections < 1000 && JS.lessThan(index, length); index = index + 1) {
    state.memberInspections = state.memberInspections + 1;
    JsValue child = undef();
    try { child = JS.invoke(context, "next", errors[index]); }
    catch {
      state.count = state.count + 1;
      child = JS.invoke(builder, "coerceFallback", createCoercingContext(builder, mechanism, hint, state, depth + 1, 0));
    }
    if (child.truthy()) JS.invoke(children, "push", child);
  }
  JsValue result = copyObj(exception);
  result["errors"] = children;
  return result;
}

JsValue builderBuildCoercingContext(JsValue self, JsValue mechanism, JsValue hint, JsValue depthValue) {
  int depth = if (isUndef(depthValue)) { 0 } else { JS.number(depthValue).toInt() };
  CoercingState state = CoercingState { count: 0, memberInspections: 0, hasAggregate: false, seen: JS.construct(Set), wrappers: JS.array(), skipped: JS.object() };
  JsValue context = createCoercingContext(self, mechanism, hint, state, depth, 0);
  JsValue result = copyObj(context);
  func(JsValue, JsValue)->JsValue apply = (JsValue ignored, JsValue input) => {
    JsValue exception = coerceGraph(self, input, mechanism, hint, state, depth, 0);
    return if (isNullish(exception)) { JS.invoke(self, "coerceFallback", context) } else { exception };
  };
  result["apply"] = JS.method1(apply);
  return result;
}

JsValue builderApplyChunkIds(JsValue self, JsValue frames, JsValue chunkIdMap) {
  func(JsValue)->JsValue apply = (JsValue frame) => {
    if (frame["filename"].truthy() && chunkIdMap.truthy()) {
      frame["chunk_id"] = chunkIdMap[frame["filename"]];
    }
    return frame;
  };
  return JS.invoke(frames, "map", apply);
}

JsValue builderParseStacktrace(JsValue self, JsValue error, JsValue context) {
  JsValue cause = undef();
  if (!isNullish(error["cause"])) cause = JS.invoke(self, "parseStacktrace", error["cause"], context);
  JsValue stack = undef();
  if (!isNullish(error["stack"]) && !JS.strictEqual(error["stack"], "")) {
    try {
      stack = self["stackParser"](error["stack"], if (error["synthetic"].truthy()) { context["skipFirstLines"] } else { 0 });
      stack = JS.invoke(self, "applyChunkIds", stack, context["chunkIdMap"]);
    } catch { stack = undef(); }
  }
  JsValue out = copyObj(error);
  out["cause"] = cause;
  out["stack"] = stack;
  out["errors"] = undef();
  if (!isNullish(error["errors"])) {
    func(JsValue)->JsValue child = (JsValue value) => JS.invoke(self, "parseStacktrace", value, context);
    out["errors"] = JS.invoke(error["errors"], "map", child);
  }
  return out;
}

void appendException(JsValue list, JsValue exception, JsValue mechanism, JsValue parentId, JsValue source) {
  int id = len(list);
  JsValue entryMechanism = JS.object();
  if (isUndef(parentId)) {
    JsValue kind = mechanism["type"];
    entryMechanism["type"] = if (JS.typeOf(kind) == "string" && len(kind) > 0) { kind } else { "generic" };
    if (JS.typeOf(mechanism["handled"]) == "boolean") entryMechanism["handled"] = mechanism["handled"];
    else if (isUndef(mechanism["handled"])) entryMechanism["handled"] = true;
    entryMechanism["synthetic"] = if (JS.typeOf(mechanism["synthetic"]) == "boolean") { mechanism["synthetic"] } else { exception["synthetic"] };
    entryMechanism["exception_id"] = id;
  } else {
    entryMechanism = object { type: "chained", source: source, synthetic: exception["synthetic"], exception_id: id, parent_id: parentId };
  }
  JsValue current = object { type: exception["type"], value: exception["value"], mechanism: entryMechanism };
  if (exception["stack"].truthy()) current["stacktrace"] = object { type: "raw", frames: exception["stack"] };
  JS.invoke(list, "push", current);
  if (exception["cause"].truthy()) appendException(list, exception["cause"], mechanism, id, "cause");
  if (!isNullish(exception["errors"])) {
    JsValue[] children = JS.assume(exception["errors"]);
    for (JsValue child of children) appendException(list, child, mechanism, id, "member");
  }
}

JsValue builderConvertList(JsValue self, JsValue exceptionWithStack, JsValue mechanism) {
  JsValue result = JS.array();
  appendException(result, exceptionWithStack, mechanism, undef(), undef());
  return result;
}

JsValue builderBuildParsingContext(JsValue self, JsValue hint) {
  JsValue out = object { "chunkIdMap": getFilenameToChunkIdMap(self["stackParser"]) };
  if (isNullish(hint["skipFirstLines"])) {
    out["skipFirstLines"] = 1;
  } else {
    out["skipFirstLines"] = hint["skipFirstLines"];
  }
  return out;
}

JsValue builderBuildFromUnknown(JsValue self, JsValue input, JsValue hintValue) {
  JsValue hint = hintValue;
  if (isUndef(hint)) {
    hint = JS.object();
  }
  JsValue providedMechanism = undef();
  if (hint.truthy()) {
    providedMechanism = hint["mechanism"];
  }
  JsValue mechanism = providedMechanism;
  if (!mechanism.truthy()) {
    mechanism = object { handled: true, type: "generic" };
  }
  JsValue coercingContext = JS.invoke(self, "buildCoercingContext", mechanism, hint, 0);
  JsValue exceptionWithCause = JS.invoke(coercingContext, "apply", input);
  JsValue parsingContext = JS.invoke(self, "buildParsingContext", hint);
  JsValue exceptionWithStack = JS.invoke(self, "parseStacktrace", exceptionWithCause, parsingContext);
  JsValue exceptionList = JS.invoke(self, "convertToExceptionList", exceptionWithStack, mechanism);
  JsValue out = object { "$exception_list": exceptionList, "$exception_level": "error" };
  return out;
}

async JsValue builderApplyModifiersAsync(JsValue self, JsValue frames) {
  JsValue newFrames = frames;
  int i = 0;
  while (i < len(self["modifiers"])) {
    JsValue modifier = self["modifiers"][i];
    JsValue result = modifier(newFrames);
    newFrames = await Task.resolve(result);
    i = i + 1;
  }
  return newFrames;
}

JsValue builderApplyModifiers(JsValue self, JsValue frames) {
  return builderApplyModifiersAsync(self, frames);
}

async JsValue builderModifyFramesAsync(JsValue self, JsValue exceptionList) {
  int i = 0;
  while (i < len(exceptionList)) {
    JsValue exception = exceptionList[i];
    if (
      exception["stacktrace"].truthy() &&
      exception["stacktrace"]["frames"].truthy() &&
      isArr(exception["stacktrace"]["frames"])
    ) {
      JsValue result = JS.invoke(self, "applyModifiers", exception["stacktrace"]["frames"]);
      exception["stacktrace"]["frames"] = await Task.resolve(result);
    }
    i = i + 1;
  }
  return exceptionList;
}

JsValue builderModifyFrames(JsValue self, JsValue exceptionList) {
  return builderModifyFramesAsync(self, exceptionList);
}

JsValue builderConstructor(JsValue self, JsValue coercers, JsValue stackParser, JsValue modifiers) {
self["coercers"] = coercers;
  self["stackParser"] = stackParser;
  self["modifiers"] = modifiers;
  return undef();
}

export class ErrorPropertiesBuilder {
  init(JsValue coercers, JsValue stackParser, JsValue modifiers = JS.array()) { builderConstructor(this, coercers, stackParser, modifiers); }
  JsValue buildFromUnknown(JsValue input, JsValue hint = JS.object()) { return builderBuildFromUnknown(this, input, hint); }
  JsValue buildCoercingContext(JsValue mechanism, JsValue hint, JsValue depth = 0) { return builderBuildCoercingContext(this, mechanism, hint, depth); }
  JsValue modifyFrames(JsValue a0) { return builderModifyFrames(this, a0); }
  JsValue coerceFallback(JsValue a0) { return fallbackException(this, a0); }
  JsValue parseStacktrace(JsValue a0, JsValue a1) { return builderParseStacktrace(this, a0, a1); }
  JsValue applyChunkIds(JsValue a0, JsValue a1) { return builderApplyChunkIds(this, a0, a1); }
  JsValue applyCoercers(JsValue a0, JsValue a1) { return builderApplyCoercers(this, a0, a1); }
  JsValue applyModifiers(JsValue a0) { return builderApplyModifiers(this, a0); }
  JsValue convertToExceptionList(JsValue a0, JsValue a1) { return builderConvertList(this, a0, a1); }
  JsValue buildParsingContext(JsValue a0) { return builderBuildParsingContext(this, a0); }
  JsValue getAggregateErrors(JsValue a0) { return builderGetAggregateErrors(this, a0); }
}
export constructor ErrorPropertiesBuilder;

export JsValue getInjectedReleaseId() {
  JsValue injected = globalThis["_posthogReleaseId"];
  if (JS.typeOf(injected) == "string" && len(injected) > 0) {
    return injected;
  }
  return undef();
}
