// browser/src/posthog-core.ts: the PostHog client. `PostHog` and every object it
// exposes stay real JavaScript classes, because pages and extension bundles reach
// them by name. Where upstream calls one of its own public methods through `this`,
// the port does too (a dynamic call), so a page that wraps `posthog.capture` still
// sees the SDK's own events. Internal helpers are module functions.

import extern { instanceOf } from "./host.js";
extern bool instanceOf(JsValue value, JsValue ctor);

import { Config } from "./config.lil";
import { assignableWindow, document, location, navigator, userAgent, win } from "./globals.lil";
import { createLogger, Logger, logger } from "./logger.lil";
import { uuidv7 } from "./uuidv7.lil";
import { localStore, sessionStore } from "./storage.lil";
import { PostHogPersistence } from "./persistence.lil";
import { SessionIdManager } from "./sessionid.lil";
import { SessionPropsManager } from "./session-props.lil";
import { PageViewManager } from "./page-view.lil";
import { ScrollManager } from "./scroll-manager.lil";
import { RateLimiter } from "./rate-limiter.lil";
import { ConsentManager, CONSENT_DENIED, CONSENT_GRANTED, consentOf } from "./consent.lil";
import { RequestRouter, regionOf } from "./request-router.lil";
import { RemoteConfigLoader } from "./remote-config.lil";
import { request, SUPPORTS_REQUEST } from "./request.lil";
import { RequestQueue } from "./request-queue.lil";
import { RetryQueue } from "./retry-queue.lil";
import { EventEmitter } from "./event-emitter.lil";
import { getEventProperties } from "./event-utils.lil";
import { getDeviceModel, isLikelyBot } from "./bot.lil";
import { getPersonPropertiesHash } from "./person-hash.lil";
import { setupSegmentIntegration } from "./segment.lil";
import { SentryIntegrationClass, sentryIntegration } from "./sentry.lil";
import { ExternalIntegrations } from "./external-integrations.lil";
import { BrowserClientAdapter } from "./browser-client.lil";
import {
  addEventListener,
  assign,
  copy,
  copyAndTruncateStrings,
  defineGetter,
  each,
  extend,
  isArray,
  isBoolean,
  isDistinctIdStringLike,
  isEmptyObject,
  isEmptyString,
  isFunction,
  isKnownUnsafeEditableEvent,
  isKnownUnsafeEditableEventProperty,
  isNumber,
  isObject,
  isString,
  isCrossDomainCookie,
  keysOf,
  migrateConfigField,
  minimizeFlagCalledEventProperties
} from "./utils.lil";

