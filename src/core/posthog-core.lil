      "transport", getProp(options, "transport")
    );
    if (this.config["request_batching"].truthy() && (!options.truthy() || batchKey.truthy()) && !getProp(options, "send_instantly").truthy()) {
      queue.enqueue(requestOptions);
    } else {
      this._send_retriable_request(requestOptions);
    }
    return data;
  }

  JsValue _addCaptureHook(JsValue callback) {
    JsValue client = this;
    return JS.invoke(client, "on", "eventCaptured", (JsValue data) => JS.call(callback, JS.undefined(), data["event"], data));
  }

  BrowserClientAdapter _getBrowserClientAdapter() {
    BrowserClientAdapter? existing = this._browserClientAdapter;
    if (existing != null) {
      return existing;
    }
    BrowserClientAdapter adapter = new BrowserClientAdapter(this);
    this._browserClientAdapter = adapter;
    return adapter;
  }

  JsValue _registerExtensionEventProperties(JsValue producer) {
    this._extensionEventPropertyProducers.push(producer);
    bool active = true;
    return () => {
      if (!active) {
        return;
      }
      active = false;
      int index = this._extensionEventPropertyProducers.indexOf(producer);
      if (index != -1) {
        this._extensionEventPropertyProducers.splice(index, 1);
      }
    };
  }

  JsValue calculateEventProperties(JsValue eventName, JsValue eventProperties, JsValue timestampArg = JS.undefined(), JsValue uuid = JS.undefined(), JsValue readOnly = JS.undefined()) {
    JsValue client = this;
    JsValue timestamp = JS.or(timestampArg, JS.construct(Date));
    PostHogPersistence? persistenceValue = this.persistence;
    PostHogPersistence? sessionValue = this.sessionPersistence;
    if (persistenceValue == null || sessionValue == null) {
      return eventProperties;
    }
    PostHogPersistence persistence = persistenceValue;
    PostHogPersistence sessionPersistence = sessionValue;
    // Cookies raise no cross-origin storage events: reconcile before reading.
    persistence.syncCookieProperties();
    processCookieIdentityChange(this, true);
    JsValue startTimestamp = if (readOnly.truthy()) { JS.undefined() } else { persistence.remove_event_timer(JS.string(eventName)) };
    JsValue properties = assign(JS.object(), eventProperties);
    properties["token"] = this.config["token"];
    properties["$config_defaults"] = this.config["defaults"];
    if (inCookielessMode(this)) {
      properties["$cookieless_mode"] = true;
    }
    if (JS.strictEqual(eventName, "$snapshot")) {
      JsValue persistenceProps = assign(assign(JS.object(), persistence.properties()), sessionPersistence.properties());
      properties["distinct_id"] = persistenceProps["distinct_id"];
      JsValue distinctId = properties["distinct_id"];
      if (!(isString(distinctId) || isNumber(distinctId)) || isEmptyString(distinctId)) {
        logger.error(JS.array("Invalid distinct_id for replay event. This indicates a bug in your implementation"));
      }
      return properties;
    }
    JsValue infoProperties = getEventProperties(this.config["mask_personal_data_properties"], this.config["custom_personal_data_properties"], this.config["detect_google_search_app"], this.config["disable_capture_url_hashes"].truthy());
    SessionIdManager? sessionManager = this.sessionManager;
    if (sessionManager != null) {
      JsValue ids = sessionManager.checkAndGetSessionAndWindowId(readOnly.truthy(), JS.invoke(timestamp, "getTime"), true);
      properties["$session_id"] = ids["sessionId"];
      properties["$window_id"] = ids["windowId"];
    }
    SessionPropsManager? sessionProps = this.sessionPropsManager;
    if (sessionProps != null) {
      extend(properties, sessionProps.getSessionProps());
    }
    try {
      if (this.sessionRecording.truthy()) {
        extend(properties, this.sessionRecording["sdkDebugProperties"]);
      }
      RetryQueue? retries = this._retryQueue;
      properties["$sdk_debug_retry_queue_size"] = if (retries != null) { retries.length() } else { JS.undefined() };
    } catch (JsValue e) {
      properties["$sdk_debug_error_capturing_properties"] = JS.call(String, JS.undefined(), e);
    }
    if (regionOf(this.requestRouter) == "custom") {
      properties["$lib_custom_api_host"] = this.config["api_host"];
    }
    JsValue pageviewProperties = JS.undefined();
    if (JS.strictEqual(eventName, "$pageview") && !readOnly.truthy()) {
      pageviewProperties = this.pageViewManager.doPageView(timestamp, uuid);
    } else if (JS.strictEqual(eventName, "$pageleave") && !readOnly.truthy()) {
      pageviewProperties = this.pageViewManager.doPageLeave(timestamp);
    } else {
      pageviewProperties = this.pageViewManager.doEvent();
    }
    properties = extend(properties, pageviewProperties);
    if (JS.strictEqual(eventName, "$pageview") && document.truthy()) {
      properties["title"] = document["title"];
    }
    if (!JS.isUndefined(startTimestamp)) {
      number durationMs = JS.number(JS.invoke(timestamp, "getTime")) - JS.number(startTimestamp);
      properties["$duration"] = JS.call(parseFloat, JS.undefined(), JS.invoke(durationMs / 1000.0, "toFixed", 3));
    }
    if (userAgent.truthy() && this.config["opt_out_useragent_filter"].truthy()) {
      properties["$browser_type"] = if (JS.invoke(client, "_is_bot").truthy()) { "bot" } else { "browser" };
    }
    // A $referrer or $referring_domain registered by the page wins over the session's
    // document.referrer, key by key.
    JsValue persistenceProperties = persistence.properties();
    JsValue sessionPersistenceProperties = sessionPersistence.properties();
    for (string referrerKey of ["$referrer", "$referring_domain"]) {
      if (JS.in(referrerKey, persistenceProperties)) {
        JS.delete(sessionPersistenceProperties, referrerKey);
      }
    }
    JsValue dynamicProperties = JS.object();
    if (this._extensionEventPropertyProducers.length > 0) {
      for (JsValue producer of this._extensionEventPropertyProducers.slice()) {
        try {
          extend(dynamicProperties, JS.call(producer, JS.undefined()));
        } catch (JsValue error) {
          logger.error(JS.array("Failed to produce browser extension event properties", error));
        }
      }
    }
    properties = extend(extend(extend(extend(JS.object(), infoProperties), persistenceProperties), sessionPersistenceProperties), assign(assign(JS.object(), dynamicProperties), properties));
    properties["$is_identified"] = JS.invoke(client, "_isIdentified");
    JsValue denylist = this.config["property_denylist"];
    if (isArray(denylist)) {
      JsValue finalProperties = properties;
      each(denylist, (JsValue denylisted, JsValue index) => {
        JS.delete(finalProperties, denylisted);
      });
    } else {
      logger.error(JS.array(JS.add(JS.add(JS.add(DENYLIST_INVALID, denylist), " or property_blacklist config: "), this.config["property_blacklist"])));
    }
    JsValue sanitize = this.config["sanitize_properties"];
    if (sanitize.truthy()) {
      logger.error(JS.array(SANITIZE_DEPRECATED));
      properties = JS.call(sanitize, JS.undefined(), properties, eventName);
    }
    // Last, so nothing can override it.
    bool processPerson = hasPersonProcessing(this);
    properties["$process_person_profile"] = processPerson;
    if (processPerson && !readOnly.truthy()) {
      requirePersonProcessing(this, "_calculate_event_properties");
    }
    return properties;
  }

  JsValue _calculate_set_once_properties(JsValue dataSetOnce = JS.undefined(), bool markAsSent = true, bool forceIncludeInitialProps = false) {
    PostHogPersistence? persistenceValue = this.persistence;
    if (persistenceValue == null || !hasPersonProcessing(this)) {
      return dataSetOnce;
    }
    PostHogPersistence persistence = persistenceValue;
    if (this._personProcessingSetOncePropertiesSent && !forceIncludeInitialProps) {
      return dataSetOnce;
    }
    JsValue initialProps = persistence.get_initial_props();
    SessionPropsManager? sessionProps = this.sessionPropsManager;
    JsValue sessionSetOnce = if (sessionProps != null) { sessionProps.getSetOnceProps() } else { JS.undefined() };
    JsValue setOnceProperties = extend(extend(extend(JS.object(), initialProps), JS.or(sessionSetOnce, JS.object())), JS.or(dataSetOnce, JS.object()));
    JsValue sanitize = this.config["sanitize_properties"];
    if (sanitize.truthy()) {
      logger.error(JS.array(SANITIZE_DEPRECATED));
      setOnceProperties = JS.call(sanitize, JS.undefined(), setOnceProperties, "$set_once");
    }
    if (markAsSent) {
      this._personProcessingSetOncePropertiesSent = true;
    }
    if (isEmptyObject(setOnceProperties)) {
      return JS.undefined();
    }
    return setOnceProperties;
  }

  void register(JsValue properties, JsValue days = JS.undefined()) {
    PostHogPersistence? persistence = this.persistence;
    if (persistence != null) {
      persistence.register(properties, days);
    }
  }

  void register_once(JsValue properties, JsValue defaultValue = JS.undefined(), JsValue days = JS.undefined()) {
    PostHogPersistence? persistence = this.persistence;
    if (persistence != null) {
      persistence.register_once(properties, defaultValue, days);
    }
  }

  void register_for_session(JsValue properties) {
    PostHogPersistence? persistence = this.persistence;
    if (persistence != null) {
      persistence.syncCookieProperties();
    }
    processCookieIdentityChange(this, true);
    PostHogPersistence? sessionPersistence = this.sessionPersistence;
    if (sessionPersistence != null) {
      sessionPersistence.register(properties, JS.undefined());
    }
    for (string key of keysOf(properties)) {
      addRegisteredKey(this, key);
    }
    persistSessionRegisteredPropKeys(this);
  }

  void unregister(JsValue property) {
    PostHogPersistence? persistence = this.persistence;
    if (persistence != null) {
      persistence.unregister(property);
    }
  }

  void unregister_for_session(JsValue property) {
    PostHogPersistence? sessionPersistence = this.sessionPersistence;
    if (sessionPersistence != null) {
      sessionPersistence.unregister(property);
    }
    int index = this._sessionRegisteredPropKeys.indexOf(JS.string(property));
    if (index != -1) {
      this._sessionRegisteredPropKeys.splice(index, 1);
    }
    persistSessionRegisteredPropKeys(this);
  }

  void _register_single(JsValue prop, JsValue value) {
    JsValue client = this;
    JsValue properties = JS.object();
    properties[JS.string(prop)] = value;
    JS.invoke(client, "register", properties);
  }

  void _clearSessionRegisteredProps() {
    for (string property of this._sessionRegisteredPropKeys.slice()) {
      PostHogPersistence? sessionPersistence = this.sessionPersistence;
      if (sessionPersistence != null) {
        sessionPersistence.unregister(property);
      }
    }
    this._sessionRegisteredPropKeys = [];
    persistSessionRegisteredPropKeys(this);
  }

  // ---- feature flags and surveys live in extensions ----

  JsValue getFeatureFlag(JsValue key, JsValue options = JS.undefined()) {
    return if (JS.isNullish(this.featureFlags)) { JS.undefined() } else { JS.invoke(this.featureFlags, "getFeatureFlag", key, options) };
  }

  JsValue getFeatureFlagPayload(JsValue key) {
    return if (JS.isNullish(this.featureFlags)) { JS.undefined() } else { JS.invoke(this.featureFlags, "getFeatureFlagPayload", key) };
  }

  JsValue getFeatureFlagResult(JsValue key, JsValue options = JS.undefined()) {
    return if (JS.isNullish(this.featureFlags)) { JS.undefined() } else { JS.invoke(this.featureFlags, "getFeatureFlagResult", key, options) };
  }

  JsValue getAllFeatureFlags() {
    JsValue result = if (JS.isNullish(this.featureFlags)) { JS.undefined() } else { JS.invoke(this.featureFlags, "getAllFeatureFlags") };
    return if (JS.isNullish(result)) { JS.array() } else { result };
  }

  JsValue isFeatureEnabled(JsValue key, JsValue options = JS.undefined()) {
    JsValue result = if (JS.isNullish(this.featureFlags)) { JS.undefined() } else { JS.invoke(this.featureFlags, "isFeatureEnabled", key, options) };
    return if (JS.isNullish(result)) { getProp(options, "defaultValue") } else { result };
  }

  void reloadFeatureFlags() {
    if (!JS.isNullish(this.featureFlags)) {
      JS.invoke(this.featureFlags, "reloadFeatureFlags");
    }
  }

  void updateFlags(JsValue flags, JsValue payloads = JS.undefined(), JsValue options = JS.undefined()) {
    if (!JS.isNullish(this.featureFlags)) {
      JS.invoke(this.featureFlags, "updateFlags", flags, payloads, options);
    }
  }

  void updateEarlyAccessFeatureEnrollment(JsValue key, JsValue isEnrolled, JsValue stage = JS.undefined()) {
    if (!JS.isNullish(this.featureFlags)) {
      JS.invoke(this.featureFlags, "updateEarlyAccessFeatureEnrollment", key, isEnrolled, stage);
    }
  }

  JsValue getEarlyAccessFeatures(JsValue callback, JsValue forceReload = false, JsValue stages = JS.undefined()) {
    return if (JS.isNullish(this.featureFlags)) { JS.undefined() } else { JS.invoke(this.featureFlags, "getEarlyAccessFeatures", callback, forceReload, stages) };
  }

  JsValue on(JsValue event, JsValue cb) {
    return this._internalEventEmitter.on(JS.string(event), cb);
  }

  JsValue onFeatureFlags(JsValue callback) {
    if (!this.featureFlags.truthy()) {
      JS.call(callback, JS.undefined(), JS.array(), JS.object(), JS.object("errorsLoading", true));
      return () => {};
    }
    return JS.invoke(this.featureFlags, "onFeatureFlags", callback);
  }

  JsValue onSurveysLoaded(JsValue callback) {
    if (!this.surveys.truthy()) {
      JS.call(callback, JS.undefined(), JS.array(), JS.object("isLoaded", false, "error", SURVEYS_NOT_AVAILABLE));
      return () => {};
    }
    return JS.invoke(this.surveys, "onSurveysLoaded", callback);
  }

  JsValue onSessionId(JsValue callback) {
    SessionIdManager? sessionManager = this.sessionManager;
    JsValue unsubscribe = if (sessionManager != null) { sessionManager.onSessionId(callback) } else { JS.undefined() };
    if (JS.isNullish(unsubscribe)) {
      return () => {};
    }
    return unsubscribe;
  }

  void getSurveys(JsValue callback, JsValue forceReload = false) {
    if (this.surveys.truthy()) {
      JS.invoke(this.surveys, "getSurveys", callback, forceReload);
    } else {
      JS.call(callback, JS.undefined(), JS.array(), JS.object("isLoaded", false, "error", SURVEYS_NOT_AVAILABLE));
    }
  }

  void getActiveMatchingSurveys(JsValue callback, JsValue forceReload = false) {
    if (this.surveys.truthy()) {
      JS.invoke(this.surveys, "getActiveMatchingSurveys", callback, forceReload);
    } else {
      JS.call(callback, JS.undefined(), JS.array(), JS.object("isLoaded", false, "error", SURVEYS_NOT_AVAILABLE));
    }
  }

  void renderSurvey(JsValue surveyId, JsValue selector) {
    if (!JS.isNullish(this.surveys)) {
      JS.invoke(this.surveys, "renderSurvey", surveyId, selector);
    }
  }

  void displaySurvey(JsValue surveyId, JsValue options = JS.undefined()) {
    JsValue displayOptions = if (JS.isUndefined(options)) { DEFAULT_DISPLAY_SURVEY_OPTIONS } else { options };
    if (!JS.isNullish(this.surveys)) {
      JS.invoke(this.surveys, "displaySurvey", surveyId, displayOptions);
    }
  }

  void cancelPendingSurvey(JsValue surveyId) {
    if (!JS.isNullish(this.surveys)) {
      JS.invoke(this.surveys, "cancelPendingSurvey", surveyId);
    }
  }

  JsValue canRenderSurvey(JsValue surveyId) {
    JsValue result = if (JS.isNullish(this.surveys)) { JS.undefined() } else { JS.invoke(this.surveys, "canRenderSurvey", surveyId) };
    return if (JS.isNullish(result)) { JS.object("visible", false, "disabledReason", SURVEYS_NOT_AVAILABLE) } else { result };
  }

  JsValue canRenderSurveyAsync(JsValue surveyId, JsValue forceReload = false) {
    JsValue result = if (JS.isNullish(this.surveys)) { JS.undefined() } else { JS.invoke(this.surveys, "canRenderSurveyAsync", surveyId, forceReload) };
    return if (JS.isNullish(result)) { JS.invoke(Promise, "resolve", JS.object("visible", false, "disabledReason", SURVEYS_NOT_AVAILABLE)) } else { result };
  }

  // ---- identity ----

  // Upstream wraps identify at load time (safewrapClass): a failure is reported, not thrown.
  void identify(JsValue newDistinctId = JS.undefined(), JsValue userPropertiesToSet = JS.undefined(), JsValue userPropertiesToSetOnce = JS.undefined()) {
    try {
      identifyUser(this, newDistinctId, userPropertiesToSet, userPropertiesToSetOnce);
    } catch (JsValue e) {
      logger.critical(JS.array("Implementation error. Please turn on debug mode and open a ticket on https://app.posthog.com/home#panel=support%3Asupport%3A."));
      logger.critical(JS.array(e));
    }
  }

  void setPersonProperties(JsValue userPropertiesToSet = JS.undefined(), JsValue userPropertiesToSetOnce = JS.undefined()) {
    JsValue client = this;
    if (!userPropertiesToSet.truthy() && !userPropertiesToSetOnce.truthy()) {
      return;
    }
    if (!requirePersonProcessing(this, "posthog.setPersonProperties")) {
      return;
    }
    JsValue hash = getPersonPropertiesHash(JS.invoke(client, "get_distinct_id"), userPropertiesToSet, userPropertiesToSetOnce);
    if (JS.strictEqual(this._cachedPersonProperties, hash)) {
      logger.info(JS.array("A duplicate setPersonProperties call was made with the same properties. It has been ignored."));
      return;
    }
    JS.invoke(client, "setPersonPropertiesForFlags", JS.object("$set", JS.or(userPropertiesToSet, JS.object()), "$set_once", JS.or(userPropertiesToSetOnce, JS.object())), true);
    JS.invoke(client, "capture", "$set", JS.object("$set", JS.or(userPropertiesToSet, JS.object()), "$set_once", JS.or(userPropertiesToSetOnce, JS.object())));
    this._cachedPersonProperties = hash;
  }

  void unsetPersonProperties(JsValue propertyNames) {
    JsValue client = this;
    JsValue names = JS.invoke(if (isArray(propertyNames)) { propertyNames } else { JS.array(propertyNames) }, "filter", (JsValue name) => isString(name) && JS.number(name["length"]) > 0.0);
    if (JS.number(names["length"]) == 0.0) {
      return;
    }
    if (!requirePersonProcessing(this, "posthog.unsetPersonProperties")) {
      return;
    }
    if (!JS.isNullish(this.featureFlags)) {
      JS.invoke(this.featureFlags, "unsetPersonPropertiesForFlags", names, true);
    }
    JS.invoke(client, "capture", "$set", JS.object("$unset", names));
    this._cachedPersonProperties = null;
  }

  void group(JsValue groupType, JsValue groupKey, JsValue groupPropertiesToSet = JS.undefined()) {
    JsValue client = this;
    if (!groupType.truthy() || !groupKey.truthy()) {
      logger.error(JS.array("posthog.group requires a group type and group key"));
      return;
    }
    PostHogPersistence? persistence = this.persistence;
    if (persistence != null) {
      persistence.syncCookieProperties();
    }
    processCookieIdentityChange(this, true);
    JsValue existingGroups = JS.invoke(client, "getGroups");
    bool isNewGroup = JS.strictNotEqual(existingGroups[JS.string(groupType)], groupKey);
    if (isNewGroup) {
      JS.invoke(client, "resetGroupPropertiesForFlags", groupType);
    }
    JsValue groups = assign(JS.object(), existingGroups);
    groups[JS.string(groupType)] = groupKey;
    JS.invoke(client, "register", JS.object("$groups", groups));
    if (isNewGroup || groupPropertiesToSet.truthy()) {
      JsValue groupIdentify = JS.object("$group_type", groupType, "$group_key", groupKey);
      if (groupPropertiesToSet.truthy()) {
        groupIdentify["$group_set"] = groupPropertiesToSet;
      }
      JS.invoke(client, "capture", "$groupidentify", groupIdentify);
    }
    if (groupPropertiesToSet.truthy()) {
      JsValue forFlags = JS.object();
      forFlags[JS.string(groupType)] = groupPropertiesToSet;
      JS.invoke(client, "setGroupPropertiesForFlags", forFlags);
    }
    if (isNewGroup && !groupPropertiesToSet.truthy()) {
      JS.invoke(client, "reloadFeatureFlags");
    }
  }

  void resetGroups() {
    JsValue client = this;
    JS.invoke(client, "register", JS.object("$groups", JS.object()));
    JS.invoke(client, "resetGroupPropertiesForFlags");
    JS.invoke(client, "reloadFeatureFlags");
  }

  void setPersonPropertiesForFlags(JsValue properties, JsValue reloadFeatureFlags = true) {
    if (!JS.isNullish(this.featureFlags)) {
      JS.invoke(this.featureFlags, "setPersonPropertiesForFlags", properties, reloadFeatureFlags);
    }
  }

  void resetPersonPropertiesForFlags(JsValue reloadFeatureFlags = true) {
    if (!JS.isNullish(this.featureFlags)) {
      JS.invoke(this.featureFlags, "resetPersonPropertiesForFlags", reloadFeatureFlags);
    }
  }

  void setGroupPropertiesForFlags(JsValue properties, JsValue reloadFeatureFlags = true) {
    if (!requirePersonProcessing(this, "posthog.setGroupPropertiesForFlags")) {
      return;
    }
    if (!JS.isNullish(this.featureFlags)) {
      JS.invoke(this.featureFlags, "setGroupPropertiesForFlags", properties, reloadFeatureFlags);
    }
  }

  void resetGroupPropertiesForFlags(JsValue groupType = JS.undefined()) {
    if (!JS.isNullish(this.featureFlags)) {
      JS.invoke(this.featureFlags, "resetGroupPropertiesForFlags", groupType);
    }
  }

  void reset(JsValue options = JS.undefined()) {
    JsValue resetDeviceId = if (isBoolean(options)) { options } else { getProp(options, "resetDeviceID") };
    JsValue bootstrap = if (isBoolean(options)) { JS.undefined() } else { getProp(options, "bootstrap") };
    resetClient(this, resetDeviceId, false, bootstrap);
  }

  JsValue shutdown(JsValue shutdownTimeoutMs = JS.undefined()) {
    return shutdownClient(this);
  }

  void setIdentity(JsValue distinctId, JsValue hash) {
    JsValue client = this;
    this.config["identity_distinct_id"] = distinctId;
    this.config["identity_hash"] = hash;
    JS.invoke(client, "alias", distinctId);
    if (!JS.isNullish(this.conversations)) {
      JS.invoke(this.conversations, "_onIdentityChanged");
    }
  }

  void clearIdentity() {
    JS.delete(this.config, "identity_distinct_id");
    JS.delete(this.config, "identity_hash");
    if (!JS.isNullish(this.conversations)) {
      JS.invoke(this.conversations, "_onIdentityCleared");
    }
  }

  JsValue get_distinct_id() {
    JsValue client = this;
    return JS.invoke(client, "get_property", "distinct_id");
  }

  JsValue getGroups() {
    JsValue client = this;
    return JS.or(JS.invoke(client, "get_property", "$groups"), JS.object());
  }

  JsValue get_session_id() {
    SessionIdManager? sessionManager = this.sessionManager;
    JsValue sessionId = if (sessionManager != null) { sessionManager.checkAndGetSessionAndWindowId(true, null, false)["sessionId"] } else { JS.undefined() };
    return if (JS.isNullish(sessionId)) { "" } else { sessionId };
  }

  JsValue get_session_replay_url(JsValue options = JS.undefined()) {
    SessionIdManager? sessionManager = this.sessionManager;
    if (sessionManager == null) {
      return "";
    }
    JsValue current = sessionManager.checkAndGetSessionAndWindowId(true, null, false);
    JsValue sessionStartTimestamp = current["sessionStartTimestamp"];
    JsValue url = this.requestRouter.endpointFor("ui", JS.string(JS.add(JS.add(JS.add("/project/", this.config["token"]), "/replay/"), current["sessionId"])));
    if (getProp(options, "withTimestamp").truthy() && sessionStartTimestamp.truthy()) {
      JsValue lookBack = options["timestampLookBack"];
      number LOOK_BACK = if (JS.isNullish(lookBack)) { 10.0 } else { JS.number(lookBack) };
      JsValue recordingStartTime = JS.invoke(Math, "max", JS.number(JS.invoke(Math, "floor", (JS.number(JS.invoke(JS.construct(Date), "getTime")) - JS.number(sessionStartTimestamp)) / 1000.0)) - LOOK_BACK, 0);
      url = JS.add(JS.add(url, "?t="), recordingStartTime);
    }
    return url;
  }

  JsValue alias(JsValue alias, JsValue original = JS.undefined()) {
    JsValue client = this;
    if (JS.strictEqual(alias, JS.invoke(client, "get_property", "$people_distinct_id"))) {
      logger.critical(JS.array("Attempting to create alias for existing People user - aborting."));
      return -2;
    }
    if (!requirePersonProcessing(this, "posthog.alias")) {
      return JS.undefined();
    }
    JsValue originalId = if (JS.isUndefined(original)) { JS.invoke(client, "get_distinct_id") } else { original };
    if (JS.strictNotEqual(alias, originalId)) {
      this._register_single("__alias", alias);
      return JS.invoke(client, "capture", "$create_alias", JS.object("alias", alias, "distinct_id", originalId));
    }
    logger.warn(JS.array("alias matches current distinct_id - skipping api call."));
    JS.invoke(client, "identify", alias);
    return -1;
  }

  void set_config(JsValue config) {
    JsValue oldConfig = assign(JS.object(), this.config);
    if (!isObject(config)) {
      return;
    }
    extend(this.config, configRenames(config));
    bool persistenceDisabled = isPersistenceDisabled(this);
    PostHogPersistence? persistence = this.persistence;
    if (persistence != null) {
      persistence.update_config(this.config, oldConfig, persistenceDisabled);
    }
    JsValue persistenceMode = this.config["persistence"];
    if (JS.strictEqual(persistenceMode, "sessionStorage") || JS.strictEqual(persistenceMode, "memory")) {
      this.sessionPersistence = this.persistence;
    } else {
      this.sessionPersistence = new PostHogPersistence(assign(copy(this.config), JS.object("persistence", "sessionStorage")), persistenceDisabled, false);
    }
    JsValue debugFromLocalStorage = checkLocalStorageForDebug(this.config["debug"]);
    if (isBoolean(debugFromLocalStorage)) {
      this.config["debug"] = debugFromLocalStorage;
    }
    if (isBoolean(this.config["debug"])) {
      if (this.config["debug"].truthy()) {
        Config.debug = true;
        if (localStore.isSupported()) {
          localStore.set("ph_debug", true, JS.undefined(), JS.undefined(), JS.undefined());
        }
        logger.info(JS.array("set_config", JS.object("config", config, "oldConfig", oldConfig, "newConfig", assign(JS.object(), this.config))));
      } else {
        Config.debug = false;
        if (localStore.isSupported()) {
          localStore.remove("ph_debug", JS.undefined());
        }
      }
    }
    JsValue flags = this.featureFlags;
    if (!JS.isNullish(flags) && !JS.isNullish(flags["updateConfig"])) {
      JsValue client = this;
      JS.invoke(flags, "updateConfig", this.config, JS.invoke(client, "_shouldDisableFlags"));
    }
    callOptional(this.exceptionObserver, "onConfigChange");
    callOptional(this.exceptions, "onConfigChange");
    callOptional(this.sessionRecording, "startIfEnabledOrStop");
    callOptional(this.tracingHeaders, "startIfEnabledOrStop");
    callOptional(this.autocapture, "startIfEnabled");
    callOptional(this.heatmaps, "startIfEnabled");
    callOptional(this.exceptionObserver, "startIfEnabledOrStop");
    callOptional(this.deadClicksAutocapture, "startIfEnabledOrStop");
    callOptional(this.surveys, "loadIfEnabled");
    syncOptOutWithPersistence(this);
    this.externalIntegrations.startIfEnabledOrStop();
  }

  void _overrideSDKInfo(JsValue sdkName, JsValue sdkVersion) {
    Config.libName = JS.assume(sdkName);
    Config.libVersion = JS.assume(sdkVersion);
  }

  void startSessionRecording(JsValue override = JS.undefined()) {
    JsValue client = this;
    bool overrideAll = JS.strictEqual(override, true);
    bool sampling = overrideAll || getProp(override, "sampling").truthy();
    bool linkedFlag = overrideAll || getProp(override, "linked_flag").truthy();
    bool urlTrigger = overrideAll || getProp(override, "url_trigger").truthy();
    bool eventTrigger = overrideAll || getProp(override, "event_trigger").truthy();
    if (sampling || linkedFlag || urlTrigger || eventTrigger) {
      SessionIdManager? sessionManager = this.sessionManager;
      if (sessionManager != null) {
        sessionManager.checkAndGetSessionAndWindowId(false, null, false);
      }
      if (sampling) {
        callOptional(this.sessionRecording, "overrideSampling");
      }
      if (linkedFlag) {
        callOptional(this.sessionRecording, "overrideLinkedFlag");
      }
      if (urlTrigger && !JS.isNullish(this.sessionRecording)) {
        JS.invoke(this.sessionRecording, "overrideTrigger", "url");
      }
      if (eventTrigger && !JS.isNullish(this.sessionRecording)) {
        JS.invoke(this.sessionRecording, "overrideTrigger", "event");
      }
    }
    JS.invoke(client, "set_config", JS.object("disable_session_recording", false));
  }

  void stopSessionRecording() {
    JsValue client = this;
    JS.invoke(client, "set_config", JS.object("disable_session_recording", true));
  }

  bool sessionRecordingStarted() {
    return !JS.isNullish(this.sessionRecording) && this.sessionRecording["started"].truthy();
  }

  JsValue captureException(JsValue error, JsValue additionalProperties = JS.undefined()) {
    JsValue exceptions = this.exceptions;
    if (!exceptions.truthy()) {
      return JS.undefined();
    }
    JsValue syntheticException = JS.construct(Error, "PostHog syntheticException");
    JsValue errorToProperties = JS.invoke(exceptions, "buildProperties", error, JS.object("handled", true, "syntheticException", syntheticException));
    return JS.invoke(exceptions, "sendExceptionEvent", assign(assign(JS.object(), errorToProperties), additionalProperties));
  }

  void addExceptionStep(JsValue message, JsValue properties = JS.undefined()) {
    if (!JS.isNullish(this.exceptions)) {
      JS.invoke(this.exceptions, "addExceptionStep", message, properties);
    }
  }

  void captureLog(JsValue options) {
    if (!JS.isNullish(this.logs)) {
      JS.invoke(this.logs, "captureLog", options);
    }
  }

  void startExceptionAutocapture(JsValue config = JS.undefined()) {
    JsValue client = this;
    JS.invoke(client, "set_config", JS.object("capture_exceptions", if (JS.isNullish(config)) { true } else { config }));
  }

  void stopExceptionAutocapture() {
    JsValue client = this;
    JS.invoke(client, "set_config", JS.object("capture_exceptions", false));
  }

  JsValue loadToolbar(JsValue params) {
    JsValue result = if (JS.isNullish(this.toolbar)) { JS.undefined() } else { JS.invoke(this.toolbar, "loadToolbar", params) };
    return if (JS.isNullish(result)) { false } else { result };
  }

  JsValue get_property(JsValue propertyName) {
    PostHogPersistence? persistence = this.persistence;
    return if (persistence == null) { JS.undefined() } else { persistence.props[JS.string(propertyName)] };
  }

  JsValue getSessionProperty(JsValue propertyName) {
    PostHogPersistence? sessionPersistence = this.sessionPersistence;
    return if (sessionPersistence == null) { JS.undefined() } else { sessionPersistence.props[JS.string(propertyName)] };
  }

  string toString() {
    JsValue configured = this.config["name"];
    JsValue name = if (JS.isNullish(configured)) { PRIMARY_INSTANCE_NAME } else { configured };
    if (JS.strictNotEqual(name, PRIMARY_INSTANCE_NAME)) {
      return JS.string(JS.add(PRIMARY_INSTANCE_NAME + ".", name));
    }
    return JS.string(name);
  }

  bool _isIdentified() {
    PostHogPersistence? persistence = this.persistence;
    PostHogPersistence? sessionPersistence = this.sessionPersistence;
    return (persistence != null && JS.strictEqual(persistence.get_property("$user_state"), "identified")) || (sessionPersistence != null && JS.strictEqual(sessionPersistence.get_property("$user_state"), "identified"));
  }

  void createPersonProfile() {
    JsValue client = this;
    if (hasPersonProcessing(this)) {
      return;
    }
    if (!requirePersonProcessing(this, "posthog.createPersonProfile")) {
      return;
    }
    JS.invoke(client, "setPersonProperties", JS.object(), JS.object());
  }

  void setInternalOrTestUser() {
    JsValue client = this;
    if (!requirePersonProcessing(this, "posthog.setInternalOrTestUser")) {
      return;
    }
    JS.invoke(client, "setPersonProperties", JS.object("$internal_or_test_user", true));
  }

  void opt_in_capturing(JsValue options = JS.undefined()) {
    JsValue client = this;
    if (JS.strictEqual(this.config["cookieless_mode"], "always")) {
      logger.warn(JS.array(CONSENT_COOKIELESS_WARN));
      return;
    }
    if (inCookielessMode(this)) {
      // Leaving cookieless mode: start a real identity and session.
      resetClient(this, true, true, JS.undefined());
      SessionIdManager? oldSessionManager = this.sessionManager;
      if (oldSessionManager != null) {
        oldSessionManager.destroy();
      }
      this.pageViewManager.destroy();
      SessionIdManager sessionManager = new SessionIdManager(this);
      this.sessionManager = sessionManager;
      this.pageViewManager = new PageViewManager(this);
      PostHogPersistence? persistence = this.persistence;
      if (persistence != null) {
        this.sessionPropsManager = new SessionPropsManager(this, sessionManager, persistence);
      }
      JsValue SessionRecordingClass = extensionClass(this, "sessionRecording");
      if (SessionRecordingClass.truthy()) {
        this.sessionRecording = replaceExtension(this, this.sessionRecording, JS.construct(SessionRecordingClass, client));
        if (this._lastRemoteConfig.truthy()) {
          JsValue recording = this.sessionRecording;
          if (!JS.isNullish(recording) && !JS.isNullish(recording["onRemoteConfig"])) {
            JS.invoke(recording, "onRemoteConfig", this._lastRemoteConfig);
          }
        }
      }
    }
    this.consent.optInOut(true);
    syncOptOutWithPersistence(this);
    this._start_queue_if_opted_in();
    callOptional(this.sessionRecording, "startIfEnabledOrStop");
    if (JS.strictEqual(this.config["cookieless_mode"], "on_reject")) {
      callOptional(this.surveys, "loadIfEnabled");
    }
    JsValue captureEventName = getProp(options, "captureEventName");
    if (JS.isUndefined(captureEventName) || captureEventName.truthy()) {
      JS.invoke(client, "capture", if (JS.isNullish(captureEventName)) { "$opt_in" } else { captureEventName }, getProp(options, "captureProperties"), JS.object("send_instantly", true));
    }
    if (this.config["capture_pageview"].truthy()) {
      this._captureInitialPageview();
    }
  }

  void opt_out_capturing() {
    JsValue client = this;
    if (JS.strictEqual(this.config["cookieless_mode"], "always")) {
      logger.warn(JS.array(CONSENT_COOKIELESS_WARN));
      return;
    }
    if (JS.strictEqual(this.config["cookieless_mode"], "on_reject") && this.consent.isOptedIn()) {
      resetClient(this, true, true, JS.undefined());
    }
    this.consent.optInOut(false);
    syncOptOutWithPersistence(this);
    if (JS.strictEqual(this.config["cookieless_mode"], "on_reject")) {
      JS.invoke(client, "register", JS.object("distinct_id", "$posthog_cookieless", "$device_id", null));
      callOptional(this.sessionRecording, "stopRecording");
      this.sessionRecording = JS.undefined();
      SessionIdManager? sessionManager = this.sessionManager;
      if (sessionManager != null) {
        sessionManager.destroy();
      }
      this.pageViewManager.destroy();
      this.sessionManager = JS.assume(JS.undefined());
      this.sessionPropsManager = JS.assume(JS.undefined());
      if (this.config["capture_pageview"].truthy()) {
        this._captureInitialPageview();
      }
      this._start_queue_if_opted_in();
    }
  }

  bool has_opted_in_capturing() {
    return this.consent.isOptedIn();
  }

  bool has_opted_out_capturing() {
    return this.consent.isOptedOut();
  }

  string get_explicit_consent_status() {
    int consent = consentOf(this.consent);
    return if (consent == CONSENT_GRANTED) { "granted" } else { if (consent == CONSENT_DENIED) { "denied" } else { "pending" } };
  }

  bool is_capturing() {
    JsValue mode = this.config["cookieless_mode"];
    if (JS.strictEqual(mode, "always")) {
      return true;
    }
    if (JS.strictEqual(mode, "on_reject")) {
      return this.consent.isRejected() || this.consent.isOptedIn();
    }
    JsValue client = this;
    return !JS.invoke(client, "has_opted_out_capturing").truthy();
  }

  void clear_opt_in_out_capturing() {
    this.consent.reset();
    syncOptOutWithPersistence(this);
  }

  JsValue _is_bot() {
    if (navigator.truthy()) {
      return isLikelyBot(navigator, this.config["custom_blocked_useragents"]);
    }
    return JS.undefined();
  }

  void _captureInitialPageview() {
    JsValue client = this;
    if (!document.truthy()) {
      return;
    }
    // A prerendered or background tab captures its first pageview when it is shown.
    if (JS.strictNotEqual(document["visibilityState"], "visible")) {
      if (!this._visibilityStateListener.truthy()) {
        this._visibilityStateListener = JS.invoke(client["_captureInitialPageview"], "bind", client);
        addEventListener(document, "visibilitychange", this._visibilityStateListener, false, true);
      }
      return;
    }
    if (!this._initialPageviewCaptured) {
      this._initialPageviewCaptured = true;
      JS.invoke(client, "capture", "$pageview", JS.object("title", document["title"]), JS.object("send_instantly", true));
      if (this._visibilityStateListener.truthy()) {
        JS.invoke(document, "removeEventListener", "visibilitychange", this._visibilityStateListener);
        this._visibilityStateListener = null;
      }
    }
  }

  void debug(JsValue debug = JS.undefined()) {
    JsValue client = this;
    if (JS.strictEqual(debug, false)) {
      if (!JS.isNullish(win)) {
        JS.invoke(win["console"], "log", "You've disabled debug mode.");
      }
      JS.invoke(client, "set_config", JS.object("debug", false));
    } else {
      if (!JS.isNullish(win)) {
        JS.invoke(win["console"], "log", "You're now in debug mode. All calls to PostHog will be logged in your console.\nYou can disable this with `posthog.debug(false)`.");
      }
      JS.invoke(client, "set_config", JS.object("debug", true));
    }
  }

  bool _shouldDisableFlags() {
    JsValue originalConfig = JS.or(this._originalUserConfig, JS.object());
    if (JS.in("advanced_disable_flags", originalConfig)) {
      return originalConfig["advanced_disable_flags"].truthy();
    }
    if (JS.strictNotEqual(this.config["advanced_disable_flags"], false)) {
      return this.config["advanced_disable_flags"].truthy();
    }
    if (JS.strictEqual(this.config["advanced_disable_decide"], true)) {
      logger.warn(JS.array("Config field 'advanced_disable_decide' is deprecated. Please use 'advanced_disable_flags' instead. The old field will be removed in a future major version."));
      return true;
    }
    return migrateConfigField(originalConfig, "advanced_disable_flags", "advanced_disable_decide", false).truthy();
  }

  JsValue getPageViewId() {
    return this.pageViewManager.doEvent()["$pageview_id"];
  }

  void captureTraceFeedback(JsValue traceId, JsValue userFeedback) {
    JsValue client = this;
    JS.invoke(client, "capture", "$ai_feedback", JS.object("$ai_trace_id", JS.call(String, JS.undefined(), traceId), "$ai_feedback_text", userFeedback));
  }

  void captureTraceMetric(JsValue traceId, JsValue metricName, JsValue metricValue) {
    JsValue client = this;
    JS.invoke(client, "capture", "$ai_metric", JS.object("$ai_trace_id", JS.call(String, JS.undefined(), traceId), "$ai_metric_name", metricName, "$ai_metric_value", JS.call(String, JS.undefined(), metricValue)));
  }
}

bool flagsLoaded(JsValue client) {
  JsValue flags = client["featureFlags"];
  JsValue loaded = if (JS.isNullish(flags)) { JS.undefined() } else { flags["hasLoadedFlags"] };
  return if (JS.isNullish(loaded)) { false } else { loaded.truthy() };
}

JsValue installClientShape() {
  JS.set(PostHog, "__defaultExtensionClasses", JS.object());
  defineGetter(PostHog, "decideEndpointWasHit", JS.method0((JsValue client) => {
    JsValue flags = client["featureFlags"];
    JsValue loaded = if (JS.isNullish(flags)) { JS.undefined() } else { flags["hasLoadedFlags"] };
    return if (JS.isNullish(loaded)) { false } else { loaded };
  }));
  defineGetter(PostHog, "flagsEndpointWasHit", JS.method0((JsValue client) => {
    JsValue flags = client["featureFlags"];
    JsValue loaded = if (JS.isNullish(flags)) { JS.undefined() } else { flags["hasLoadedFlags"] };
    return if (JS.isNullish(loaded)) { false } else { loaded };
  }));
  defineGetter(PostHog, "logger", JS.method0((JsValue client) => {
    JsValue logs = client["logs"];
    JsValue logsLogger = if (JS.isNullish(logs)) { JS.undefined() } else { logs["logger"] };
    return if (JS.isNullish(logsLogger)) { NOOP_LOGGER } else { logsLogger };
  }));
  return JS.undefined();
}

JsValue clientShape = installClientShape();

// Every instance learns when the DOM is ready; requests queued before then go out.
void addDomLoadedHandler() {
  bool done = false;
  func(JsValue)->void domLoadedHandler = (JsValue event) => {
    if (done) {
      return;
    }
    done = true;
    ENQUEUE_REQUESTS = false;
    each(instances, (JsValue instance, JsValue name) => {
      JS.invoke(instance, "_dom_loaded");
    });
  };
  if (!JS.isNullish(document) && document["addEventListener"].truthy()) {
    if (JS.strictEqual(document["readyState"], "complete")) {
      domLoadedHandler(JS.undefined());
    } else {
      addEventListener(document, "DOMContentLoaded", domLoadedHandler, false, true);
    }
    return;
  }
  if (win.truthy()) {
    logger.error(JS.array("Browser doesn't support `document.addEventListener` so PostHog couldn't be initialized"));
  }
}

export JsValue initAsModule() {
  Config.distChannel = "npm";
  JsValue posthogMain = new PostHog();
  instances[PRIMARY_INSTANCE_NAME] = posthogMain;
  addDomLoadedHandler();
  return posthogMain;
}

export constructor PostHog;

// The class as a value, for the module export.
export JsValue PostHogClass = PostHog;
