// ---- module state ----

JsValue instances = JS.object();
int executeArrayDepth = 0;
JsValue NOOP = () => {};

string CONSENT_COOKIELESS_WARN = "Consent opt in/out is not valid with cookieless_mode=\"always\" and will be ignored";
string RESET_CONSENT_WARN = "reset() cleared the stored consent, and capturing is now off because of `opt_out_capturing_by_default`. Call opt_in_capturing() again, and prefer calling reset() before opting in rather than after.";
string SURVEYS_NOT_AVAILABLE = "Surveys module not available";
string SANITIZE_DEPRECATED = "sanitize_properties is deprecated. Use before_send instead";
string DENYLIST_INVALID = "Invalid value for property_denylist config: ";
string[] FLAG_CALLED_TRANSPORT_PROPERTY_KEYS = ["token", "distinct_id", "$cookieless_mode"];
string PRIMARY_INSTANCE_NAME = "posthog";

// Old Opera without CORS requests queued requests until the DOM loaded.
bool ENQUEUE_REQUESTS = !SUPPORTS_REQUEST && !JS.isNullish(userAgent) && JS.strictEqual(JS.invoke(userAgent, "indexOf", "MSIE"), -1) && JS.strictEqual(JS.invoke(userAgent, "indexOf", "Mozilla"), -1);

JsValue DEFAULT_CONTENT_IGNORELIST_WITH_STEPPERS = JS.array("next", "previous", "prev", ">", "<", "+", "-", "−", "–");

// ---- configuration ----

bool since(JsValue defaults, string date) {
  return defaults.truthy() && JS.greaterThanOrEqual(defaults, date);
}

export JsValue defaultConfig(JsValue defaults) {
  JsValue searchValue = if (JS.isNullish(location)) { JS.undefined() } else { location["search"] };
  bool debug = location.truthy() && isString(searchValue) && JS.number(JS.invoke(location["search"], "indexOf", "__posthog_debug=true")) != -1.0;
  JsValue winLocation = if (JS.isNullish(win)) { JS.undefined() } else { win["location"] };
  JsValue protocol = if (JS.isNullish(winLocation)) { JS.undefined() } else { winLocation["protocol"] };
  JsValue config = JS.object(
    "api_host", "https://us.i.posthog.com",
    "flags_api_host", null,
    "ui_host", null,
    "asset_host", null,
    "token", "",
    "autocapture", true,
    "cross_subdomain_cookie", isCrossDomainCookie(if (JS.isNullish(document)) { JS.undefined() } else { document["location"] }),
    "persistence", "localStorage+cookie",
    "persistence_name", "",
    "cookie_persisted_properties", JS.array(),
    "loaded", NOOP,
    "save_campaign_params", true,
    "custom_campaign_params", JS.array(),
    "custom_blocked_useragents", JS.array(),
    "save_referrer", true,
    "capture_pageleave", "if_capture_pageview",
    "defaults", if (JS.isNullish(defaults)) { "unset" } else { defaults },
    "__preview_deferred_init_extensions", false,
    "__preview_external_dependency_versioned_paths", false,
    "__preview_cookie_wins_on_conflict", false,
    "debug", debug,
    "cookie_expiration", 365,
    "upgrade", false,
    "disable_session_recording", false,
    "disable_persistence", false,
    "disable_web_experiments", true,
    "disable_surveys", false,
    "disable_surveys_automatic_display", false,
    "disable_conversations", false,
    "disable_product_tours", false,
    "disableDeviceModel", false,
    "disable_external_dependency_loading", false,
    "strict_script_versioning", "fallback",
    "enable_recording_console_log", JS.undefined(),
    "secure_cookie", JS.strictEqual(protocol, "https:"),
    "ip", false,
    "opt_out_capturing_by_default", false,
    "opt_out_persistence_by_default", false,
    "opt_out_useragent_filter", false,
    "opt_out_capturing_persistence_type", "localStorage",
    "consent_persistence_name", null,
    "opt_out_capturing_cookie_prefix", null,
    "opt_in_site_apps", false,
    "property_denylist", JS.array(),
    "respect_dnt", false,
    "sanitize_properties", null,
    "request_headers", JS.object(),
    "request_batching", true,
    "properties_string_max_length", 65535,
    "mask_all_element_attributes", false,
    "mask_all_text", false,
    "mask_personal_data_properties", false,
    "custom_personal_data_properties", JS.array(),
    "advanced_disable_flags", false,
    "advanced_disable_decide", false,
    "advanced_disable_feature_flags", false,
    "advanced_disable_feature_flags_on_first_load", false,
    "advanced_only_evaluate_survey_feature_flags", false,
    "advanced_feature_flags_dedup_per_session", false,
    "advanced_enable_surveys", false,
    "advanced_disable_toolbar_metrics", false,
    "feature_flag_request_timeout_ms", 3000,
    "surveys_request_timeout_ms", 10000,
    "on_request_error", (JsValue res) => {
      logger.error(JS.array(JS.add(JS.add(JS.add("Bad HTTP status: ", res["statusCode"]), " "), res["text"])));
    },
    "get_device_id", (JsValue uuid) => uuid,
    "capture_performance", JS.undefined(),
    "name", "posthog",
    "bootstrap", JS.object(),
    "disable_compression", false,
    "session_idle_timeout_seconds", 1800,
    "person_profiles", "identified_only",
    "before_send", JS.undefined(),
    "get_current_url", JS.undefined(),
    "request_queue_config", JS.object("flush_interval_ms", 3000),
    "error_tracking", JS.object(),
    "_onCapture", NOOP
  );
  // Defaults that depend on the `defaults` date the page opted into.
  config["rageclick"] = if (since(defaults, "2026-05-30")) { JS.object("content_ignorelist", DEFAULT_CONTENT_IGNORELIST_WITH_STEPPERS, "ignore_text_selection", true) } else { if (since(defaults, "2025-11-30")) { JS.object("content_ignorelist", true) } else { true } };
  config["capture_pageview"] = if (since(defaults, "2025-05-24")) { "history_change" } else { true };
  config["session_recording"] = if (since(defaults, "2026-06-25")) { JS.object("strictMinimumDuration", true, "canvasCapture", JS.object("resolutionScale", 0.6), "streamNetworkBody", true) } else { if (since(defaults, "2026-05-30")) { JS.object("strictMinimumDuration", true, "canvasCapture", JS.object("resolutionScale", 0.6)) } else { if (since(defaults, "2025-11-30")) { JS.object("strictMinimumDuration", true) } else { JS.object() } } };
  config["external_scripts_inject_target"] = if (since(defaults, "2026-01-30")) { "head" } else { "body" };
  config["internal_or_test_user_hostname"] = JS.undefined();
  if (since(defaults, "2026-01-30")) {
    config["internal_or_test_user_hostname"] = new Regex("^(localhost|127\\.0\\.0\\.1)$");
  }
  config["persistence_save_debounce_ms"] = if (since(defaults, "2026-05-30")) { 250 } else { 0 };
  config["split_storage"] = since(defaults, "2026-05-30");
  config["detect_google_search_app"] = since(defaults, "2026-05-30");
  config["disable_capture_url_hashes"] = since(defaults, "2026-06-25");
  config["cookieWinsOnConflict"] = defaults.truthy() && JS.strictNotEqual(defaults, "unset") && JS.greaterThanOrEqual(defaults, "2026-08-29");
  return config;
}

string[] CONFIG_RENAMES_OLD = ["process_person", "xhr_headers", "cookie_name", "disable_cookie", "__preview_disable_beacon", "store_google", "verbose", "__preview_cookie_wins_on_conflict"];
string[] CONFIG_RENAMES_NEW = ["person_profiles", "request_headers", "persistence_name", "disable_persistence", "disable_beacon", "save_campaign_params", "debug", "cookieWinsOnConflict"];

export JsValue configRenames(JsValue origConfig) {
  JsValue renames = JS.object();
  for (int i = 0; i < CONFIG_RENAMES_OLD.length; i++) {
    if (!JS.isUndefined(origConfig[CONFIG_RENAMES_OLD[i]])) {
      renames[CONFIG_RENAMES_NEW[i]] = origConfig[CONFIG_RENAMES_OLD[i]];
    }
  }
  JsValue newConfig = extend(extend(JS.object(), renames), origConfig);
  JsValue preview = origConfig["__preview_external_dependency_versioned_paths"];
  if (!JS.isUndefined(preview)) {
    if (JS.isUndefined(origConfig["strict_script_versioning"])) {
      newConfig["strict_script_versioning"] = preview.truthy();
    }
    if (isString(preview) && JS.isUndefined(origConfig["asset_host"])) {
      newConfig["asset_host"] = preview;
    }
  }
  JsValue blacklist = origConfig["property_blacklist"];
  if (isArray(blacklist)) {
    JsValue denylist = origConfig["property_denylist"];
    if (JS.isUndefined(denylist)) {
      newConfig["property_denylist"] = blacklist;
    } else if (isArray(denylist)) {
      newConfig["property_denylist"] = JS.invoke(JS.array(), "concat", blacklist, denylist);
    } else {
      logger.error(JS.array(JS.add(DENYLIST_INVALID, denylist)));
    }
  }
  return newConfig;
}

// `posthog.webPerformance`: a deprecated shim whose only behaviour is a warning.
export class DeprecatedWebPerformanceObserver {
  bool __forceAllowLocalhost;

  init() {
    this.__forceAllowLocalhost = false;
  }
}

JsValue installWebPerformanceAccessor() {
  JS.invoke(Object, "defineProperty", JS.get(DeprecatedWebPerformanceObserver, "prototype"), "_forceAllowLocalhost", JS.object(
    "get", JS.method0((JsValue observer) => observer["__forceAllowLocalhost"]),
    "set", JS.method1((JsValue observer, JsValue value) => {
      logger.error(JS.array("WebPerformanceObserver is deprecated and has no impact on network capture. Use `_forceAllowLocalhostNetworkCapture` on `posthog.sessionRecording`"));
      observer["__forceAllowLocalhost"] = value;
      return JS.undefined();
    }),
    "configurable", true
  ));
  return JS.undefined();
}

JsValue webPerformanceAccessor = installWebPerformanceAccessor();

export constructor DeprecatedWebPerformanceObserver;

// ---- helpers shared by the client's methods ----

JsValue getProp(JsValue target, string key) {
  return if (JS.isNullish(target)) { JS.undefined() } else { target[key] };
}

Regex UUID_REGEX = new Regex("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "i");

JsValue getEventUuid(JsValue uuid) {
  if (JS.typeOf(uuid) == "string" && UUID_REGEX.test(JS.string(uuid))) {
    return uuid;
  }
  return uuidv7();
}

extern JsValue localStorage;

JsValue surveyIterationKey(JsValue id, JsValue iteration) {
  if (iteration.truthy() && JS.greaterThan(iteration, 0)) {
    return JS.add(JS.add(JS.add("", id), "_"), iteration);
  }
  return id;
}

void setSurveySeenOnLocalStorage(JsValue id, JsValue iteration) {
  try {
    JsValue key = JS.add("seenSurvey_", surveyIterationKey(id, iteration));
    if (JS.invoke(localStorage, "getItem", key).truthy()) {
      return;
    }
    JS.invoke(localStorage, "setItem", key, "true");
  } catch (JsValue error) {
    createLogger("[Surveys]").error(JS.array("Failed to persist survey seen state", error));
  }
}

JsValue surveyInteractionProperty(JsValue id, JsValue iteration, string action) {
  JsValue property = JS.add(JS.add("$survey_" + action + "/", id), "");
  if (iteration.truthy() && JS.greaterThan(iteration, 0)) {
    property = JS.add(JS.add(JS.add("$survey_" + action + "/", id), "/"), iteration);
  }
  return property;
}

JsValue DEFAULT_DISPLAY_SURVEY_OPTIONS = JS.object("ignoreConditions", false, "ignoreDelay", false, "displayType", "popover");

JsValue noopLoggerFn = () => {};
JsValue NOOP_LOGGER = JS.object("trace", noopLoggerFn, "debug", noopLoggerFn, "info", noopLoggerFn, "warn", noopLoggerFn, "error", noopLoggerFn, "fatal", noopLoggerFn);

JsValue isDeadClicksEnabledForAutocapture = (JsValue deadClicks) => {
  JsValue client = deadClicks["instance"];
  JsValue persistence = client["persistence"];
  bool isRemoteEnabled = if (JS.isNullish(persistence)) { false } else { JS.invoke(persistence, "get_property", "$dead_clicks_enabled_server_side").truthy() };
  JsValue clientConfig = client["config"]["capture_dead_clicks"];
  if (isBoolean(clientConfig)) {
    return clientConfig;
  }
  if (isObject(clientConfig)) {
    return true;
  }
  return isRemoteEnabled;
};

bool inCookielessMode(PostHog ph) {
  JsValue mode = ph.config["cookieless_mode"];
  return JS.strictEqual(mode, "always") || (JS.strictEqual(mode, "on_reject") && ph.consent.isRejected());
}

bool isPersistenceDisabled(PostHog ph) {
  JsValue config = ph.config;
  if (JS.strictEqual(config["cookieless_mode"], "always")) {
    return true;
  }
  bool isOptedOut = ph.consent.isOptedOut();
  bool defaultPersistenceDisabled = config["opt_out_persistence_by_default"].truthy() || JS.strictEqual(config["cookieless_mode"], "on_reject");
  return config["disable_persistence"].truthy() || (isOptedOut && defaultPersistenceDisabled);
}

// `_sessionRegisteredPropKeys` behaves as upstream's insertion-ordered Set.
void addRegisteredKey(PostHog ph, string key) {
  if (!ph._sessionRegisteredPropKeys.includes(key)) {
    ph._sessionRegisteredPropKeys.push(key);
  }
}

void persistSessionRegisteredPropKeys(PostHog ph) {
  string key = ph._sessionRegisteredPropertiesStorageKey;
  if (key == "") {
    return;
  }
  PostHogPersistence? sessionPersistence = ph.sessionPersistence;
  if (JS.strictEqual(ph.config["persistence"], "memory") || (sessionPersistence != null && sessionPersistence._disabled) || !sessionStore.isSupported()) {
    sessionStore.remove(key, JS.undefined());
    return;
  }
  string[] registered = ph._sessionRegisteredPropKeys.slice();
  if (registered.length > 0) {
    sessionStore.set(key, registered, JS.undefined(), JS.undefined(), JS.undefined());
  } else {
    sessionStore.remove(key, JS.undefined());
  }
}

bool syncOptOutWithPersistence(PostHog ph) {
  bool persistenceDisabled = isPersistenceDisabled(ph);
  PostHogPersistence? persistence = ph.persistence;
  if (persistence != null && persistence._disabled != persistenceDisabled) {
    persistence.set_disabled(persistenceDisabled);
  }
  PostHogPersistence? sessionPersistence = ph.sessionPersistence;
  if (sessionPersistence != null && sessionPersistence._disabled != persistenceDisabled) {
    sessionPersistence.set_disabled(persistenceDisabled);
  }
  if (persistenceDisabled) {
    ph._sessionRegisteredPropKeys = [];
    persistSessionRegisteredPropKeys(ph);
  }
  return persistenceDisabled;
}

// A tab that started cookieless keeps the sentinel id in memory; once consent flips in
// another tab it must not leak into real events.
void healCookielessSentinelDistinctId(PostHog ph) {
  JsValue client = ph;
  if (inCookielessMode(ph) || JS.strictNotEqual(JS.invoke(client, "get_distinct_id"), "$posthog_cookieless")) {
    return;
  }
  PostHogPersistence? persistence = ph.persistence;
  if (persistence == null) {
    return;
  }
  if (!isPersistenceDisabled(ph)) {
    persistence.load(true);
  }
  JsValue currentDistinctId = JS.invoke(client, "get_distinct_id");
  if (!currentDistinctId.truthy() || JS.strictEqual(currentDistinctId, "$posthog_cookieless")) {
    JsValue uuid = JS.invoke(ph.config, "get_device_id", uuidv7());
    JS.invoke(client, "register", JS.object("distinct_id", uuid, "$device_id", uuid));
    persistence.set_property("$user_state", "anonymous");
  }
  syncOptOutWithPersistence(ph);
}

JsValue checkLocalStorageForDebug(JsValue debugConfig) {
  bool explicitlyFalse = isBoolean(debugConfig) && !debugConfig.truthy();
  bool isTrueInLocalStorage = localStore.isSupported() && JS.strictEqual(localStore.get("ph_debug"), "true");
  if (explicitlyFalse) {
    return false;
  }
  return if (isTrueInLocalStorage) { true } else { debugConfig };
}

JsValue extensionClass(PostHog ph, string name) {
  JsValue fromConfig = getProp(ph.config["__extensionClasses"], name);
  if (!JS.isNullish(fromConfig)) {
    return fromConfig;
  }
  return getProp(JS.get(PostHog, "__defaultExtensionClasses"), name);
}

void enrollFeatureFlags(PostHog ph) {
  JsValue FeatureFlagsClass = extensionClass(ph, "featureFlags");
  if (!FeatureFlagsClass.truthy()) {
    return;
  }
  if (!ph.featureFlags.truthy() || !instanceOf(ph.featureFlags, FeatureFlagsClass)) {
    if (!JS.isNullish(ph._featureFlagsReloadingUnsubscribe)) {
      JS.call(ph._featureFlagsReloadingUnsubscribe, JS.undefined());
    }
    ph._featureFlagsReloadingUnsubscribe = JS.undefined();
    ph.featureFlags = JS.construct(FeatureFlagsClass, ph);
  }
  JsValue flags = ph.featureFlags;
  if (isFunction(flags["onReloading"]) && isFunction(flags["setup"])) {
    if (!ph._featureFlagsReloadingUnsubscribe.truthy()) {
      ph._featureFlagsReloadingUnsubscribe = JS.invoke(flags, "onReloading", () => {
        ph._internalEventEmitter.emit("featureFlagsReloading", true);
      });
      ph._getBrowserClientAdapter().add(flags);
    }
  } else if (!JS.isNullish(flags["initialize"])) {
    JS.invoke(flags, "initialize");
  }
}

JsValue extensionOrNew(JsValue existing, JsValue ctor, PostHog ph) {
  return if (JS.isNullish(existing)) { JS.construct(ctor, ph) } else { existing };
}

void initExtensions(PostHog ph, bool startInCookielessMode) {
  number initStartTime = JS.number(JS.invoke(performance, "now"));
  JsValue ext = assign(copy(JS.get(PostHog, "__defaultExtensionClasses")), ph.config["__extensionClasses"]);
  (func()->void)[] initTasks = [];
  if (ext["exceptions"].truthy()) {
    ph.exceptions = extensionOrNew(ph.exceptions, ext["exceptions"], ph);
    ph._extensions.push(ph.exceptions);
  }
  if (ext["historyAutocapture"].truthy()) {
    ph.historyAutocapture = JS.construct(ext["historyAutocapture"], ph);
    ph._extensions.push(ph.historyAutocapture);
  }
  if (ext["tracingHeaders"].truthy()) {
    ph.tracingHeaders = JS.construct(ext["tracingHeaders"], ph);
    ph._extensions.push(ph.tracingHeaders);
  }
  if (ext["siteApps"].truthy()) {
    ph.siteApps = JS.construct(ext["siteApps"], ph);
    ph._extensions.push(ph.siteApps);
  }
  if (ext["sessionRecording"].truthy() && !startInCookielessMode) {
    ph.sessionRecording = JS.construct(ext["sessionRecording"], ph);
    ph._extensions.push(ph.sessionRecording);
  }
  if (!ph.config["disable_scroll_properties"].truthy()) {
    initTasks.push(() => {
      ph.scrollManager.startMeasuringScrollPosition();
    });
  }
  if (ext["autocapture"].truthy()) {
    ph.autocapture = JS.construct(ext["autocapture"], ph);
    ph._extensions.push(ph.autocapture);
  }
  if (ext["surveys"].truthy()) {
    ph.surveys = extensionOrNew(ph.surveys, ext["surveys"], ph);
    ph._extensions.push(ph.surveys);
  }
  if (ext["logs"].truthy()) {
    ph.logs = extensionOrNew(ph.logs, ext["logs"], ph);
    ph._extensions.push(ph.logs);
  }
  if (ext["metrics"].truthy()) {
    ph.metrics = extensionOrNew(ph.metrics, ext["metrics"], ph);
    ph._extensions.push(ph.metrics);
  }
  if (ext["conversations"].truthy()) {
    ph.conversations = extensionOrNew(ph.conversations, ext["conversations"], ph);
    ph._extensions.push(ph.conversations);
  }
  if (ext["productTours"].truthy()) {
    ph.productTours = JS.construct(ext["productTours"], ph);
    ph._extensions.push(ph.productTours);
  }
  if (ext["heatmaps"].truthy()) {
    ph.heatmaps = JS.construct(ext["heatmaps"], ph);
    ph._extensions.push(ph.heatmaps);
  }
  if (ext["webVitalsAutocapture"].truthy()) {
    ph.webVitalsAutocapture = JS.construct(ext["webVitalsAutocapture"], ph);
    ph._extensions.push(ph.webVitalsAutocapture);
  }
  if (ext["exceptionObserver"].truthy()) {
    ph.exceptionObserver = JS.construct(ext["exceptionObserver"], ph);
    ph._extensions.push(ph.exceptionObserver);
  }
  if (ext["deadClicksAutocapture"].truthy()) {
    ph.deadClicksAutocapture = JS.construct(ext["deadClicksAutocapture"], ph, isDeadClicksEnabledForAutocapture);
    ph._extensions.push(ph.deadClicksAutocapture);
  }
  if (ext["toolbar"].truthy()) {
    ph.toolbar = extensionOrNew(ph.toolbar, ext["toolbar"], ph);
    ph._extensions.push(ph.toolbar);
  }
  if (ext["experiments"].truthy()) {
    ph.experiments = extensionOrNew(ph.experiments, ext["experiments"], ph);
    ph._extensions.push(ph.experiments);
  }
  ph._extensions.forEach((JsValue extension) => {
    if (!extension["initialize"].truthy()) {
      return;
    }
    initTasks.push(() => {
      if (!JS.isNullish(extension["initialize"])) {
        JS.invoke(extension, "initialize");
      }
    });
  });
  // Replay a remote config that arrived before the extensions existed.
  initTasks.push(() => {
    if (ph._pendingRemoteConfig.truthy()) {
      JsValue result = ph._pendingRemoteConfig;
      ph._pendingRemoteConfig = JS.undefined();
      ph._extensions.forEach((JsValue extension) => {
        if (!JS.isNullish(extension["onRemoteConfig"])) {
          JS.invoke(extension, "onRemoteConfig", result);
        }
      });
    }
  });
  processInitTaskQueue(ph, initTasks, initStartTime);
}

// With deferred init, tasks yield to the page every 30 ms.
void processInitTaskQueue(PostHog ph, (func()->void)[] queue, number initStartTime) {
  while (queue.length > 0) {
    if (ph.config["__preview_deferred_init_extensions"].truthy()) {
      number elapsed = JS.number(JS.invoke(performance, "now")) - initStartTime;
      if (elapsed >= 30.0 && queue.length > 0) {
        JS.call(setTimeout, JS.undefined(), () => {
          processInitTaskQueue(ph, queue, initStartTime);
        }, 0);
        return;
      }
    }
    func()->void task = queue[0];
    queue.splice(0, 1);
    try {
      task();
    } catch (JsValue error) {
      logger.error(JS.array("Error initializing extension:", error));
    }
  }
  JsValue taskInitTiming = JS.invoke(Math, "round", JS.number(JS.invoke(performance, "now")) - initStartTime);
  bool deferred = ph.config["__preview_deferred_init_extensions"].truthy();
  JsValue client = ph;
  JS.invoke(client, "register_for_session", JS.object(
    "$sdk_debug_extensions_init_method", if (deferred) { "deferred" } else { "synchronous" },
    "$sdk_debug_extensions_init_time_ms", taskInitTiming
  ));
  if (ph.config["__preview_deferred_init_extensions"].truthy()) {
    logger.info(JS.array(JS.add(JS.add("PostHog extensions initialized (", taskInitTiming), "ms)")));
  }
}

bool processCookieIdentityChange(PostHog ph, bool reloadFeatureFlags) {
  PostHogPersistence? persistence = ph.persistence;
  if (persistence == null || !persistence.consumeCookieIdentityChange()) {
    return false;
  }
  ph._cachedPersonProperties = null;
  if (JS.strictEqual(persistence.get_property("$user_state"), "anonymous")) {
    PostHogPersistence? sessionPersistence = ph.sessionPersistence;
    if (sessionPersistence != null) {
      sessionPersistence.clear();
    }
    ph._sessionRegisteredPropKeys = [];
    persistSessionRegisteredPropKeys(ph);
  }
  if (!JS.isNullish(ph.featureFlags)) {
    JS.invoke(ph.featureFlags, "reset");
  }
  if (reloadFeatureFlags) {
    JsValue client = ph;
    JS.invoke(client, "reloadFeatureFlags");
  }
  return true;
}

bool requirePersonProcessing(PostHog ph, string functionName) {
  if (JS.strictEqual(ph.config["person_profiles"], "never")) {
    logger.error(JS.array(functionName + " was called, but process_person is set to \"never\". This call will be ignored."));
    return false;
  }
  JsValue client = ph;
  JS.invoke(client, "_register_single", "$epp", true);
  return true;
}

bool hasPersonProcessing(PostHog ph) {
  JsValue profiles = ph.config["person_profiles"];
  if (JS.strictEqual(profiles, "never")) {
    return false;
  }
  if (!JS.strictEqual(profiles, "identified_only")) {
    return true;
  }
  JsValue client = ph;
  PostHogPersistence? persistence = ph.persistence;
  JsValue props = if (persistence != null) { persistence.props } else { JS.undefined() };
  return JS.invoke(client, "_isIdentified").truthy() || !isEmptyObject(JS.invoke(client, "getGroups")) || getProp(props, "__alias").truthy() || getProp(props, "$epp").truthy();
}

bool shouldCapturePageleave(PostHog ph) {
  JsValue pageleave = ph.config["capture_pageleave"];
  JsValue pageview = ph.config["capture_pageview"];
  return JS.strictEqual(pageleave, true) || (JS.strictEqual(pageleave, "if_capture_pageview") && (JS.strictEqual(pageview, true) || JS.strictEqual(pageview, "history_change")));
}

bool validateIdentifyId(JsValue id) {
  if (!id.truthy() || isEmptyString(id)) {
    logger.critical(JS.array("Unique user id has not been set in posthog.identify"));
    return false;
  }
  if (JS.strictEqual(id, "$posthog_cookieless")) {
    logger.critical(JS.array(JS.add(JS.add("The string \"", id), "\" was set in posthog.identify which indicates an error. This ID is only used as a sentinel value.")));
    return false;
  }
  JsValue lower = JS.invoke(id, "toLowerCase");
  if (JS.strictEqual(lower, "distinct_id") || JS.strictEqual(lower, "distinctid") || JS.strictEqual(lower, "undefined") || JS.strictEqual(lower, "null")) {
    logger.critical(JS.array(JS.add(JS.add("The string \"", id), "\" was set in posthog.identify which indicates an error. This ID should be unique to the user and not a hardcoded string.")));
    return false;
  }
  return true;
}

// `before_send`: each function sees the previous one's result; a nullish result drops
// the event, and so does removing a property ingestion requires.
JsValue runBeforeSend(PostHog ph, JsValue data) {
  JsValue beforeSend = ph.config["before_send"];
  if (JS.isNullish(beforeSend)) {
    return data;
  }
  JsValue dataProperties = data["properties"];
  string[] requiredProperties = keysOf(if (JS.isNullish(dataProperties)) { JS.object() } else { dataProperties }).filter((string key) => isKnownUnsafeEditableEventProperty(key));
  JsValue fns = if (isArray(beforeSend)) { beforeSend } else { JS.array(beforeSend) };
  JsValue result = data;
  int count = JS.number(fns["length"]).toInt();
  for (int i = 0; i < count; i++) {
    JsValue fn = fns[i];
    try {
      result = JS.call(fn, JS.undefined(), result);
      if (JS.isNullish(result)) {
        JsValue message = JS.add(JS.add("Event '", data["event"]), "' was rejected in beforeSend function");
        if (isKnownUnsafeEditableEvent(data["event"])) {
          logger.warn(JS.array(JS.add(message, ". This can cause unexpected behavior.")));
        } else {
          logger.info(JS.array(message));
        }
        return null;
      }
      if (!result["properties"].truthy() || isEmptyObject(result["properties"])) {
        logger.warn(JS.array(JS.add(JS.add("Event '", data["event"]), "' has no properties after beforeSend function, this is likely an error.")));
      }
    } catch (JsValue e) {
      logger.error(JS.array(JS.add(JS.add("Error in beforeSend function for event '", data["event"]), "':"), e));
      return null;
    }
  }
  for (string property of requiredProperties) {
    if (result["properties"].truthy() && JS.isNullish(result["properties"][property])) {
      logger.warn(JS.array(JS.add(JS.add(JS.add(JS.add("Event '", data["event"]), "' had its '"), property), "' property removed in a beforeSend function. This property is required for ingestion, so the event will be dropped.")));
      return null;
    }
  }
  return result;
}

JsValue replaceExtension(PostHog ph, JsValue oldExt, JsValue newExt) {
  if (oldExt.truthy()) {
    int index = ph._extensions.indexOf(oldExt);
    if (index != -1) {
      ph._extensions.splice(index, 1);
    }
  }
  ph._extensions.push(newExt);
  if (!JS.isNullish(newExt["initialize"])) {
    JS.invoke(newExt, "initialize");
  }
  return newExt;
}

// One queued call `[name, ...args]`, or a chain `[[name, ...args], ...]` applied to each
// result in turn (`posthog.get_group().set()` in the snippet).
void executeCalls(JsValue calls, JsValue thisArg) {
  if (!isArray(calls)) {
    return;
  }
  JS.invoke(calls, "forEach", (JsValue item) => {
    try {
      if (isArray(item[0])) {
        JsValue caller = thisArg;
        each(item, (JsValue call, JsValue index) => {
          caller = JS.invoke(caller[JS.string(call[0])], "apply", caller, JS.invoke(call, "slice", 1));
        });
      } else {
        JS.invoke(thisArg[JS.string(item[0])], "apply", thisArg, JS.invoke(item, "slice", 1));
      }
    } catch (JsValue e) {
      logger.error(JS.array("Error executing queued PostHog call", item, e));
    }
  });
}

void callOptional(JsValue target, string method) {
  if (!JS.isNullish(target)) {
    JS.invoke(target, method);
  }
}

void identifyUser(PostHog ph, JsValue newDistinctIdArg, JsValue userPropertiesToSet, JsValue userPropertiesToSetOnce) {
  JsValue client = ph;
  PostHogPersistence? persistenceValue = ph.persistence;
  if (!ph.__loaded || persistenceValue == null) {
    logger.uninitializedWarning("posthog.identify");
    return;
  }
  PostHogPersistence persistence = persistenceValue;
  JsValue newDistinctId = newDistinctIdArg;
  if (isNumber(newDistinctId)) {
    newDistinctId = JS.invoke(newDistinctId, "toString");
    logger.warn(JS.array("The first argument to posthog.identify was a number, but it should be a string. It has been converted to a string."));
  }
  if (!validateIdentifyId(newDistinctId)) {
    return;
  }
  if (!requirePersonProcessing(ph, "posthog.identify")) {
    return;
  }
  healCookielessSentinelDistinctId(ph);
  // A sibling tab's cookie may have changed identity since the last read.
  JsValue preSyncDistinctId = JS.invoke(client, "get_distinct_id");
  bool identityChangedDuringSync = persistence.syncCookieProperties() && JS.strictNotEqual(JS.invoke(client, "get_distinct_id"), preSyncDistinctId);
  bool processedCookieIdentityChange = processCookieIdentityChange(ph, false);
  bool suppressionStarted = persistence._beginCookieSyncSuppression(false);
  bool identifyCompleted = false;
  try {
    JsValue previousDistinctId = JS.invoke(client, "get_distinct_id");
    JS.invoke(client, "register", JS.object("$user_id", newDistinctId));
    if (!JS.invoke(client, "get_property", "$device_id").truthy()) {
      // The anonymous id becomes the device id of a first-time identify.
      JS.invoke(client, "register_once", JS.object("$had_persisted_distinct_id", true, "$device_id", previousDistinctId), "");
    }
    if (JS.strictNotEqual(newDistinctId, previousDistinctId) && JS.strictNotEqual(newDistinctId, JS.invoke(client, "get_property", "__alias"))) {
      JS.invoke(client, "unregister", "__alias");
      JS.invoke(client, "register", JS.object("distinct_id", newDistinctId));
    }
    bool isKnownAnonymous = JS.strictEqual(JS.or(persistence.get_property("$user_state"), "anonymous"), "anonymous");
    bool identityDidChange = JS.strictNotEqual(newDistinctId, previousDistinctId);
    bool shouldTransitionToIdentified = !identityDidChange && isKnownAnonymous;
    if (identityDidChange && isKnownAnonymous) {
      persistence.set_property("$user_state", "identified");
      JS.invoke(client, "setPersonPropertiesForFlags", JS.object("$set", JS.or(userPropertiesToSet, JS.object()), "$set_once", JS.or(userPropertiesToSetOnce, JS.object())), false);
      if (ph.config["cookieWinsOnConflict"].truthy()) {
        persistence._publishSuppressedCookieSnapshot();
      }
      JS.invoke(client, "capture", "$identify", JS.object("distinct_id", newDistinctId, "$anon_distinct_id", previousDistinctId), JS.object("$set", JS.or(userPropertiesToSet, JS.object()), "$set_once", JS.or(userPropertiesToSetOnce, JS.object())));
      ph._cachedPersonProperties = getPersonPropertiesHash(newDistinctId, userPropertiesToSet, userPropertiesToSetOnce);
      if (!JS.isNullish(ph.featureFlags)) {
        JS.invoke(ph.featureFlags, "setAnonymousDistinctId", previousDistinctId);
      }
    } else if (shouldTransitionToIdentified) {
      persistence.set_property("$user_state", "identified");
      JsValue setProperties = JS.or(userPropertiesToSet, JS.object());
      JsValue setOnceProperties = JS.or(userPropertiesToSetOnce, JS.object());
      JS.invoke(client, "setPersonPropertiesForFlags", JS.object("$set", setProperties, "$set_once", setOnceProperties), false);
      if (ph.config["cookieWinsOnConflict"].truthy()) {
        persistence._publishSuppressedCookieSnapshot();
      }
      JS.invoke(client, "capture", "$set", JS.object("$set", setProperties, "$set_once", setOnceProperties));
      ph._cachedPersonProperties = getPersonPropertiesHash(newDistinctId, userPropertiesToSet, userPropertiesToSetOnce);
    } else if (userPropertiesToSet.truthy() || userPropertiesToSetOnce.truthy()) {
      JS.invoke(client, "setPersonProperties", userPropertiesToSet, userPropertiesToSetOnce);
    }
    if (identityDidChange || identityChangedDuringSync || processedCookieIdentityChange) {
      JS.invoke(client, "reloadFeatureFlags");
      if (ph.featureFlags.truthy()) {
        JS.invoke(ph.featureFlags, "resetFlagCallReported");
      } else {
        JS.invoke(client, "unregister", "$flag_call_reported");
      }
    } else if (shouldTransitionToIdentified && (userPropertiesToSet.truthy() || userPropertiesToSetOnce.truthy())) {
      JS.invoke(client, "reloadFeatureFlags");
    }
    identifyCompleted = true;
  } finally {
    if (suppressionStarted) {
      persistence._endCookieSyncSuppression(identifyCompleted);
    }
  }
}

bool bootstrapSessionAccepted(PostHog ph, JsValue sessionID) {
  SessionIdManager? manager = ph.sessionManager;
  return manager != null && manager.setBootstrapSessionId(sessionID, true);
}

void resetClient(PostHog ph, JsValue resetDeviceId, bool isConsentTransition, JsValue bootstrap) {
  JsValue client = ph;
  logger.info(JS.array("reset"));
  if (!ph.__loaded) {
    logger.uninitializedWarning("posthog.reset");
    return;
  }
  JsValue bootstrapSessionID = getProp(bootstrap, "sessionID");
  ph.config["bootstrap"] = JS.or(JS.or(bootstrap, getProp(ph._originalUserConfig, "bootstrap")), JS.object());
  JsValue flags = ph.featureFlags;
  if (!JS.isNullish(flags) && !JS.isNullish(flags["updateConfig"])) {
    JS.invoke(flags, "updateConfig", ph.config, JS.invoke(client, "_shouldDisableFlags"));
  }
  // The device survives a reset unless asked; its model and replay config too.
  JsValue deviceId = JS.invoke(client, "get_property", "$device_id");
  JsValue deviceModel = JS.invoke(client, "get_property", "$device_model");
  JsValue recordingRemoteConfig = JS.invoke(client, "get_property", "$session_recording_remote_config");
  bool wasCapturing = JS.invoke(client, "is_capturing").truthy();
  ph.consent.reset();
  if (!isConsentTransition && wasCapturing && !JS.invoke(client, "is_capturing").truthy()) {
    JS.invoke(console, "warn", "[PostHog.js]", RESET_CONSENT_WARN);
  }
  PostHogPersistence? persistence = ph.persistence;
  bool suppressionStarted = persistence != null && persistence._beginCookieSyncSuppression(false);
  bool resetCompleted = false;
  try {
    if (persistence != null) {
      persistence.clear();
    }
    PostHogPersistence? sessionPersistence = ph.sessionPersistence;
    if (sessionPersistence != null) {
      sessionPersistence.clear();
    }
    ph._sessionRegisteredPropKeys = [];
    persistSessionRegisteredPropKeys(ph);
    if (!JS.isUndefined(recordingRemoteConfig) && persistence != null) {
      persistence.register(JS.object("$session_recording_remote_config", recordingRemoteConfig), JS.undefined());
    }
    callOptional(ph.surveys, "reset");
    RemoteConfigLoader? loader = ph._remoteConfigLoader;
    if (loader != null) {
      loader.stop();
    }
    callOptional(ph.featureFlags, "reset");
    callOptional(ph.conversations, "reset");
    callOptional(ph.logs, "reset");
    callOptional(ph.metrics, "reset");
    if (persistence != null) {
      persistence.set_property("$user_state", "anonymous");
    }
    SessionIdManager? sessionManager = ph.sessionManager;
    if (sessionManager != null) {
      sessionManager.resetSessionId();
    }
    ph._cachedPersonProperties = null;
    if (JS.strictEqual(ph.config["cookieless_mode"], "always")) {
      JS.invoke(client, "register_once", JS.object("distinct_id", "$posthog_cookieless", "$device_id", null), "");
    } else {
      JsValue uuid = JS.invoke(ph.config, "get_device_id", uuidv7());
      JS.invoke(client, "register_once", JS.object("distinct_id", uuid, "$device_id", if (resetDeviceId.truthy()) { uuid } else { deviceId }), "");
      if (!resetDeviceId.truthy() && !JS.isUndefined(deviceModel)) {
        JS.invoke(client, "register", JS.object("$device_model", deviceModel));
      }
    }
    JS.invoke(client, "register", JS.object("$last_posthog_reset", JS.invoke(JS.construct(Date), "toISOString")), 1);
    if (bootstrap.truthy()) {
      if (!JS.isUndefined(bootstrap["distinctID"]) && !inCookielessMode(ph)) {
        if (persistence != null) {
          persistence.set_property("$user_state", if (bootstrap["isIdentifiedID"].truthy()) { "identified" } else { "anonymous" });
        }
        JS.invoke(client, "register", JS.object("distinct_id", bootstrap["distinctID"]));
      }
      if (!JS.isNullish(ph.featureFlags)) {
        JS.invoke(ph.featureFlags, "initialize");
      }
      if (!JS.isUndefined(bootstrapSessionID) && !bootstrapSessionAccepted(ph, bootstrapSessionID)) {
        JsValue withoutSessionID = assign(JS.object(), bootstrap);
        JS.delete(withoutSessionID, "sessionID");
        ph.config["bootstrap"] = withoutSessionID;
      }
    }
    JS.delete(ph.config, "identity_distinct_id");
    JS.delete(ph.config, "identity_hash");
    resetCompleted = true;
  } finally {
    if (suppressionStarted && persistence != null) {
      persistence._endCookieSyncSuppression(resetCompleted);
    }
  }
  JS.invoke(client, "reloadFeatureFlags");
}

async JsValue shutdownClient(PostHog ph) {
  if (!ph.__loaded) {
    logger.uninitializedWarning("posthog.shutdown");
    return JS.undefined();
  }
  RemoteConfigLoader? loader = ph._remoteConfigLoader;
  if (loader != null) {
    loader.stop();
  }
  BrowserClientAdapter? adapter = ph._browserClientAdapter;
  if (adapter != null) {
    adapter.dispose();
  }
  if (!JS.isNullish(ph.sessionRecording)) {
    JS.invoke(ph.sessionRecording, "dispose");
  }
  if (!JS.isNullish(ph.logs)) {
    JS.invoke(ph.logs, "flushLogs", "sendBeacon");
  }
  if (!JS.isNullish(ph.metrics)) {
    JS.invoke(ph.metrics, "flush", "sendBeacon");
  }
  RequestQueue? queue = ph._requestQueue;
  if (queue != null) {
    queue.unload();
  }
  RetryQueue? retries = ph._retryQueue;
  if (retries != null) {
    retries.unload();
  }
  try {
    if (!JS.isNullish(ph.featureFlags)) {
      JS.invoke(ph.featureFlags, "destroy");
    }
  } catch (JsValue error) {
    logger.error(JS.array("Error while destroying feature flags", error));
  }
  return JS.undefined();
}


// ---- the client ----

export class PostHog {
  DeprecatedWebPerformanceObserver webPerformance;
  bool _personProcessingSetOncePropertiesSent;
  string version;
  string[] _sessionRegisteredPropKeys;
  string _sessionRegisteredPropertiesStorageKey;
  EventEmitter _internalEventEmitter;
  JsValue[] _extensions;
  JsValue[] _extensionEventPropertyProducers;
  JsValue _calculate_event_properties;
  JsValue config;
  JsValue SentryIntegration;
  JsValue sentryIntegration;
  JsValue __request_queue;
  bool __loaded;
  JsValue analyticsDefaultEndpoint;
  bool _initialPageviewCaptured;
  JsValue _visibilityStateListener;
  JsValue _initialPersonProfilesConfig;
  JsValue _cachedPersonProperties;
  ScrollManager scrollManager;
  PageViewManager pageViewManager;
  RateLimiter rateLimiter;
  RequestRouter requestRouter;
  ConsentManager consent;
  ExternalIntegrations externalIntegrations;
  JsValue featureFlags;
  JsValue toolbar;
  JsValue surveys;
  JsValue conversations;
  JsValue logs;
  JsValue metrics;
  JsValue experiments;
  JsValue exceptions;
  JsValue people;
  JsValue _originalUserConfig;
  JsValue _triggered_notifs;
  JsValue compression;
  PostHogPersistence? persistence;
  PostHogPersistence? sessionPersistence;
  RequestQueue? _requestQueue;
  RetryQueue? _retryQueue;
  SessionIdManager? sessionManager;
  SessionPropsManager? sessionPropsManager;
  RemoteConfigLoader? _remoteConfigLoader;
  JsValue _pendingRemoteConfig;
  JsValue _lastRemoteConfig;
  JsValue siteApps;
  JsValue autocapture;
  JsValue heatmaps;
  JsValue tracingHeaders;
  JsValue webVitalsAutocapture;
  JsValue exceptionObserver;
  JsValue deadClicksAutocapture;
  JsValue historyAutocapture;
  JsValue productTours;
  JsValue sessionRecording;
  BrowserClientAdapter? _browserClientAdapter;
  JsValue _featureFlagsReloadingUnsubscribe;

  init() {
    JsValue client = this;
    this.webPerformance = new DeprecatedWebPerformanceObserver();
    this._personProcessingSetOncePropertiesSent = false;
    this.version = Config.libVersion;
    this._sessionRegisteredPropKeys = [];
    this._sessionRegisteredPropertiesStorageKey = "";
    this._internalEventEmitter = new EventEmitter();
    this._extensions = [];
    this._extensionEventPropertyProducers = [];
    this._calculate_event_properties = JS.invoke(client["calculateEventProperties"], "bind", client);
    this.config = defaultConfig(JS.undefined());
    this.SentryIntegration = SentryIntegrationClass;
    this.sentryIntegration = (JsValue options) => sentryIntegration(client, options);
    this.__request_queue = JS.array();
    this.__loaded = false;
    this.analyticsDefaultEndpoint = "/e/";
    this._initialPageviewCaptured = false;
    this._visibilityStateListener = null;
    this._initialPersonProfilesConfig = null;
    this._cachedPersonProperties = null;
    this.persistence = JS.assume(JS.undefined());
    this.sessionPersistence = JS.assume(JS.undefined());
    this._requestQueue = JS.assume(JS.undefined());
    this._retryQueue = JS.assume(JS.undefined());
    this.sessionManager = JS.assume(JS.undefined());
    this.sessionPropsManager = JS.assume(JS.undefined());
    this._remoteConfigLoader = JS.assume(JS.undefined());
    this._browserClientAdapter = JS.assume(JS.undefined());
    this._featureFlagsReloadingUnsubscribe = JS.undefined();
    this.scrollManager = new ScrollManager(this);
    this.pageViewManager = new PageViewManager(this);
    this.rateLimiter = new RateLimiter(this);
    this.requestRouter = new RequestRouter(this);
    this.consent = new ConsentManager(this);
    this.externalIntegrations = new ExternalIntegrations(this);
    // Default extension classes are constructed eagerly; the slim bundle has none.
    JsValue defaults = JS.get(PostHog, "__defaultExtensionClasses");
    JsValue ext = if (JS.isNullish(defaults)) { JS.object() } else { defaults };
    this.featureFlags = ext["featureFlags"];
    if (ext["featureFlags"].truthy()) {
      this.featureFlags = JS.construct(ext["featureFlags"], client);
    }
    this.toolbar = ext["toolbar"];
    if (ext["toolbar"].truthy()) {
      this.toolbar = JS.construct(ext["toolbar"], client);
    }
    this.surveys = ext["surveys"];
    if (ext["surveys"].truthy()) {
      this.surveys = JS.construct(ext["surveys"], client);
    }
    this.conversations = ext["conversations"];
    if (ext["conversations"].truthy()) {
      this.conversations = JS.construct(ext["conversations"], client);
    }
    this.logs = ext["logs"];
    if (ext["logs"].truthy()) {
      this.logs = JS.construct(ext["logs"], client);
    }
    this.metrics = ext["metrics"];
    if (ext["metrics"].truthy()) {
      this.metrics = JS.construct(ext["metrics"], client);
    }
    this.experiments = ext["experiments"];
    if (ext["experiments"].truthy()) {
      this.experiments = JS.construct(ext["experiments"], client);
    }
    this.exceptions = ext["exceptions"];
    if (ext["exceptions"].truthy()) {
      this.exceptions = JS.construct(ext["exceptions"], client);
    }
    // Deprecated: `posthog.people.set(...)` is `setPersonProperties`.
    this.people = JS.object(
      "set", (JsValue prop, JsValue to, JsValue callback) => {
        JsValue setProps = prop;
        if (isString(prop)) {
          setProps = JS.object();
          setProps[JS.string(prop)] = to;
        }
        JS.invoke(client, "setPersonProperties", setProps);
        if (!JS.isNullish(callback)) {
          JS.call(callback, JS.undefined(), JS.object());
        }
      },
      "set_once", (JsValue prop, JsValue to, JsValue callback) => {
        JsValue setProps = prop;
        if (isString(prop)) {
          setProps = JS.object();
          setProps[JS.string(prop)] = to;
        }
        JS.invoke(client, "setPersonProperties", JS.undefined(), setProps);
        if (!JS.isNullish(callback)) {
          JS.call(callback, JS.undefined(), JS.object());
        }
      }
    );
    JS.invoke(client, "on", "eventCaptured", (JsValue data) => {
      logger.info(JS.array(JS.add(JS.add("send \"", getProp(data, "event")), "\""), data));
    });
  }

  JsValue init(JsValue token, JsValue config = JS.undefined(), JsValue name = JS.undefined()) {
    JsValue client = this;
    if (!name.truthy() || JS.strictEqual(name, PRIMARY_INSTANCE_NAME)) {
      return JS.invoke(client, "_init", token, config, name);
    }
    JsValue existing = instances[JS.string(name)];
    JsValue named = if (JS.isNullish(existing)) { new PostHog() } else { existing };
    JS.invoke(named, "_init", token, config, name);
    instances[JS.string(name)] = named;
    instances[PRIMARY_INSTANCE_NAME][JS.string(name)] = named;
    return named;
  }

  JsValue _init(JsValue token, JsValue userConfigArg = JS.undefined(), JsValue name = JS.undefined()) {
    JsValue client = this;
    JsValue config = if (JS.isUndefined(userConfigArg)) { JS.object() } else { userConfigArg };
    string normalizedToken = if (isString(token)) { JS.string(JS.invoke(token, "trim")) } else { "" };
    if (normalizedToken == "") {
      logger.critical(JS.array("PostHog was initialized without a token. This likely indicates a misconfiguration. Please check the first argument passed to posthog.init()"));
      return client;
    }
    if (this.__loaded) {
      if (JS.strictNotEqual(normalizedToken, getProp(this.config, "token"))) {
