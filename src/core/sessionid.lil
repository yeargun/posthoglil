// browser/src/sessionid.ts: the session and window ids, rotated after 30 idle minutes
// (configurable) or 24 hours, persisted as `$sesid` = [activity, session id, start].
// `_sessionActivityTimestamp`, `_sessionStartTimestamp` and `_sessionTimeoutMs` keep
// upstream's names and raw values: upstream reserves them from mangling.

import { PostHogPersistence } from "./persistence.lil";
import { persistenceOf, PostHog } from "./posthog-core.lil";
import { sessionStore } from "./storage.lil";
import { EventEmitter } from "./event-emitter.lil";
import { createLogger, Logger } from "./logger.lil";
import { uuidv7, uuid7ToTimestampMs } from "./uuidv7.lil";
import { win } from "./globals.lil";
import { addEventListener, asString, clampToRange, defineGetter, isPositiveNumber } from "./utils.lil";

extern JsValue Date;
extern JsValue Math;
extern JsValue Error;
extern JsValue Object;
extern JsValue setTimeout;
extern JsValue clearTimeout;

Logger sessionLogger = createLogger("[SessionId]");

number SESSION_LENGTH_LIMIT_MILLISECONDS = 86400000.0;
number BOOTSTRAP_SESSION_CLOCK_SKEW_TOLERANCE_MILLISECONDS = 60000.0;
number ACTIVITY_TIMESTAMP_PERSIST_GRANULARITY_MS = 5000.0;
number SESSION_COOKIE_SYNC_INTERVAL_MS = 1000.0;

number now() {
  return JS.number(JS.invoke(JS.construct(Date), "getTime"));
}

// The start time a bootstrapped UUIDv7 session id encodes, or -1 when unusable.
number parseBootstrapSessionId(JsValue sessionID) {
  number timestamp = now();
  try {
    number sessionStartTimestamp = uuid7ToTimestampMs(JS.assume(sessionID));
    if (sessionStartTimestamp > timestamp + BOOTSTRAP_SESSION_CLOCK_SKEW_TOLERANCE_MILLISECONDS) {
      sessionLogger.error(JS.array("Bootstrap sessionID cannot be in the future"));
      return -1.0;
    }
    return sessionStartTimestamp;
  } catch (JsValue e) {
    sessionLogger.error(JS.array("Invalid sessionID in bootstrap", e));
    return -1.0;
  }
}

class PendingBootstrapSession {
  JsValue sessionId;
  number sessionStartTimestamp;

  init(JsValue sessionId, number sessionStartTimestamp) {
    this.sessionId = sessionId;
    this.sessionStartTimestamp = sessionStartTimestamp;
  }
}

export class SessionIdManager {
  JsValue _config;
  PostHogPersistence _persistence;
  JsValue _windowId;
  JsValue _sessionId;
  string _window_id_storage_key;
  string _primary_window_exists_storage_key;
  JsValue _sessionStartTimestamp;
  PendingBootstrapSession? _pendingBootstrapSession;
  JsValue _sessionActivityTimestamp;
  JsValue _lastPersistedActivityTimestamp;
  number? _lastCookieSyncTimestamp;
  JsValue[] _sessionIdChangedHandlers;
  number _sessionTimeoutMs;
  JsValue _enforceIdleTimeout;
  JsValue _beforeUnloadListener;
  bool _destroyed;
  EventEmitter _eventEmitter;

  init(PostHog instance) {
    PostHogPersistence? instancePersistence = persistenceOf(instance);
    if (instancePersistence == null) {
      throw JS.construct(Error, "SessionIdManager requires a PostHogPersistence instance");
    }
    JsValue config = instance.config;
    if (JS.strictEqual(config["cookieless_mode"], "always")) {
      throw JS.construct(Error, "SessionIdManager cannot be used with cookieless_mode=\"always\"");
    }
    PostHogPersistence persistence = instancePersistence;
    this._lastPersistedActivityTimestamp = null;
    this._lastCookieSyncTimestamp = null;
    this._sessionIdChangedHandlers = [];
    this._beforeUnloadListener = JS.undefined();
    this._destroyed = false;
    this._eventEmitter = new EventEmitter();
    this._enforceIdleTimeout = JS.undefined();
    this._config = config;
    this._persistence = persistence;
    this._windowId = JS.undefined();
    this._sessionId = JS.undefined();
    this._sessionStartTimestamp = null;
    this._pendingBootstrapSession = null;
    this._sessionActivityTimestamp = null;
    JsValue persistenceName = JS.or(config["persistence_name"], config["token"]);
    JsValue desiredTimeout = JS.or(config["session_idle_timeout_seconds"], 1800);
    this._sessionTimeoutMs = clampToRange(desiredTimeout, 60.0, 36000.0, sessionLogger.child("session_idle_timeout_seconds"), 1800) * 1000.0;
    JsValue client = instance;
    JS.invoke(client, "register", JS.object("$configured_session_timeout_ms", this._sessionTimeoutMs));
    resetIdleTimer(this);
    this._window_id_storage_key = asString(JS.add(JS.add("ph_", persistenceName), "_window_id"));
    this._primary_window_exists_storage_key = asString(JS.add(JS.add("ph_", persistenceName), "_primary_window_exists"));
    // A window id survives a reload of the same tab, but not a duplicated tab: the
    // primary-window flag in sessionStorage tells the two apart.
    if (canUseSessionStorage(this)) {
      JsValue lastWindowId = sessionStore.parse(this._window_id_storage_key);
      JsValue primaryWindowExists = sessionStore.parse(this._primary_window_exists_storage_key);
      if (lastWindowId.truthy() && !primaryWindowExists.truthy()) {
        this._windowId = lastWindowId;
      } else {
        sessionStore.remove(this._window_id_storage_key, JS.undefined());
      }
      sessionStore.set(this._primary_window_exists_storage_key, true, JS.undefined(), JS.undefined(), JS.undefined());
    }
    JsValue bootstrap = config["bootstrap"];
    if (!JS.isNullish(bootstrap) && bootstrap["sessionID"].truthy()) {
      this.setBootstrapSessionId(bootstrap["sessionID"], false);
    }
    listenToReloadWindow(this);
  }

  JsValue on(string event, JsValue handler) {
    return this._eventEmitter.on(event, handler);
  }

  JsValue onSessionId(JsValue callback) {
    this._sessionIdChangedHandlers.push(callback);
    if (this._sessionId.truthy()) {
      JS.call(callback, JS.undefined(), this._sessionId, this._windowId);
    }
    return () => {
      this._sessionIdChangedHandlers = this._sessionIdChangedHandlers.filter((JsValue h) => !JS.strictEqual(h, callback));
    };
  }

  void resetSessionId() {
    this._lastPersistedActivityTimestamp = null;
    this._pendingBootstrapSession = null;
    JS.call(clearTimeout, JS.undefined(), this._enforceIdleTimeout);
    this._enforceIdleTimeout = JS.undefined();
    setSessionId(this, null, null, null);
  }

  bool setBootstrapSessionId(JsValue sessionID, JsValue deferUntilNextSessionArg) {
    bool deferUntilNextSession = deferUntilNextSessionArg.truthy();
    number sessionStartTimestamp = parseBootstrapSessionId(sessionID);
    if (sessionStartTimestamp == -1.0) {
      return false;
    }
    if (deferUntilNextSession) {
      this._pendingBootstrapSession = new PendingBootstrapSession(sessionID, sessionStartTimestamp);
    } else {
      setSessionId(this, sessionID, now(), sessionStartTimestamp);
    }
    return true;
  }

  void destroy() {
    this._destroyed = true;
    flushPendingActivityTimestamp(this);
    JS.call(clearTimeout, JS.undefined(), this._enforceIdleTimeout);
    this._enforceIdleTimeout = JS.undefined();
    if (this._beforeUnloadListener.truthy() && win.truthy()) {
      JS.invoke(win, "removeEventListener", "beforeunload", this._beforeUnloadListener, JS.object("capture", false));
      this._beforeUnloadListener = JS.undefined();
    }
    this._sessionIdChangedHandlers = [];
  }

  JsValue checkAndGetSessionAndWindowId(JsValue readOnlyArg, JsValue timestampArg, JsValue persistenceAlreadySyncedArg) {
    bool readOnly = readOnlyArg.truthy();
    bool persistenceAlreadySynced = persistenceAlreadySyncedArg.truthy();
    if (JS.strictEqual(this._config["cookieless_mode"], "always")) {
      throw JS.construct(Error, "checkAndGetSessionAndWindowId should not be called with cookieless_mode=\"always\"");
    }
    number timestamp = if (timestampArg.truthy()) { JS.number(timestampArg) } else { now() };
    JsValue managedSessionIdBeforeCookieSync = this._sessionId;
    number? lastSync = this._lastCookieSyncTimestamp;
    if (persistenceAlreadySynced) {
      this._lastCookieSyncTimestamp = timestamp;
    } else if (lastSync == null || timestamp < lastSync || timestamp - lastSync >= SESSION_COOKIE_SYNC_INTERVAL_MS) {
      this._persistence.syncCookieProperties();
      this._lastCookieSyncTimestamp = timestamp;
    }
    JsValue info = getSessionId(this);
    JsValue sessionId = info[1];
    JsValue startTimestamp = info[2];
    bool cookieSessionAdoption = !JS.isUndefined(managedSessionIdBeforeCookieSync) && JS.strictNotEqual(sessionId, managedSessionIdBeforeCookieSync);
    number lastActivityTimestamp = freshestActivityTimestamp(this);
    JsValue windowId = getWindowId(this);
    PendingBootstrapSession? pending = this._pendingBootstrapSession;
    bool pendingPastMaximumLength = false;
    bool sessionPastMaximumLength = false;
    if (pending != null) {
      pendingPastMaximumLength = pending.sessionStartTimestamp > timestamp + BOOTSTRAP_SESSION_CLOCK_SKEW_TOLERANCE_MILLISECONDS || timestamp - pending.sessionStartTimestamp > SESSION_LENGTH_LIMIT_MILLISECONDS;
      sessionPastMaximumLength = pendingPastMaximumLength;
    } else {
      sessionPastMaximumLength = isPositiveNumber(startTimestamp) && JS.number(JS.invoke(Math, "abs", timestamp - JS.number(startTimestamp))) > SESSION_LENGTH_LIMIT_MILLISECONDS;
    }
    bool valuesChanged = false;
    bool crossTabAdoption = cookieSessionAdoption;
    bool noSessionId = !sessionId.truthy() || pending != null;
    JsValue preRefreshSessionId = sessionId;
    bool activityTimeout = !noSessionId && !readOnly && sessionHasBeenIdleTooLong(this, timestamp, lastActivityTimestamp);
    if (activityTimeout) {
      // Another tab may have kept the session alive: re-read before rotating.
      activityTimeout = isSessionIdleAfterCrossTabRefresh(this, timestamp);
      if (!activityTimeout) {
        sessionLogger.info(JS.array("cross-tab refresh kept the session alive", JS.object("sessionId", sessionId)));
      }
      info = getSessionId(this);
      sessionId = info[1];
      startTimestamp = info[2];
    }
    if (noSessionId || activityTimeout || sessionPastMaximumLength) {
      crossTabAdoption = false;
      bool usePending = pending != null && !pendingPastMaximumLength;
      sessionId = if (usePending && pending != null) { pending.sessionId } else { uuidv7() };
      windowId = uuidv7();
      sessionLogger.info(JS.array("new session ID assigned", JS.object(
        "sessionId", sessionId,
        "windowId", windowId,
        "bootstrapped", usePending,
        "changeReason", JS.object("noSessionId", noSessionId, "activityTimeout", activityTimeout, "sessionPastMaximumLength", sessionPastMaximumLength)
      )));
      startTimestamp = if (usePending && pending != null) { pending.sessionStartTimestamp } else { timestamp };
      this._pendingBootstrapSession = null;
      valuesChanged = true;
    } else {
      if (!windowId.truthy()) {
        windowId = uuidv7();
        valuesChanged = true;
      }
      crossTabAdoption = crossTabAdoption || JS.strictNotEqual(sessionId, preRefreshSessionId);
      if (crossTabAdoption) {
        sessionLogger.info(JS.array("adopted cross-tab session id", JS.object("sessionId", sessionId, "windowId", windowId)));
        valuesChanged = true;
      }
    }
    bool noActivityTimestamp = !isPositiveNumber(lastActivityTimestamp);
    bool shouldPreserveActivityTimestamp = !noActivityTimestamp && readOnly && !sessionPastMaximumLength;
    number newActivityTimestamp = if (shouldPreserveActivityTimestamp) { lastActivityTimestamp } else { timestamp };
    JsValue sessionStartTimestamp = if (isPositiveNumber(startTimestamp)) { startTimestamp } else { now() };
    setWindowId(this, windowId);
    setSessionId(this, sessionId, newActivityTimestamp, sessionStartTimestamp);
    if (!readOnly) {
      resetIdleTimer(this);
    }
    JsValue changeReason = JS.object("noSessionId", noSessionId, "activityTimeout", activityTimeout, "sessionPastMaximumLength", sessionPastMaximumLength, "crossTabAdoption", crossTabAdoption);
    if (valuesChanged) {
      JsValue finalSessionId = sessionId;
      JsValue finalWindowId = windowId;
      this._sessionIdChangedHandlers.forEach((JsValue handler) => {
        JS.call(handler, JS.undefined(), finalSessionId, finalWindowId, changeReason);
      });
    }
    return JS.object(
      "sessionId", sessionId,
      "windowId", windowId,
      "sessionStartTimestamp", sessionStartTimestamp,
      "changeReason", if (valuesChanged) { changeReason } else { JS.undefined() },
      "lastActivityTimestamp", lastActivityTimestamp
    );
  }
}

bool canUseSessionStorage(SessionIdManager self) {
  return JS.strictNotEqual(self._config["persistence"], "memory") && !self._persistence._disabled && sessionStore.isSupported();
}

void setWindowId(SessionIdManager self, JsValue windowId) {
  if (JS.strictNotEqual(windowId, self._windowId)) {
    self._windowId = windowId;
    if (canUseSessionStorage(self)) {
      sessionStore.set(self._window_id_storage_key, windowId, JS.undefined(), JS.undefined(), JS.undefined());
    }
  }
}

JsValue getWindowId(SessionIdManager self) {
  if (self._windowId.truthy()) {
    return self._windowId;
  }
  if (canUseSessionStorage(self)) {
    return sessionStore.parse(self._window_id_storage_key);
  }
  return null;
}

bool isActivityChangeBelowGranularity(SessionIdManager self, JsValue newActivityTimestamp) {
  JsValue lastPersisted = self._lastPersistedActivityTimestamp;
  if (JS.strictEqual(lastPersisted, null) || JS.strictEqual(newActivityTimestamp, null)) {
    return false;
  }
  return JS.number(JS.invoke(Math, "abs", JS.number(newActivityTimestamp) - JS.number(lastPersisted))) < ACTIVITY_TIMESTAMP_PERSIST_GRANULARITY_MS;
}

// Activity-only moves persist at most every five seconds, so an active tab does not
// rewrite storage (and its cookie) on every event.
void setSessionId(SessionIdManager self, JsValue sessionId, JsValue sessionActivityTimestamp, JsValue sessionStartTimestamp) {
  bool idChanged = JS.strictNotEqual(sessionId, self._sessionId);
  bool startChanged = JS.strictNotEqual(sessionStartTimestamp, self._sessionStartTimestamp);
  bool activityChanged = JS.strictNotEqual(sessionActivityTimestamp, self._sessionActivityTimestamp);
  bool isActivityOnlyChange = !idChanged && !startChanged;
  self._sessionStartTimestamp = sessionStartTimestamp;
  self._sessionActivityTimestamp = sessionActivityTimestamp;
  self._sessionId = sessionId;
  if (isActivityOnlyChange && !activityChanged) {
    return;
  }
  if (isActivityOnlyChange && isActivityChangeBelowGranularity(self, sessionActivityTimestamp)) {
    return;
  }
  self._lastPersistedActivityTimestamp = sessionActivityTimestamp;
  self._persistence.register(JS.object("$sesid", JS.array(sessionActivityTimestamp, sessionId, sessionStartTimestamp)), JS.undefined());
}

bool useCrossTabRefreshHardening(SessionIdManager self) {
  JsValue debounce = if (JS.isNullish(self._config)) { JS.undefined() } else { self._config["persistence_save_debounce_ms"] };
  return isPositiveNumber(debounce) && JS.number(debounce) > 0.0;
}

void refreshSessionIdFromStorage(SessionIdManager self) {
  if (useCrossTabRefreshHardening(self)) {
    self._persistence.refreshKey("$sesid");
  } else {
    self._persistence.flush();
    self._persistence.load(false);
  }
}

void flushPendingActivityTimestamp(SessionIdManager self) {
  if (JS.strictEqual(self._sessionActivityTimestamp, null) || JS.strictEqual(self._sessionActivityTimestamp, self._lastPersistedActivityTimestamp)) {
    return;
  }
  refreshSessionIdFromStorage(self);
  JsValue persisted = getSessionId(self);
  if (JS.strictNotEqual(persisted[1], self._sessionId) || JS.strictNotEqual(persisted[2], self._sessionStartTimestamp)) {
    return;
  }
  self._lastPersistedActivityTimestamp = self._sessionActivityTimestamp;
  JsValue sessionId = if (JS.isNullish(self._sessionId)) { null } else { self._sessionId };
  self._persistence.register(JS.object("$sesid", JS.array(self._sessionActivityTimestamp, sessionId, self._sessionStartTimestamp)), JS.undefined());
  self._persistence.flush();
}

number freshestActivityTimestamp(SessionIdManager self) {
  JsValue persistedActivity = getSessionId(self)[0];
  number persisted = if (isPositiveNumber(persistedActivity)) { JS.number(persistedActivity) } else { 0.0 };
  number inMemory = if (isPositiveNumber(self._sessionActivityTimestamp)) { JS.number(self._sessionActivityTimestamp) } else { 0.0 };
  return JS.number(JS.invoke(Math, "max", persisted, inMemory));
}

bool isSessionIdleAfterCrossTabRefresh(SessionIdManager self, number timestamp) {
  refreshSessionIdFromStorage(self);
  return sessionHasBeenIdleTooLong(self, timestamp, freshestActivityTimestamp(self));
}

// `[activity, id, start]`; a legacy two-item entry gains its start from its activity.
JsValue getSessionId(SessionIdManager self) {
  JsValue sessionIdInfo = self._persistence.props["$sesid"];
  if (sessionIdInfo.isArray() && JS.number(sessionIdInfo["length"]) == 2.0) {
    JS.invoke(sessionIdInfo, "push", sessionIdInfo[0]);
  }
  return JS.or(sessionIdInfo, JS.array(0, null, 0));
}

void listenToReloadWindow(SessionIdManager self) {
  self._beforeUnloadListener = () => {
    flushPendingActivityTimestamp(self);
    if (canUseSessionStorage(self)) {
      sessionStore.remove(self._primary_window_exists_storage_key, JS.undefined());
    }
  };
  addEventListener(win, "beforeunload", self._beforeUnloadListener, false, true);
}

bool sessionHasBeenIdleTooLong(SessionIdManager self, JsValue timestamp, JsValue lastActivityTimestamp) {
  if (!isPositiveNumber(timestamp) || !isPositiveNumber(lastActivityTimestamp)) {
    return false;
  }
  return JS.number(JS.invoke(Math, "abs", JS.number(timestamp) - JS.number(lastActivityTimestamp))) > self._sessionTimeoutMs;
}

void resetIdleTimer(SessionIdManager self) {
  if (self._destroyed) {
    return;
  }
  JS.call(clearTimeout, JS.undefined(), self._enforceIdleTimeout);
  self._enforceIdleTimeout = JS.call(setTimeout, JS.undefined(), () => {
    if (self._destroyed) {
      return;
    }
    if (isSessionIdleAfterCrossTabRefresh(self, now())) {
      JsValue idleSessionId = self._sessionId;
      self.resetSessionId();
      self._eventEmitter.emit("forcedIdleReset", JS.object("idleSessionId", idleSessionId));
    } else {
      resetIdleTimer(self);
    }
  }, self._sessionTimeoutMs * 1.1);
}

// Upstream exposes the timeout through a getter on the prototype.
JsValue sessionTimeoutGetter = defineGetter(SessionIdManager, "sessionTimeoutMs", JS.method0((JsValue self) => self["_sessionTimeoutMs"]));

export constructor SessionIdManager;
