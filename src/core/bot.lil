bool isBlockedUA(JsValue ua, JsValue customBlockedUserAgents) {
  if (!ua.truthy()) {
    return false;
  }
  JsValue uaLower = JS.invoke(ua, "toLowerCase");
  JsValue candidates = JS.invoke(DEFAULT_BLOCKED_UA_STRS, "concat", if (JS.isUndefined(customBlockedUserAgents)) { JS.array() } else { customBlockedUserAgents });
  return JS.invoke(candidates, "some", (JsValue blocked) => JS.number(JS.invoke(uaLower, "indexOf", JS.invoke(blocked, "toLowerCase"))) != -1.0).truthy();
}

export bool isLikelyBot(JsValue nav, JsValue customBlockedUserAgents) {
  if (!nav.truthy()) {
    return false;
  }
  JsValue ua = nav["userAgent"];
  if (ua.truthy() && isBlockedUA(ua, customBlockedUserAgents)) {
    return true;
  }
  try {
    JsValue uaData = nav["userAgentData"];
    JsValue brands = if (JS.isNullish(uaData)) { JS.undefined() } else { uaData["brands"] };
    if (brands.truthy() && JS.invoke(uaData["brands"], "some", (JsValue brandObj) => isBlockedUA(if (JS.isNullish(brandObj)) { JS.undefined() } else { brandObj["brand"] }, customBlockedUserAgents)).truthy()) {
      return true;
    }
  } catch {
  }
  return nav["webdriver"].truthy();
}

export async JsValue getDeviceModel() {
  JsValue uaData = if (JS.isNullish(navigator)) { JS.undefined() } else { navigator["userAgentData"] };
  if (JS.isNullish(uaData) || !uaData["getHighEntropyValues"].truthy()) {
    return JS.undefined();
  }
  try {
    Task<JsValue> request = JS.assume(JS.invoke(uaData, "getHighEntropyValues", JS.array("model")));
    JsValue hints = await request;
    JsValue model = if (JS.isNullish(hints)) { JS.undefined() } else { hints["model"] };
    return if (isString(model) && JS.number(model["length"]) > 0.0) { model } else { JS.undefined() };
  } catch (JsValue e) {
    logger.info(JS.array("Unable to resolve $device_model from userAgentData.getHighEntropyValues", e));
    return JS.undefined();
  }
}
